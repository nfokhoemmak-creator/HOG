<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    {% render 'meta-tags' %}
    {{ content_for_header }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
      :root {
        --font-heading: 'Fredoka', 'Nunito', system-ui, sans-serif;
        --font-body: 'Nunito', system-ui, sans-serif;
        --heading-scale: 1;
        --body-scale: 1;
        --color-bg: {{ settings.color_background }};
        --color-bg-alt: {{ settings.color_background_alt }};
        --color-border: {{ settings.color_border }};
        --color-fg: {{ settings.color_text }};
        --color-muted: {{ settings.color_text_muted }};
        --color-green: {{ settings.color_primary }};
        --color-green-dark: {{ settings.color_primary_dark }};
        --color-orange: {{ settings.color_accent }};
        --color-orange-dark: {{ settings.color_accent_dark }};
        --color-star: {{ settings.color_star }};
        --color-sale: {{ settings.color_sale }};
        --color-green-rgb: {{ settings.color_primary | color_extract: 'red' }}, {{ settings.color_primary | color_extract: 'green' }}, {{ settings.color_primary | color_extract: 'blue' }};
        --color-orange-rgb: {{ settings.color_accent | color_extract: 'red' }}, {{ settings.color_accent | color_extract: 'green' }}, {{ settings.color_accent | color_extract: 'blue' }};
        --color-green-soft: {{ settings.color_primary | color_mix: settings.color_background, 12 }};
        --color-orange-soft: {{ settings.color_accent | color_mix: settings.color_background, 16 }};
        --container: {{ settings.layout_max_width }}px;
        --gutter: {{ settings.layout_gutter }}px;
        --radius: {{ settings.layout_corner_radius }}px;
        --radius-sm: 10px;
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
