{%- liquid
  assign menu = linklists[section.settings.menu]
  assign blackjack_url = routes.root_url | append: 'pages/blackjack'
-%}

<header class="header{% if section.settings.sticky %} header--sticky{% endif %}">
  <div class="container header__inner">
    <menu-drawer class="menu-toggle">
      <button
        type="button"
        class="header__icon"
        data-menu-open
        aria-expanded="false"
        aria-controls="MenuDrawer"
        aria-label="{{ 'general.menu' | t }}"
      >
        {% render 'icon', name: 'menu' %}
      </button>

      <div class="menu-drawer" id="MenuDrawer" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}">
        <div class="menu-drawer__head">
          <span class="eyebrow">{{ 'general.menu' | t }}</span>
          <button type="button" class="header__icon" data-menu-close aria-label="{{ 'general.close' | t }}">
            {% render 'icon', name: 'close' %}
          </button>
        </div>

        <nav class="menu-drawer__list" aria-label="{{ 'general.menu' | t }}">
          {%- for link in menu.links -%}
            <div>
              <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
              {%- if link.links.size > 0 -%}
                <div class="menu-drawer__sublist">
                  {%- for child in link.links -%}
                    <a href="{{ child.url }}">{{ child.title }}</a>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </nav>

        {%- comment -%}
          The drawer covers the floating play button, so the game gets its
          own row here: the same link as the header pill, upgraded to the
          popup by theme.js. Search and account follow as quiet text links.
        {%- endcomment -%}
        <div class="menu-drawer__foot">
          {%- if section.settings.show_blackjack -%}
            <a
              class="btn btn--outline btn--full"
              href="{{ blackjack_url }}"
              data-blackjack-open
              aria-controls="BlackjackModal"
            >
              <span aria-hidden="true">&#9824;</span>
              {{ section.settings.blackjack_drawer_label | default: 'Play blackjack' }}
            </a>
          {%- endif -%}

          <div class="menu-drawer__links">
            {%- if section.settings.show_search -%}
              <a href="{{ routes.search_url }}">{{ 'general.search.search' | t }}</a>
            {%- endif -%}
            {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
              <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
                {{ 'general.account' | t }}
              </a>
            {%- endif -%}
          </div>

          {%- if settings.brand_tagline != blank -%}
            <p class="menu-drawer__tagline">{{ settings.brand_tagline }}</p>
          {%- endif -%}
        </div>
      </div>
    </menu-drawer>

    {%- if request.page_type == 'index' -%}
      <h1 class="header__logo">
    {%- else -%}
      <div class="header__logo">
    {%- endif -%}
      <a href="{{ routes.root_url }}">
        {%- if settings.logo != blank -%}
          {%- comment -%}
            The width setting is a cap, not a size: the mark is height-bound
            to the bar in CSS so a tall logo can never grow the header.
          {%- endcomment -%}
          <img
            src="{{ settings.logo | image_url: width: 600 }}"
            alt="{{ shop.name | escape }}"
            width="{{ settings.logo.width }}"
            height="{{ settings.logo.height }}"
            style="--logo-width: {{ settings.logo_width }}px;"
          >
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </a>
    {%- if request.page_type == 'index' -%}
      </h1>
    {%- else -%}
      </div>
    {%- endif -%}

    <nav class="header__nav" aria-label="{{ 'general.menu' | t }}">
      {%- for link in menu.links -%}
        <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <div class="header__actions">
      {%- comment -%}
        A real link to the game page: theme.js upgrades it into the popup
        trigger, so it works either way. Outlined, never filled — the black
        fill belongs to the primary button alone.
      {%- endcomment -%}
      {%- if section.settings.show_blackjack -%}
        <a
          class="header__blackjack"
          href="{{ blackjack_url }}"
          data-blackjack-open
          aria-controls="BlackjackModal"
        >
          <span aria-hidden="true">&#9824;</span>
          <span class="header__blackjack-label">{{ section.settings.blackjack_label | default: 'Play' }}</span>
        </a>
      {%- endif -%}

      {%- if section.settings.show_search -%}
        <a class="header__icon" href="{{ routes.search_url }}" aria-label="{{ 'general.search.search' | t }}">
          {% render 'icon', name: 'search' %}
        </a>
      {%- endif -%}

      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a
          class="header__icon"
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          aria-label="{{ 'general.account' | t }}"
        >
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}

      <a
        class="header__icon"
        href="{{ routes.cart_url }}"
        aria-label="{{ 'general.cart' | t }}"
        {% if settings.cart_type == 'drawer' %}data-cart-trigger{% endif %}
      >
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>
          {{- cart.item_count -}}
        </span>
      </a>
    </div>
  </div>
</header>

{%- comment -%} Structured data so search results carry the brand correctly. {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | append: routes.root_url | json }},
    {%- if settings.logo -%}
      "logo": {{ settings.logo | image_url: width: 600 | prepend: "https:" | json }},
    {%- endif -%}
    {%- if settings.social_instagram_link != blank -%}
      "sameAs": [{{ settings.social_instagram_link | json }}],
    {%- endif -%}
    "description": {{ shop.description | default: settings.brand_tagline | json }}
  }
</script>

{% schema %}
{
  "name": "t:sections.header.name",
  "tag": "div",
  "class": "header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu.label",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "t:sections.header.settings.sticky.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_blackjack",
      "label": "Show the blackjack button",
      "default": true,
      "info": "Opens the blackjack popup from the header on every page."
    },
    {
      "type": "text",
      "id": "blackjack_label",
      "label": "Blackjack button label",
      "default": "PLAY"
    },
    {
      "type": "text",
      "id": "blackjack_drawer_label",
      "label": "Blackjack link label in the mobile menu",
      "default": "Play blackjack"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:sections.header.settings.show_search.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:sections.header.settings.show_account.label",
      "default": true
    }
  ]
}
{% endschema %}
