<div class="password-page">
  <div class="password-page__inner">
    {% render 'logo', size: 40 %}
    <h1>{{ section.settings.heading | escape }}</h1>
    <p class="lead muted">{{ section.settings.text | escape }}</p>

    {%- form 'storefront_password' -%}
      <label class="visually-hidden" for="Password">{{ 'sections.password.login_form_password_label' | t }}</label>
      <input class="field__input" id="Password" type="password" name="password" placeholder="{{ 'sections.password.login_form_password_placeholder' | t }}" required>
      <button type="submit" class="btn">{{ 'sections.password.login_form_submit' | t }}</button>
      {%- if form.errors -%}<p class="form__error" style="width:100%">{{ 'sections.password.login_form_error' | t }}</p>{%- endif -%}
    {%- endform -%}

    <p class="small muted">{{ 'sections.password.admin_link_html' | t }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something goodest is coming" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "8 health benefits in one chew your dog will beg for. We're opening the doors very soon." }
  ]
}
{% endschema %}
