{%- comment -%}
  Standalone video section. Media priority: an uploaded video wins, then an
  external YouTube/Vimeo embed (privacy-friendly hosts), then the cover image
  with a play hint, then a placeholder so the editor preview never breaks.
{%- endcomment -%}

{% style %}
  .video-section__head {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-2);
  }

  .video-section__subheading {
    max-width: 52ch;
    margin: 0;
  }

  .video-section__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--video-aspect, 16 / 9);
    border-radius: var(--radius);
    background: var(--color-bg-alt);
  }

  .video-section--full .video-section__media {
    border-radius: 0;
  }

  .video-section__media video,
  .video-section__media iframe,
  .video-section__media img,
  .video-section__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  .video-section__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 6.4rem;
    height: 6.4rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.5);
    color: #fff;
    transform: translate(-50%, -50%);
    transition: background var(--duration) var(--ease), transform var(--duration) var(--ease);
  }

  a.video-section__play:hover {
    background: rgb(0 0 0 / 0.7);
    transform: translate(-50%, -50%) scale(1.05);
  }

  .video-section__play svg {
    position: static;
    width: 2rem;
    height: 2rem;
    margin-left: 0.3rem;
    fill: currentColor;
  }

  .video-section__cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-5);
  }
{% endstyle %}

{%- liquid
  assign external = section.settings.external_video_url
  assign video_title = section.settings.heading | default: 'Video' | escape
-%}

<div class="section video-section{% if section.settings.full_width %} video-section--full{% endif %}">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="container">
      <div class="section__head video-section__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="muted video-section__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="{% unless section.settings.full_width %}container{% endunless %}">
    <div class="video-section__media" style="--video-aspect: {{ section.settings.aspect }};">
      {%- if section.settings.video != blank -%}
        {%- if section.settings.autoplay -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1600x' }}
        {%- else -%}
          {{ section.settings.video | video_tag: controls: true, playsinline: true, image_size: '1600x' }}
        {%- endif -%}

      {%- elsif external != blank -%}
        {%- if external.type == 'youtube' -%}
          <iframe
            src="https://www.youtube-nocookie.com/embed/{{ external.id }}?rel=0{% if section.settings.autoplay %}&amp;autoplay=1&amp;mute=1&amp;loop=1&amp;playlist={{ external.id }}{% endif %}"
            title="{{ video_title }}"
            loading="lazy"
            allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
        {%- elsif external.type == 'vimeo' -%}
          <iframe
            src="https://player.vimeo.com/video/{{ external.id }}?dnt=1{% if section.settings.autoplay %}&amp;autoplay=1&amp;muted=1&amp;loop=1{% endif %}"
            title="{{ video_title }}"
            loading="lazy"
            allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
        {%- endif -%}

      {%- elsif section.settings.cover_image != blank -%}
        <img
          src="{{ section.settings.cover_image | image_url: width: 1600 }}"
          srcset="
            {{ section.settings.cover_image | image_url: width: 800 }} 800w,
            {{ section.settings.cover_image | image_url: width: 1200 }} 1200w,
            {{ section.settings.cover_image | image_url: width: 1600 }} 1600w,
            {{ section.settings.cover_image | image_url: width: 2000 }} 2000w
          "
          sizes="{% if section.settings.full_width %}100vw{% else %}(min-width: 990px) 1200px, 100vw{% endif %}"
          alt="{{ section.settings.cover_image.alt | default: section.settings.heading | default: 'Video' | escape }}"
          width="{{ section.settings.cover_image.width }}"
          height="{{ section.settings.cover_image.height }}"
          loading="lazy"
        >
        {%- if section.settings.button_link != blank -%}
          <a
            class="video-section__play"
            href="{{ section.settings.button_link }}"
            aria-label="{{ section.settings.button_label | default: 'Play video' | escape }}"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3.8 20.5 12 6 20.2z"/></svg>
          </a>
        {%- else -%}
          <span class="video-section__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3.8 20.5 12 6 20.2z"/></svg>
          </span>
        {%- endif -%}

      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'video-section__placeholder' }}
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.button_label != blank -%}
    <div class="container video-section__cta">
      <a class="btn btn--outline" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "class": "video-media-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted in motion"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": ""
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Takes priority over the external video URL."
    },
    {
      "type": "video_url",
      "id": "external_video_url",
      "label": "External video URL",
      "accept": ["youtube", "vimeo"],
      "info": "Used when no uploaded video is set."
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover image",
      "info": "Shown when no video is set."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true,
      "info": "Autoplaying video is always muted"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "select",
      "id": "aspect",
      "label": "Aspect ratio",
      "options": [
        { "value": "16/9", "label": "16:9 widescreen" },
        { "value": "21/9", "label": "21:9 cinematic" },
        { "value": "4/5", "label": "4:5 portrait" }
      ],
      "default": "16/9"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Video"
    }
  ]
}
{% endschema %}
