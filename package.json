{
  "name": "shark-bite-theme",
  "version": "2.0.0",
  "description": "Shopify Online Store 2.0 theme for Shark Bite (sharkbitelb.store) — plush shark slippers and the shark blanket, delivered across Lebanon",
  "private": true,
  "license": "MIT",
  "homepage": "https://sharkbitelb.store",
  "scripts": {
    "dev": "shopify theme dev",
    "check": "shopify theme check",
    "check:fix": "shopify theme check --auto-correct",
    "pull": "shopify theme pull",
    "push": "shopify theme push --unpublished",
    "deploy": "shopify theme push --live",
    "package": "shopify theme package",
    "validate:json": "node scripts/validate-json.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@shopify/cli": "^3.60.0"
  }
}
