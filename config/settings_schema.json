[
  {
    "name": "theme_info",
    "theme_name": "House of Garments",
    "theme_version": "1.0.0",
    "theme_author": "House of Garments",
    "theme_documentation_url": "https://houseofgarments.co",
    "theme_support_url": "https://houseofgarments.co/pages/contact"
  },
  {
    "name": "t:settings_schema.brand.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings_schema.brand.settings.logo.label"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 320,
        "step": 10,
        "unit": "px",
        "label": "t:settings_schema.brand.settings.logo_width.label",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings_schema.brand.settings.favicon.label",
        "info": "t:settings_schema.brand.settings.favicon.info"
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "t:settings_schema.brand.settings.brand_tagline.label",
        "default": "EVERYBODY CAN'T HAVE LIMITED ITEMS"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "t:settings_schema.brand.settings.share_image.label",
        "info": "t:settings_schema.brand.settings.share_image.info"
      }
    ]
  },
  {
    "name": "t:settings_schema.colors.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.colors.headers.surfaces"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "t:settings_schema.colors.settings.color_background.label",
        "default": "#0a0a0a"
      },
      {
        "type": "color",
        "id": "color_background_alt",
        "label": "t:settings_schema.colors.settings.color_background_alt.label",
        "default": "#151515"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "t:settings_schema.colors.settings.color_border.label",
        "default": "#2a2a2a"
      },
      {
        "type": "header",
        "content": "t:settings_schema.colors.headers.text"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "t:settings_schema.colors.settings.color_text.label",
        "default": "#f5f5f5"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "t:settings_schema.colors.settings.color_text_muted.label",
        "default": "#8a8a8a"
      },
      {
        "type": "header",
        "content": "t:settings_schema.colors.headers.accent"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "t:settings_schema.colors.settings.color_accent.label",
        "default": "#d6ff3f",
        "info": "t:settings_schema.colors.settings.color_accent.info"
      },
      {
        "type": "color",
        "id": "color_accent_contrast",
        "label": "t:settings_schema.colors.settings.color_accent_contrast.label",
        "default": "#0a0a0a"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "t:settings_schema.colors.settings.color_sale.label",
        "default": "#ff4d4d"
      },
      {
        "type": "header",
        "content": "t:settings_schema.colors.headers.buttons"
      },
      {
        "type": "color",
        "id": "color_button_background",
        "label": "t:settings_schema.colors.settings.color_button_background.label",
        "default": "#f5f5f5"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "t:settings_schema.colors.settings.color_button_text.label",
        "default": "#0a0a0a"
      }
    ]
  },
  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.typography.headers.headings"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "t:settings_schema.typography.settings.type_heading_font.label",
        "default": "archivo_n6"
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "min": 90,
        "max": 140,
        "step": 5,
        "unit": "%",
        "label": "t:settings_schema.typography.settings.type_heading_scale.label",
        "default": 105
      },
      {
        "type": "range",
        "id": "type_heading_tracking",
        "min": -1,
        "max": 8,
        "step": 1,
        "unit": "px",
        "label": "t:settings_schema.typography.settings.type_heading_tracking.label",
        "default": 1
      },
      {
        "type": "checkbox",
        "id": "type_heading_uppercase",
        "label": "t:settings_schema.typography.settings.type_heading_uppercase.label",
        "default": true
      },
      {
        "type": "header",
        "content": "t:settings_schema.typography.headers.body"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:settings_schema.typography.settings.type_body_font.label",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "type_body_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "t:settings_schema.typography.settings.type_body_scale.label",
        "default": 100
      },
      {
        "type": "checkbox",
        "id": "use_display_font",
        "label": "Use display font (Anton)",
        "info": "Loads Anton from Google Fonts for hero, marquee and oversized headings.",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings_schema.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "layout_max_width",
        "min": 1000,
        "max": 1800,
        "step": 20,
        "unit": "px",
        "label": "t:settings_schema.layout.settings.layout_max_width.label",
        "default": 1440
      },
      {
        "type": "range",
        "id": "layout_gutter",
        "min": 12,
        "max": 64,
        "step": 2,
        "unit": "px",
        "label": "t:settings_schema.layout.settings.layout_gutter.label",
        "default": 24
      },
      {
        "type": "range",
        "id": "layout_corner_radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "t:settings_schema.layout.settings.layout_corner_radius.label",
        "default": 0,
        "info": "t:settings_schema.layout.settings.layout_corner_radius.info"
      },
      {
        "type": "range",
        "id": "grid_gap",
        "min": 2,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "t:settings_schema.layout.settings.grid_gap.label",
        "default": 8
      },
      {
        "type": "checkbox",
        "id": "animations_enabled",
        "label": "t:settings_schema.layout.settings.animations_enabled.label",
        "default": true,
        "info": "t:settings_schema.layout.settings.animations_enabled.info"
      },
      {
        "type": "select",
        "id": "layout_button_shape",
        "label": "Button shape",
        "options": [
          { "value": "square", "label": "Square" },
          { "value": "rounded", "label": "Rounded" },
          { "value": "pill", "label": "Pill" }
        ],
        "default": "pill"
      },
      {
        "type": "checkbox",
        "id": "show_grain",
        "label": "Film grain overlay",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings_schema.product_cards.name",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "t:settings_schema.product_cards.settings.card_image_ratio.label",
        "options": [
          { "value": "square", "label": "t:settings_schema.product_cards.settings.card_image_ratio.options__1" },
          { "value": "portrait", "label": "t:settings_schema.product_cards.settings.card_image_ratio.options__2" },
          { "value": "natural", "label": "t:settings_schema.product_cards.settings.card_image_ratio.options__3" }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "card_hover_second_image",
        "label": "t:settings_schema.product_cards.settings.card_hover_second_image.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "t:settings_schema.product_cards.settings.card_show_vendor.label",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_badges",
        "label": "t:settings_schema.product_cards.settings.card_show_badges.label",
        "default": true,
        "info": "t:settings_schema.product_cards.settings.card_show_badges.info"
      },
      {
        "type": "checkbox",
        "id": "card_sold_out_short",
        "label": "t:settings_schema.product_cards.settings.card_sold_out_short.label",
        "default": true,
        "info": "t:settings_schema.product_cards.settings.card_sold_out_short.info"
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "t:settings_schema.product_cards.settings.card_quick_add.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "currency_code_enabled",
        "label": "t:settings_schema.product_cards.settings.currency_code_enabled.label",
        "default": true,
        "info": "t:settings_schema.product_cards.settings.currency_code_enabled.info"
      }
    ]
  },
  {
    "name": "t:settings_schema.cart.name",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:settings_schema.cart.settings.cart_type.label",
        "options": [
          { "value": "drawer", "label": "t:settings_schema.cart.settings.cart_type.options__1" },
          { "value": "page", "label": "t:settings_schema.cart.settings.cart_type.options__2" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "t:settings_schema.cart.settings.cart_show_note.label",
        "default": true
      },
      {
        "type": "richtext",
        "id": "cart_notice",
        "label": "t:settings_schema.cart.settings.cart_notice.label",
        "default": "<p>Delivery all over Lebanon. Orders ship within 2–4 business days.</p>"
      },
      {
        "type": "checkbox",
        "id": "free_shipping_enabled",
        "label": "Show free-shipping progress bar",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free-shipping threshold",
        "info": "In store currency. Keep in sync with your shipping settings.",
        "default": 100
      },
      {
        "type": "checkbox",
        "id": "cart_upsells_enabled",
        "label": "Show cart upsells",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_upsells_heading",
        "label": "Cart upsells heading",
        "default": "COMPLETE THE FIT"
      }
    ]
  },
  {
    "name": "t:settings_schema.social.name",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "t:settings_schema.social.settings.social_instagram_link.label",
        "default": "https://www.instagram.com/houseofgarments.co/"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "t:settings_schema.social.settings.social_tiktok_link.label"
      },
      {
        "type": "text",
        "id": "social_whatsapp_link",
        "label": "t:settings_schema.social.settings.social_whatsapp_link.label",
        "info": "t:settings_schema.social.settings.social_whatsapp_link.info"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "t:settings_schema.social.settings.social_facebook_link.label"
      }
    ]
  },
  {
    "name": "t:settings_schema.search.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "t:settings_schema.search.settings.predictive_search_enabled.label",
        "default": true
      }
    ]
  }
]
