{%- liquid
  assign product = settings.featured_product
  assign image = section.settings.image
  if image == blank and product != blank
    assign image = product.featured_image
  endif
  assign from_price = product.price_min | money
-%}

<section class="section section--tight">
  <div class="container">
    <div class="cta-banner__inner reveal reveal--scale">
      <div class="cta-banner__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        <p class="lead">{{ section.settings.text | escape }}</p>
        <div class="cta-banner__actions">
          <a class="btn btn--lg" href="{{ section.settings.cta_link | default: '#bundles' }}">{{ section.settings.cta_label | escape }}{% render 'icon', name: 'arrow-right' %}</a>
          {%- if product != blank -%}
            <span class="small">{{ 'products.product.from_price' | t: price: from_price }} · {{ settings.guarantee_days }}-{{ 'general.day' | t }} {{ 'general.guarantee' | t }}</span>
          {%- endif -%}
        </div>
      </div>
      <div class="cta-banner__image">
        {%- if image != blank -%}
          <img src="{{ image | image_url: width: 600 }}" alt="{{ image.alt | escape }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Call to action banner",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ready when they are" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Give them the goodest years of their life." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "One chew a day, eight benefits, zero fuss. Pick a bundle and let the tail do the talking." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Choose your bundle" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the product's featured image." }
  ],
  "presets": [{ "name": "Call to action banner" }]
}
{% endschema %}
