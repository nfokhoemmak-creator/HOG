<section class="section section--alt" id="{{ section.settings.anchor | default: 'how-it-works' }}">
  <div class="container">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>

    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step reveal" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <div class="step__num">{{ forloop.index }}</div>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="text-center muted small reveal" style="margin-top: var(--space-6);">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "how-it-works" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Easier than a walk in the rain" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "note", "label": "Small note", "default": "Follow the feeding guide on the bag for your dog's weight. Fresh water always available." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pick your bundle" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Start with one bag or stock up and save. Every order is covered by the Happy Dog Guarantee." }
      ]
    }
  ],
  "presets": [{ "name": "How it works" }]
}
{% endschema %}
