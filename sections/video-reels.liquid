{{ 'section-video-reels.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-video-reels.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign has_video = false
  for block in section.blocks
    if block.settings.video != blank or block.settings.mp4_url != blank
      assign has_video = true
    elsif block.settings.video_url != blank and block.settings.video_url.id != blank
      assign has_video = true
    endif
  endfor

  case section.settings.color_scheme
    when 'alt'
      assign scheme_class = ' section--alt'
    when 'brand'
      assign scheme_class = ' section--brand'
    else
      assign scheme_class = ''
  endcase

  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign pt_mobile = pt | times: 0.75 | round
  assign pb_mobile = pb | times: 0.75 | round
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .video-reels {
    padding-top: {{ pt_mobile }}px;
    padding-bottom: {{ pb_mobile }}px;
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .video-reels {
      padding-top: {{ pt }}px;
      padding-bottom: {{ pb }}px;
    }
  }
{%- endstyle -%}

{%- if has_video or request.design_mode -%}
  <video-reels
    class="section video-reels{{ scheme_class }}"
    data-section-id="{{ section.id }}"
    data-autoplay="{% if section.settings.autoplay %}true{% else %}false{% endif %}"
  >
    <div class="container">
      <div class="section__header">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="section__title h2 video-reels__heading">
              <span class="video-reels__mark accent" aria-hidden="true">{% render 'icon', name: 'shark' %}</span>
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="section__subtitle">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.show_arrows -%}
          <div class="video-reels__nav" data-reels-nav>
            <button type="button" class="icon-btn video-reels__arrow" data-reels-prev aria-label="{{ 'accessibility.previous_slide' | t }}" disabled>
              {% render 'icon', name: 'chevron-left' %}
            </button>
            <button type="button" class="icon-btn video-reels__arrow" data-reels-next aria-label="{{ 'accessibility.next_slide' | t }}">
              {% render 'icon', name: 'chevron-right' %}
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div
      class="video-reels__track"
      data-reels-track
      role="region"
      aria-label="{{ section.settings.heading | default: 'Videos' | escape }}"
      tabindex="0"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign block_source = ''
          if b.video != blank
            assign block_source = 'shopify'
          elsif b.video_url != blank and b.video_url.id != blank
            assign block_source = 'external'
          elsif b.mp4_url != blank
            assign block_source = 'mp4'
          endif
          assign reel_product = b.product
          assign reel_label = b.caption | default: section.settings.heading
        -%}

        {%- if block_source != '' or request.design_mode -%}
          <article
            class="video-reels__card{% if block_source == '' %} video-reels__card--empty{% endif %}"
            data-reel
            data-reel-source="{{ block_source }}"
            {{ block.shopify_attributes }}
          >
            <div class="video-reels__media" data-reel-media>
              {%- render 'video',
                video: b.video,
                video_url: b.video_url,
                mp4_url: b.mp4_url,
                poster: b.poster,
                autoplay: false,
                loop: true,
                muted: true,
                controls: false,
                aspect: '9/16',
                preload: 'none',
                lazy: true,
                class: 'video-reels__video',
                label: reel_label
              -%}

              {%- if block_source == 'shopify' or block_source == 'mp4' -%}
                <button
                  type="button"
                  class="video-reels__control video-reels__control--play"
                  data-reel-play
                  aria-label="{{ 'accessibility.play_video' | t }}"
                  data-label-play="{{ 'accessibility.play_video' | t | escape }}"
                  data-label-pause="{{ 'accessibility.pause_video' | t | escape }}"
                  hidden
                >
                  <span class="video-reels__icon-play">{% render 'icon', name: 'play' %}</span>
                  <span class="video-reels__icon-pause">{% render 'icon', name: 'pause' %}</span>
                </button>
                <button
                  type="button"
                  class="video-reels__control video-reels__control--mute"
                  data-reel-mute
                  aria-pressed="true"
                  aria-label="{{ 'accessibility.unmute_video' | t }}"
                  data-label-mute="{{ 'accessibility.mute_video' | t | escape }}"
                  data-label-unmute="{{ 'accessibility.unmute_video' | t | escape }}"
                  hidden
                >
                  <span class="video-reels__icon-muted">{% render 'icon', name: 'mute' %}</span>
                  <span class="video-reels__icon-sound">{% render 'icon', name: 'unmute' %}</span>
                </button>
              {%- endif -%}

              {%- if b.caption != blank -%}
                <p class="video-reels__caption">
                  {%- if b.link != blank -%}
                    <a href="{{ b.link }}">{{ b.caption | escape }}</a>
                  {%- else -%}
                    {{ b.caption | escape }}
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>

            {%- if reel_product != blank -%}
              <div class="video-reels__product">
                {%- if reel_product.featured_media -%}
                  <img
                    class="video-reels__thumb"
                    src="{{ reel_product.featured_media | image_url: width: 120 }}"
                    srcset="{{ reel_product.featured_media | image_url: width: 120 }} 1x, {{ reel_product.featured_media | image_url: width: 240 }} 2x"
                    alt=""
                    width="60"
                    height="60"
                    loading="lazy"
                  >
                {%- endif -%}
                <div class="video-reels__product-info">
                  <a class="video-reels__product-title h5" href="{{ reel_product.url }}">{{ reel_product.title | escape }}</a>
                  {% render 'price', product: reel_product %}
                </div>
                <a class="btn btn--sm video-reels__shop" href="{{ reel_product.url }}" aria-label="{{ 'collections.shop_now' | t }}: {{ reel_product.title | escape }}">
                  {{ 'collections.shop_now' | t }}
                </a>
              </div>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.blocks.size == 0 and request.design_mode -%}
        <article class="video-reels__card video-reels__card--empty" data-reel data-reel-source="">
          <div class="video-reels__media">
            {% render 'video', aspect: '9/16', class: 'video-reels__video' %}
          </div>
        </article>
      {%- endif -%}
    </div>
  </video-reels>
{%- endif -%}

{% schema %}
{
  "name": "Video reels",
  "tag": "section",
  "class": "section-video-reels",
  "settings": [
    {
      "type": "paragraph",
      "content": "A horizontal row of vertical (9:16) videos, like TikTok or Reels. On the live store the section only shows when at least one reel has a video."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As seen on your feed"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Real sharks, real homes. Tap a reel for sound."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay the reel in view (muted)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows on desktop",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Soft aqua" },
        { "value": "brand", "label": "Navy" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video (uploaded to Shopify)"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Or YouTube / Vimeo link",
          "accept": ["youtube", "vimeo"],
          "info": "External videos load when tapped; only uploaded or MP4 videos autoplay."
        },
        {
          "type": "text",
          "id": "mp4_url",
          "label": "Or MP4 file URL",
          "info": "A direct link to an .mp4 file, e.g. from Shopify Files."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image",
          "info": "Shown before the video plays. Portrait (9:16) works best."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Featured product",
          "info": "Adds a product chip with price and a Shop button under the reel."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Caption link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video reels",
      "blocks": [
        { "type": "reel", "settings": { "caption": "Cozy mornings in the Winter slippers" } },
        { "type": "reel", "settings": { "caption": "The shark blanket, unboxed" } },
        { "type": "reel", "settings": { "caption": "Originals on a sunny day" } },
        { "type": "reel", "settings": { "caption": "Sizes 36–45 for the whole family" } }
      ]
    }
  ]
}
{% endschema %}
