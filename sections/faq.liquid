{%- assign days = settings.guarantee_days -%}
<section class="section" id="{{ section.settings.anchor | default: 'faq' }}">
  <div class="container">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>

    <div class="faq reveal" data-accordion-group>
      {%- for block in section.blocks -%}
        <details class="accordion" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            {{ block.settings.question | escape }}
            <span class="accordion__icon">{% render 'icon', name: 'plus' %}</span>
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer | replace: '[days]', days }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.contact_text != blank -%}
      <p class="text-center muted reveal" style="margin-top: var(--space-6);">{{ section.settings.contact_text }}</p>
    {%- endif -%}
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | replace: '[days]', days | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "faq" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good questions from good dog parents" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question by default", "default": true },
    { "type": "richtext", "id": "contact_text", "label": "Contact line", "default": "<p>Still wondering? Email <a href=\"mailto:goodestchews@outlook.com\">goodestchews@outlook.com</a> and a human (with a dog) will reply.</p>" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How many chews does my dog need?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Follow the feeding guide printed on the bag — it's based on your dog's weight.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
