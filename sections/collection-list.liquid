<div class="section">
  <div class="container">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="h2">{{ section.settings.title }}</h2>
      </div>
      <a class="link-arrow" href="{{ routes.collections_url }}">
        {{ 'sections.collection_list.view_all' | t }}
        {% render 'icon', name: 'arrow-right' %}
      </a>
    </div>

    <div class="product-grid" style="--cols-desktop: {{ section.settings.columns_desktop }}; --cols-tablet: {{ section.settings.columns_desktop }}; --cols-mobile: 2;">
      {%- assign fallback_title = 'onboarding.collection_title' | t -%}
      {%- for block in section.blocks -%}
        {%- assign block_collection = collections[block.settings.collection] -%}
        <div class="card" {{ block.shopify_attributes }}>
          <a class="card__media card__media--square" href="{{ block_collection.url | default: routes.collections_url }}">
            {%- if block_collection.image -%}
              <img
                class="card__image card__image--primary"
                src="{{ block_collection.image | image_url: width: 800 }}"
                alt="{{ block_collection.image.alt | escape }}"
                width="{{ block_collection.image.width }}"
                height="{{ block_collection.image.height }}"
                loading="lazy"
              >
            {%- elsif block_collection.products.first.featured_media -%}
              <img
                class="card__image card__image--primary"
                src="{{ block_collection.products.first.featured_media | image_url: width: 800 }}"
                alt=""
                width="800"
                height="800"
                loading="lazy"
              >
            {%- else -%}
              {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'card__image' }}
            {%- endif -%}
          </a>

          <div class="card__info center">
            <a class="card__title" href="{{ block_collection.url | default: routes.collections_url }}">
              {{ block.settings.title | default: block_collection.title | default: fallback_title }}
            </a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "tag": "section",
  "class": "collection-list-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.collection_list.settings.title.label",
      "default": "Find your routine"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:sections.collection_list.settings.columns_desktop.label",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "t:sections.collection_list.blocks.featured_collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection_list.blocks.featured_collection.settings.collection.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.collection_list.blocks.featured_collection.settings.title.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.name",
      "blocks": [
        { "type": "featured_collection", "settings": { "title": "Skincare" } },
        { "type": "featured_collection", "settings": { "title": "Makeup" } },
        { "type": "featured_collection", "settings": { "title": "Body" } },
        { "type": "featured_collection", "settings": { "title": "Sets & gifts" } }
      ]
    }
  ]
}
{% endschema %}
