{%- assign fp = settings.featured_product -%}

<div class="container">
  <div class="page-head">
    <h1>{{ 'sections.cart.title' | t }}</h1>
  </div>

  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      {% render 'icon', name: 'paw' %}
      <p class="h3">{{ 'sections.cart.empty' | t }}</p>
      <p class="muted">{{ 'sections.cart.empty_body' | t }}</p>
      <a class="btn" href="{% if fp != blank %}{{ fp.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ 'sections.cart.shop_now' | t }}</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-page">
      <ul class="cart-items">
        {%- for item in cart.items -%}
          <li class="cart-item">
            <a class="cart-item__image" href="{{ item.url }}">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.image.alt | escape }}" width="110" height="110" loading="lazy">
              {%- endif -%}
            </a>
            <div>
              <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}<span class="cart-item__variant">{{ item.variant.title }}</span>{%- endunless -%}
              <span class="cart-item__variant">{{ item.final_price | money }}</span>
              {%- for discount in item.line_level_discount_allocations -%}
                <span class="cart-item__variant text-green">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</span>
              {%- endfor -%}
              <div class="cart-item__actions">
                <quantity-input class="quantity-input">
                  <button type="button" data-action="decrease" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title }}">&minus;</button>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title }}">
                  <button type="button" data-action="increase" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title }}">+</button>
                </quantity-input>
                <span class="price">{{ item.final_line_price | money }}</span>
              </div>
              <a class="cart-item__remove" href="{{ item.url_to_remove }}">{{ 'sections.cart.remove' | t }}</a>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <aside class="cart-page__summary">
        {%- if settings.cart_show_note -%}
          <div class="field">
            <label class="field__label" for="CartNote">{{ 'sections.cart.note' | t }}</label>
            <textarea id="CartNote" class="field__input" name="note" placeholder="{{ 'sections.cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}

        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-totals accent"><span>{{ discount.title }}</span><span>-{{ discount.total_allocated_amount | money }}</span></div>
        {%- endfor -%}

        <div class="cart-totals"><span>{{ 'sections.cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
        <p class="cart-notice">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>

        <button type="submit" name="update" class="btn btn--outline btn--sm">{{ 'sections.cart.update' | t }}</button>
        <button type="submit" name="checkout" class="btn btn--full btn--lg">{% render 'icon', name: 'lock' %}{{ 'sections.cart.checkout' | t }}</button>

        {%- if additional_checkout_buttons -%}
          <div>{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}

        <div class="cart-drawer__trust">
          <span>{% render 'icon', name: 'shield-check' %} {{ settings.guarantee_days }}-{{ 'general.day' | t }} {{ 'general.guarantee' | t }}</span>
          <span>{% render 'icon', name: 'lock' %} {{ 'sections.cart.secure' | t }}</span>
        </div>

        {%- if settings.cart_notice != blank -%}<div class="cart-notice">{{ settings.cart_notice }}</div>{%- endif -%}
      </aside>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart page",
  "tag": "section",
  "class": "main-cart-section",
  "settings": []
}
{% endschema %}
