<div class="container">
  <div class="page-head">
    <h1>{{ 'general.search.search' | t }}</h1>
    {%- if search.performed -%}
      <p>{{ 'general.search.results_with_count' | t: count: search.results_count }} {% if search.terms != blank %}— {{ 'general.search.results_for' | t: terms: search.terms }}{% endif %}</p>
    {%- endif -%}
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <label class="visually-hidden" for="SearchInput">{{ 'general.search.placeholder' | t }}</label>
    <input class="field__input" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="btn">{{ 'general.search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 12 -%}
      {%- if search.results_count == 0 -%}
        <p class="text-center muted">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', card_product: item %}
            {%- else -%}
              <div class="article-card">
                <h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2>
                <p class="muted">{{ item.content | strip_html | truncatewords: 30 }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search page",
  "tag": "section",
  "settings": []
}
{% endschema %}
