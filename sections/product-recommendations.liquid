{%- comment -%}
  "You may also like" on the product page, driven by Shopify's product
  recommendations API. The custom element in theme.js fetches this section
  back with ?section_id + product_id once it scrolls near the viewport and
  swaps in the rendered result. Without JS the section simply stays empty —
  nothing on the page depends on it.
{%- endcomment -%}

<product-recommendations
  class="recommendations"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="section">
      <div class="container">
        <div class="section__head">
          <h2 class="h2">{{ section.settings.heading }}</h2>
        </div>

        <div
          class="product-grid"
          style="--cols-desktop: {{ section.settings.columns_desktop }}; --cols-mobile: {{ section.settings.columns_mobile }};"
        >
          {%- for recommendation in recommendations.products -%}
            {% render 'product-card', card_product: recommendation, lazy_load: true %}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "tag": "section",
  "class": "product-recommendations-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product_recommendations.settings.heading.label",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "t:sections.product_recommendations.settings.products_to_show.label",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:sections.product_recommendations.settings.columns_desktop.label",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.product_recommendations.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "t:sections.product_recommendations.settings.columns_mobile.options__1" },
        { "value": "2", "label": "t:sections.product_recommendations.settings.columns_mobile.options__2" }
      ],
      "default": "2"
    }
  ]
}
{% endschema %}
