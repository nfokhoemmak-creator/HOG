{%- comment -%}
  Renders a benefit/trust icon as inline SVG. Separate from 'icon' so the
  UI icon set stays small; these are only used by marketing sections.

  Accepts:
  - name: {String} shipping | returns | warranty | secure | support | box |
          star | check | gift | card | globe | clock | heart | diamond

  Usage:
  {% render 'icon-benefit', name: 'shipping' %}
{%- endcomment -%}

{%- case name -%}
  {%- when 'shipping' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M2 7h11v9H2zM13 10h4l3 3v3h-7"/>
      <circle cx="6.5" cy="17.5" r="1.6"/>
      <circle cx="16.5" cy="17.5" r="1.6"/>
    </svg>

  {%- when 'returns' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M3 9a8 8 0 0 1 14.5-3M21 15a8 8 0 0 1-14.5 3"/>
      <path d="M17.5 2v4h4M6.5 22v-4h-4"/>
    </svg>

  {%- when 'warranty' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M12 2.5 5 5v6c0 4.5 3 8.4 7 10 4-1.6 7-5.5 7-10V5z"/>
      <path d="m8.8 11.8 2.3 2.3 4.1-4.6"/>
    </svg>

  {%- when 'secure' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <rect x="4.5" y="10" width="15" height="10" rx="1.5"/>
      <path d="M8 10V7.5a4 4 0 0 1 8 0V10"/>
      <circle cx="12" cy="15" r="1.3" fill="currentColor" stroke="none"/>
    </svg>

  {%- when 'support' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M4 13a8 8 0 0 1 16 0"/>
      <rect x="2.5" y="13" width="4" height="6" rx="1.5"/>
      <rect x="17.5" y="13" width="4" height="6" rx="1.5"/>
      <path d="M19.5 19a4 4 0 0 1-4 3h-2"/>
    </svg>

  {%- when 'box' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/>
      <path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/>
    </svg>

  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="m12 3 2.7 5.6 6.1.8-4.5 4.2 1.1 6-5.4-3-5.4 3 1.1-6L3.2 9.4l6.1-.8z"/>
    </svg>

  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9"/>
      <path d="m7.8 12.4 2.8 2.8 5.6-6"/>
    </svg>

  {%- when 'gift' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <rect x="3.5" y="8" width="17" height="4" rx="1"/>
      <path d="M5 12v8h14v-8M12 8v12"/>
      <path d="M12 8c-4 0-5-1.5-5-2.75S8.5 3 10 4.5 12 8 12 8zm0 0c4 0 5-1.5 5-2.75S15.5 3 14 4.5 12 8 12 8z"/>
    </svg>

  {%- when 'card' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <rect x="2.5" y="5.5" width="19" height="13" rx="2"/>
      <path d="M2.5 10h19M6 14.5h5"/>
    </svg>

  {%- when 'globe' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9"/>
      <path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/>
    </svg>

  {%- when 'clock' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9"/>
      <path d="M12 7v5l3.5 2"/>
    </svg>

  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M12 20.5S3.5 15.5 3.5 9.6A4.6 4.6 0 0 1 12 7a4.6 4.6 0 0 1 8.5 2.6c0 5.9-8.5 10.9-8.5 10.9z"/>
    </svg>

  {%- when 'diamond' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M7 3.5h10L21 9l-9 11.5L3 9z"/>
      <path d="M3 9h18M9.5 9 12 20.5 14.5 9M7 3.5 9.5 9m7.5-5.5L14.5 9"/>
    </svg>

  {%- else -%}
{%- endcase -%}
