{%- paginate collection.products by 24 -%}
  <div class="container" style="padding-bottom: var(--space-8);">
    <div class="toolbar">
      <span>{{ 'sections.collection_template.product_count' | t: count: collection.products_count }}</span>
      <form method="get" action="{{ collection.url }}">
        <label class="visually-hidden" for="SortBy">{{ 'sections.collection_template.sort_by_label' | t }}</label>
        <select id="SortBy" name="sort_by" onchange="this.form.submit()">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </div>

    {%- if collection.products.size == 0 -%}
      <p class="text-center muted">{{ 'sections.collection_template.empty' | t }}</p>
    {%- else -%}
      <div class="product-grid" style="--cols: 3;">
        {%- for product in collection.products -%}
          {% render 'product-card', card_product: product, lazy_load: forloop.index > 3 %}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {% render 'pagination', paginate: paginate %}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection grid",
  "tag": "section",
  "settings": []
}
{% endschema %}
