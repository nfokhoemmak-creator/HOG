{%- comment -%}
  The cart drawer. Rendered statically from layout/theme.liquid
  ({% section 'cart-drawer' %}) and re-rendered by cart-drawer.js through the
  Section Rendering API (sections=cart-drawer) after every cart mutation, so
  everything the drawer shows must be rendered here — nothing is templated
  client-side.
{%- endcomment -%}

{{ 'section-cart.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign whatsapp_number = settings.social_whatsapp_number | remove: ' ' | remove: '+' | remove: '-'
  assign threshold_cents = settings.free_shipping_threshold | times: 100
  assign free_shipping_line = ''
  if threshold_cents > 0 and settings.free_shipping_text != blank
    assign amt = threshold_cents | money_without_trailing_zeros
    assign free_shipping_line = settings.free_shipping_text | replace: '[amount]', amt
  endif
  assign has_discount = false
  if cart.cart_level_discount_applications.size > 0
    assign has_discount = true
  endif
  for item in cart.items
    if item.line_level_total_discount > 0
      assign has_discount = true
    endif
  endfor
-%}

<cart-drawer
  class="cart-drawer"
  data-item-count="{{ cart.item_count }}"
  aria-hidden="true"
  hidden
>
  <div class="cart-drawer__overlay" data-cart-overlay></div>

  <div
    class="cart-drawer__panel"
    data-cart-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="CartDrawerTitle"
    tabindex="-1"
  >
    <div class="cart-drawer__head">
      <h2 class="cart-drawer__title h4" id="CartDrawerTitle">
        {{ 'cart.title' | t }}
        <span class="cart-drawer__count" aria-hidden="true">({{ cart.item_count }})</span>
      </h2>
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    {%- if threshold_cents > 0 -%}
      <div class="cart-drawer__shipping">
        {% render 'free-shipping-bar', total: cart.total_price, compact: false %}
      </div>
    {%- endif -%}

    <div class="cart-drawer__body" data-cart-body>
      <p class="form__error cart-drawer__error" data-cart-error role="alert" hidden></p>

      {%- if cart.item_count == 0 -%}
        {% render 'cart-upsell', context: 'drawer' %}
      {%- else -%}
        <ul class="cart-lines" role="list">
          {%- for item in cart.items -%}
            <li class="cart-line" data-line-key="{{ item.key }}">
              <a class="cart-line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 160 }}"
                    srcset="{{ item.image | image_url: width: 160 }} 1x, {{ item.image | image_url: width: 320 }} 2x"
                    alt="{{ item.image.alt | default: item.product.title | escape }}"
                    width="80"
                    height="80"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>

              <div class="cart-line__details">
                <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>

                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-line__variant small muted">{{ item.variant.title | escape }}</p>
                {%- endunless -%}

                {%- if item.selling_plan_allocation -%}
                  <p class="cart-line__variant small muted">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                {%- endif -%}

                {%- for property in item.properties -%}
                  {%- assign property_first_char = property.first | slice: 0 -%}
                  {%- if property.last != blank and property_first_char != '_' -%}
                    <p class="cart-line__variant small muted">
                      {{ property.first }}:
                      {%- if property.last contains '/uploads/' -%}
                        <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>
                      {%- else -%}
                        {{ property.last }}
                      {%- endif -%}
                    </p>
                  {%- endif -%}
                {%- endfor -%}

                <div class="cart-line__row">
                  <quantity-input class="quantity-input cart-line__quantity">
                    <button type="button" data-action="decrease" aria-label="{{ 'products.product.decrease' | t }}">
                      {% render 'icon', name: 'minus' %}
                    </button>
                    <input
                      type="number"
                      inputmode="numeric"
                      value="{{ item.quantity }}"
                      min="0"
                      data-line-quantity="{{ item.key }}"
                      aria-label="{{ 'products.product.quantity' | t }}"
                    >
                    <button type="button" data-action="increase" aria-label="{{ 'products.product.increase' | t }}">
                      {% render 'icon', name: 'plus' %}
                    </button>
                  </quantity-input>

                  <div class="cart-line__price">
                    {%- if item.line_level_total_discount > 0 -%}
                      <s class="cart-line__compare">{{ item.original_line_price | money }}</s>
                      <span class="cart-line__final">{{ item.final_line_price | money }}</span>
                    {%- else -%}
                      <span class="cart-line__final">{{ item.final_line_price | money }}</span>
                    {%- endif -%}
                  </div>
                </div>

                {%- if item.line_level_total_discount > 0 -%}
                  <div class="cart-line__discounts">
                    {%- for allocation in item.line_level_discount_allocations -%}
                      <span class="badge badge--success">{{ allocation.discount_application.title }} &minus;{{ allocation.amount | money }}</span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                <a class="cart-line__remove small" href="{{ item.url_to_remove }}" data-line-remove="{{ item.key }}">
                  {{ 'cart.remove' | t }}
                </a>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {% render 'cart-upsell', context: 'drawer' %}

        {%- if settings.cart_show_note -%}
          <div class="cart-drawer__note field">
            <label class="field__label small" for="CartDrawerNote">{{ 'cart.note' | t }}</label>
            <textarea
              id="CartDrawerNote"
              class="field__input"
              name="note"
              form="CartDrawerForm"
              rows="2"
              data-cart-note
              placeholder="{{ 'cart.note_placeholder' | t }}"
            >{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__foot">
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-totals cart-totals--discount">
            <span>{{ 'cart.discount' | t }}: {{ discount.title }}</span>
            <span>&minus;{{ discount.total_allocated_amount | money }}</span>
          </div>
        {%- endfor -%}

        <div class="cart-totals cart-totals--subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span class="cart-totals__value">
            {%- if settings.currency_code_enabled -%}
              {{ cart.total_price | money_with_currency }}
            {%- else -%}
              {{ cart.total_price | money }}
            {%- endif -%}
          </span>
        </div>

        <p class="cart-drawer__taxes small muted">
          {%- if has_discount -%}
            {{ 'cart.discount_included_note' | t }}
          {%- else -%}
            {{ 'cart.taxes_note' | t }}
          {%- endif -%}
        </p>

        <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm" class="cart-drawer__checkout">
          <button type="submit" name="checkout" class="btn btn--full btn--lg">
            {% render 'icon', name: 'lock' %}
            {{ 'cart.checkout' | t }}
          </button>
        </form>

        <div class="cart-drawer__links">
          <a class="btn btn--ghost btn--sm" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
          <button type="button" class="btn btn--ghost btn--sm" data-cart-close>{{ 'general.continue_shopping' | t }}</button>
        </div>

        {%- if section.settings.show_trust -%}
          <ul class="cart-trust" role="list">
            {%- if free_shipping_line != blank -%}
              <li>{% render 'icon', name: 'truck' %}<span>{{ free_shipping_line }}</span></li>
            {%- endif -%}
            {%- if section.settings.trust_secure != blank -%}
              <li>{% render 'icon', name: 'lock' %}<span>{{ section.settings.trust_secure }}</span></li>
            {%- endif -%}
            {%- if section.settings.trust_whatsapp != blank and whatsapp_number != blank -%}
              <li>
                {% render 'icon', name: 'whatsapp' %}
                <a href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener">{{ section.settings.trust_whatsapp }}</a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if settings.cart_notice != blank -%}
          <div class="cart-drawer__notice small muted rte">{{ settings.cart_notice }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "tag": "div",
  "class": "cart-drawer-section",
  "disabled_on": {
    "groups": ["*"],
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Free-shipping bar, bundle nudges, note and delivery notice are controlled in Theme settings > Offers and Cart."
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust row",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_secure",
      "label": "Secure checkout label",
      "default": "Secure checkout"
    },
    {
      "type": "text",
      "id": "trust_whatsapp",
      "label": "WhatsApp label",
      "default": "WhatsApp support",
      "info": "Shown only when a WhatsApp number is set in Theme settings > Social."
    }
  ]
}
{% endschema %}
