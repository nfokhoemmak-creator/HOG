<section class="bhr-reviews">
  <div class="container">
    <div class="bhr-reviews__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="bhr-reviews__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="bhr-reviews__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <p class="bhr-reviews__summary">
        <span class="bhr-reviews__stars" aria-hidden="true">★★★★★</span>
        <strong>{{ section.settings.rating_value }}</strong>
        <span>{{ section.settings.rating_caption }}</span>
      </p>
    </div>

    <div class="bhr-reviews__rail" data-bhr-rail>
      {%- for block in section.blocks -%}
        <article class="bhr-review" {{ block.shopify_attributes }}>
          <p class="bhr-review__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
            {%- for i in (1..5) -%}{%- if i <= block.settings.stars -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}
          </p>
          {%- if block.settings.title != blank -%}
            <h3 class="bhr-review__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          <p class="bhr-review__text">{{ block.settings.text }}</p>
          <div class="bhr-review__meta">
            <span class="bhr-review__avatar">{{ block.settings.author | slice: 0, 1 }}</span>
            <span class="bhr-review__who">
              <span class="bhr-review__name">{{ block.settings.author }}</span>
              <span class="bhr-review__verified">{% render 'icon', name: 'shield' %} Verified buyer</span>
            </span>
            {%- if block.settings.detail != blank -%}
              <span class="bhr-review__detail">{{ block.settings.detail }}</span>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    <div class="bhr-reviews__nav">
      <button type="button" class="bhr-reviews__arrow" data-bhr-prev aria-label="Previous reviews">{% render 'icon', name: 'arrow-right' %}</button>
      <button type="button" class="bhr-reviews__arrow" data-bhr-next aria-label="Next reviews">{% render 'icon', name: 'arrow-right' %}</button>
    </div>
  </div>
</section>

<style>
  .bhr-reviews { background: var(--color-bg); }
  .bhr-reviews .container { padding-block: var(--space-8); }
  .bhr-reviews__head { text-align: center; max-width: 640px; margin: 0 auto var(--space-6); }
  .bhr-reviews__eyebrow {
    font-size: 1.2rem; letter-spacing: 0.32em; text-transform: uppercase;
    color: var(--color-accent); margin: 0 0 var(--space-2);
  }
  .bhr-reviews__heading { margin: 0 0 var(--space-3); font-size: calc(3.2rem * var(--font-heading-scale)); }
  .bhr-reviews__summary {
    display: flex; align-items: center; justify-content: center; gap: var(--space-2);
    margin: 0; color: var(--color-muted); font-size: 1.5rem;
  }
  .bhr-reviews__summary strong { font-family: var(--font-heading-family); font-weight: var(--font-heading-weight); font-size: 2.4rem; color: var(--color-fg); }
  .bhr-reviews__stars { color: #d9a441; letter-spacing: 3px; font-size: 1.7rem; }

  .bhr-reviews__rail {
    display: grid; grid-auto-flow: column; grid-auto-columns: min(360px, 82vw);
    gap: var(--space-4); overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 4px 4px var(--space-5); scrollbar-width: none;
  }
  .bhr-reviews__rail::-webkit-scrollbar { display: none; }

  .bhr-review {
    scroll-snap-align: start; background: var(--color-bg-alt);
    border: 1px solid var(--color-border); border-radius: var(--radius);
    padding: var(--space-5); display: flex; flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .bhr-review:hover { transform: translateY(-4px); box-shadow: 0 10px 34px rgba(33, 30, 25, 0.1); }
  .bhr-review__stars { color: #d9a441; letter-spacing: 2.5px; font-size: 1.5rem; margin: 0 0 var(--space-2); }
  .bhr-review__title { font-family: var(--font-body-family); font-weight: var(--font-body-weight-bold); font-size: 1.6rem; margin: 0 0 var(--space-2); text-transform: none; letter-spacing: 0; }
  .bhr-review__text { color: var(--color-fg); opacity: 0.85; font-size: 1.4rem; margin: 0; flex: 1; }
  .bhr-review__meta {
    margin-top: var(--space-4); padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    display: flex; align-items: center; gap: var(--space-3); font-size: 1.3rem;
  }
  .bhr-review__avatar {
    width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
    background: color-mix(in srgb, var(--color-accent) 16%, var(--color-bg));
    color: var(--color-accent); display: flex; align-items: center; justify-content: center;
    font-weight: var(--font-body-weight-bold);
  }
  .bhr-review__who { line-height: 1.4; }
  .bhr-review__name { font-weight: var(--font-body-weight-bold); display: block; }
  .bhr-review__verified { color: #3e7d54; display: inline-flex; align-items: center; gap: 5px; }
  .bhr-review__verified svg { width: 13px; height: 13px; }
  .bhr-review__detail { margin-left: auto; color: var(--color-muted); font-size: 1.2rem; text-align: right; line-height: 1.5; white-space: pre-line; }

  .bhr-reviews__nav { display: flex; justify-content: center; gap: var(--space-3); }
  .bhr-reviews__arrow {
    width: 46px; height: 46px; border-radius: 50%;
    border: 1px solid var(--color-border); background: none; cursor: pointer; color: var(--color-fg);
    display: flex; align-items: center; justify-content: center; transition: all 0.25s ease;
  }
  .bhr-reviews__arrow:hover { background: var(--color-fg); color: var(--color-bg); }
  .bhr-reviews__arrow svg { width: 18px; height: 18px; }
  .bhr-reviews__arrow[data-bhr-prev] svg { transform: rotate(180deg); }
</style>

<script>
  (function () {
    var section = document.querySelectorAll('.bhr-reviews');
    section.forEach(function (sec) {
      var rail = sec.querySelector('[data-bhr-rail]');
      if (!rail || rail.dataset.bhrInit) return;
      rail.dataset.bhrInit = '1';
      var step = function () {
        var card = rail.querySelector('.bhr-review');
        return card ? card.getBoundingClientRect().width + 20 : 380;
      };
      var prev = sec.querySelector('[data-bhr-prev]');
      var next = sec.querySelector('[data-bhr-next]');
      if (prev) prev.addEventListener('click', function () { rail.scrollBy({ left: -step(), behavior: 'smooth' }); });
      if (next) next.addEventListener('click', function () { rail.scrollBy({ left: step(), behavior: 'smooth' }); });
    });
  })();
</script>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "bhr-reviews-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn & loved, worldwide." },
    { "type": "text", "id": "rating_value", "label": "Average rating", "default": "4.9" },
    { "type": "text", "id": "rating_caption", "label": "Rating caption", "default": "based on 1,247 verified reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "Quality far above the price" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "The clasp is solid, the chain has real weight to it, and the finish is flawless." },
        { "type": "text", "id": "author", "label": "Author", "default": "Daniel M." },
        { "type": "text", "id": "detail", "label": "Detail (finish, date)", "default": "Silver" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
