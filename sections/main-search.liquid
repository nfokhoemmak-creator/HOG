{%- paginate search.results by 24 -%}
  <div class="container">
    <div style="padding-block: var(--space-6); display: grid; gap: var(--space-4);">
      <h1 class="h1">{{ 'general.search.search' | t }}</h1>

      <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="SearchInput">{{ 'general.search.placeholder' | t }}</label>
        <input
          class="field__input"
          id="SearchInput"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="btn">{{ 'general.search.submit' | t }}</button>
      </form>

      {%- if search.performed -%}
        <p class="eyebrow">
          {{ 'general.search.results_with_count' | t: count: search.results_count }}
        </p>
      {%- endif -%}
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <div class="product-grid" style="--cols-desktop: 4; --cols-mobile: 2;">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', card_product: item, lazy_load: forloop.index > 4 %}
            {%- else -%}
              <div class="card">
                <a class="card__title" href="{{ item.url }}">{{ item.title | escape }}</a>
                <p class="muted">{{ item.content | strip_html | truncatewords: 20 }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="empty-state">
          <p class="h3">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
          <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}">
            {{ 'sections.cart.browse_catalog' | t }}
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "class": "main-search-section",
  "settings": []
}
{% endschema %}
