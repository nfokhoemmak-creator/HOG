{%- comment -%}
  Renders an inline SVG icon (24×24, stroke-based, currentColor).

  Accepts:
  - name: {String} one of the cases below (required)

  Usage:
  {% render 'icon', name: 'paw' %}
{%- endcomment -%}

{%- liquid
  assign attrs = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"'
-%}

{%- case name -%}
  {%- when 'cart' -%}
    <svg {{ attrs }}><path d="M3 5h2l2.4 11.2a2 2 0 0 0 2 1.6h7.5a2 2 0 0 0 2-1.55L20.5 9H6"/><circle cx="10" cy="20" r="1.2"/><circle cx="17.5" cy="20" r="1.2"/></svg>
  {%- when 'search' -%}
    <svg {{ attrs }}><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
  {%- when 'account' -%}
    <svg {{ attrs }}><circle cx="12" cy="8.5" r="3.75"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/></svg>
  {%- when 'menu' -%}
    <svg {{ attrs }}><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  {%- when 'close' -%}
    <svg {{ attrs }}><path d="m5 5 14 14M19 5 5 19"/></svg>
  {%- when 'plus' -%}
    <svg {{ attrs }}><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg {{ attrs }}><path d="M5 12h14"/></svg>
  {%- when 'chevron-down' -%}
