<div class="section{% if section.settings.background == 'alt' %} section--alt{% endif %}">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="section__head section__head--center">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="lead">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="benefits" style="--cols-desktop: {{ section.settings.columns_desktop }};">
      {%- for block in section.blocks -%}
        <div class="benefit{% if settings.animations_enabled %} reveal{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img
              class="benefit__image"
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.image.alt | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
          {%- else -%}
            <span class="benefit__icon">{% render 'icon', name: block.settings.icon %}</span>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3>{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Benefits grid",
  "tag": "section",
  "class": "benefits-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why Jamalati"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything a plumper should be"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Made to be worn every day: hydrating, glossy and seriously plumping."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Alternate" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "lips", "label": "Lips" },
            { "value": "leaf", "label": "Leaf (clean)" },
            { "value": "face", "label": "Face (dermatologist-tested)" },
            { "value": "rabbit", "label": "Cruelty-free" },
            { "value": "sparkle", "label": "Sparkle (results)" },
            { "value": "drop", "label": "Drop (hydration)" },
            { "value": "shield", "label": "Shield (guarantee)" },
            { "value": "heart", "label": "Heart" },
            { "value": "truck", "label": "Truck" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "sparkle"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional, replaces the icon)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Visible plump in minutes"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "A fuller, juicier pout you can see in the mirror — not in a month."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits grid",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "lips", "heading": "Visible plump in minutes", "text": "A fuller, juicier pout you can see in the mirror — not in a month." } },
        { "type": "benefit", "settings": { "icon": "drop", "heading": "Hydrating gloss finish", "text": "High shine that conditions your lips instead of drying them out." } },
        { "type": "benefit", "settings": { "icon": "shield", "heading": "No needles, no downtime", "text": "All the volume, none of the appointments, swelling or $300 bills." } },
        { "type": "benefit", "settings": { "icon": "sparkle", "heading": "5 flavors to love", "text": "Strawberry, Pomegranate, Vanilla, Raspberry and Mercury. Collect them all." } }
      ]
    }
  ]
}
{% endschema %}
