{%- assign newsletter_fallback = 'general.newsletter_form.heading' | t -%}

<div class="section" style="background: var(--color-bg-alt);">
  <div class="container container--narrow center">
    <h2 class="h2" style="margin-bottom: var(--space-3);">
      {{ section.settings.heading | default: newsletter_fallback }}
    </h2>

    {%- if section.settings.text != blank -%}
      <div class="muted" style="margin-bottom: var(--space-4);">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter-form', style: 'justify-content: center;' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="Newsletter-{{ section.id }}">
        {{ 'general.newsletter_form.email_placeholder' | t }}
      </label>
      <input
        id="Newsletter-{{ section.id }}"
        class="field__input"
        type="email"
        name="contact[email]"
        placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
        autocomplete="email"
        required
      >
      <button type="submit" class="btn">{{ 'general.newsletter_form.submit' | t }}</button>

      {%- if form.errors -%}
        <p class="form__error" style="width: 100%;">
          {{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}
        </p>
      {%- elsif form.posted_successfully? -%}
        <p class="form__success" style="width: 100%;">{{ 'general.newsletter_form.confirmation' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "Get the drop first"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.newsletter.settings.text.label",
      "default": "<p>New releases go to the list before anywhere else.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.name"
    }
  ]
}
{% endschema %}
