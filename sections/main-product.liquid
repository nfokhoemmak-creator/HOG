{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  assign is_preorder = false
  if product.tags contains 'preorder'
    assign is_preorder = true
  endif

  assign is_bestseller = false
  if product.tags contains 'bestseller'
    assign is_bestseller = true
  endif

  assign is_limited = false
  if product.tags contains 'limited'
    assign is_limited = true
  endif

  assign form_id = 'ProductForm-' | append: section.id

  assign rating_value = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count.value
-%}

<div class="container">
  <div class="product">
    {%- comment -%} ------------------------------------------------ gallery {%- endcomment -%}
    <div class="product__media" data-gallery>
      <div class="product__media-list">
        {%- for media in product.media -%}
          <div data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <img
                  src="{{ media | image_url: width: 1400 }}"
                  srcset="
                    {{ media | image_url: width: 600 }} 600w,
                    {{ media | image_url: width: 1000 }} 1000w,
                    {{ media | image_url: width: 1400 }} 1400w,
                    {{ media | image_url: width: 1800 }} 1800w
                  "
                  sizes="(min-width: 990px) 60vw, 100vw"
                  alt="{{ media.alt | escape }}"
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                >

              {%- when 'video' -%}
                {{ media | video_tag: image_size: '1400x', controls: true, muted: true, playsinline: true }}

              {%- when 'external_video' -%}
                {{ media | external_video_tag }}

              {%- when 'model' -%}
                {{ media | model_viewer_tag }}

              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: '' }}
        {%- endfor -%}
      </div>

      {%- if product.media.size > 1 and section.settings.media_layout == 'thumbnails' -%}
        <div class="product__thumbs">
          {%- for media in product.media -%}
            <button
              type="button"
              class="product__thumb"
              data-thumb="{{ media.id }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
            >
              <img
                src="{{ media.preview_image | image_url: width: 200 }}"
                alt=""
                width="72"
                height="72"
                loading="lazy"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} --------------------------------------------------- info {%- endcomment -%}
    <div class="product__info{% if section.settings.enable_sticky_info %} product__info--sticky{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'badges' -%}
            {%- if is_preorder or is_bestseller or is_limited or product.available == false -%}
              <div class="product__badges" {{ block.shopify_attributes }}>
                {%- if is_bestseller -%}
                  <span class="badge badge--accent">{{ 'products.product.bestseller' | t }}</span>
                {%- endif -%}
                {%- if is_limited -%}
                  <span class="badge badge--accent">{{ 'products.product.limited' | t }}</span>
                {%- endif -%}
                {%- if is_preorder -%}
                  <span class="badge">{{ 'products.product.preorder' | t }}</span>
                {%- endif -%}
                {%- unless product.available -%}
                  <span class="badge badge--sold">{{ 'products.product.sold_out' | t }}</span>
                {%- endunless -%}
              </div>
            {%- endif -%}

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'rating' -%}
            {%- liquid
              assign show_rating = rating_value
              assign show_count = rating_count
              if show_rating == blank and block.settings.fallback_rating != blank
                assign show_rating = block.settings.fallback_rating
                assign show_count = block.settings.fallback_count
              endif
            -%}
            {%- if show_rating != blank -%}
              <div class="rating product__rating" {{ block.shopify_attributes }}>
                {% render 'stars', rating: show_rating, uid: section.id %}
                <span class="rating__value">{{ show_rating }}</span>
                {%- if show_count != blank -%}
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">{{ 'sections.testimonials.reviews_count' | t: count: show_count }}</a>
                  {%- else -%}
                    <span>{{ 'sections.testimonials.reviews_count' | t: count: show_count }}</span>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'price' -%}
            <div id="ProductPrice-{{ section.id }}" {{ block.shopify_attributes }}>
              {% render 'price',
                product: product,
                use_variant: true,
                price_class: 'product__price',
                id_prefix: 'ProductPrice'
              %}
              {%- if block.settings.note != blank -%}
                <p class="product__price-note">{{ block.settings.note }}</p>
              {%- endif -%}
            </div>

          {%- when 'benefits' -%}
            {%- liquid
              assign benefits_text = block.settings.text
              if product.metafields.custom.benefits != blank
                assign benefits_text = product.metafields.custom.benefits
              endif
              assign benefit_lines = benefits_text | newline_to_br | split: '<br />'
            -%}
            {%- if benefits_text != blank -%}
              <ul class="checklist" {{ block.shopify_attributes }}>
                {%- for line in benefit_lines -%}
                  {%- assign clean = line | strip -%}
                  {%- if clean != blank -%}
                    <li>{% render 'icon', name: 'check' %}<span>{{ clean }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

          {%- when 'flavors' -%}
            {%- liquid
              assign flavor_collection = block.settings.collection
              assign strip_text = block.settings.strip_text
              assign current_name = product.title | remove: strip_text | strip
            -%}
            {%- if flavor_collection.products.size > 1 -%}
              <div class="flavors" {{ block.shopify_attributes }}>
                <span class="variant-option__label">
                  <span>{{ block.settings.label | default: 'products.product.flavor' | t }}</span>
                  <span class="muted">{{ current_name }}</span>
                </span>
                <div class="flavors__list">
                  {%- for item in flavor_collection.products -%}
                    {%- assign item_name = item.title | remove: strip_text | strip -%}
                    <a
                      class="flavor{% if item.id == product.id %} flavor--current{% endif %}{% unless item.available %} flavor--sold{% endunless %}"
                      href="{{ item.url }}"
                      {% if item.id == product.id %}aria-current="page"{% endif %}
                      title="{{ item_name | escape }}"
                    >
                      {%- if item.featured_media -%}
                        <img src="{{ item.featured_media | image_url: width: 140, height: 140, crop: 'center' }}" alt="" width="56" height="56" loading="lazy">
                      {%- else -%}
                        <span class="flavor__swatch" aria-hidden="true"></span>
                      {%- endif -%}
                      <span class="flavor__name">{{ item_name }}</span>
                    </a>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset style="border: 0; margin: 0; padding: 0;">
                    <legend class="variant-option__label" style="width: 100%;">
                      <span>{{ option.name }}</span>
                    </legend>

                    <div class="variant-option__values">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                        <input
                          class="variant-option__input"
                          type="radio"
                          id="{{ input_id }}"
                          name="{{ option.name }}-{{ section.id }}"
                          value="{{ value | escape }}"
                          data-option-index="{{ forloop.parentloop.index0 }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label class="variant-option__value" for="{{ input_id }}">{{ value }}</label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'quantity_selector' -%}
            <div {{ block.shopify_attributes }}>
              <span class="variant-option__label">{{ 'sections.cart.quantity' | t }}</span>
              <quantity-input class="quantity-input">
                <button type="button" data-action="decrease" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title }}">&minus;</button>
                <input
                  type="number"
                  name="quantity"
                  form="ProductForm-{{ section.id }}"
                  value="1"
                  min="1"
                  aria-label="{{ 'products.product.quantity.input_label' | t: product: product.title }}"
                >
                <button type="button" data-action="increase" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title }}">+</button>
              </quantity-input>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="product__buy" {{ block.shopify_attributes }}>
              <product-form
                data-section-id="{{ section.id }}"
                data-price-target="ProductPrice-{{ section.id }}"
                data-inventory-target="ProductInventory-{{ section.id }}"
                data-preorder="{{ is_preorder }}"
                data-low-stock="{{ block.settings.low_stock_threshold }}"
                data-show-stock="{{ block.settings.show_stock }}"
              >
                <script type="application/json" data-variants>
                  {{ product.variants | json }}
                </script>

                {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">

                  <button
                    type="submit"
                    name="add"
                    class="btn btn--large btn--full"
                    data-main-atc
                    {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
                  >
                    <span data-button-text>
                      {%- if current_variant.available -%}
                        {%- if is_preorder -%}
                          {{ 'products.product.preorder' | t }}
                        {%- else -%}
                          {{ 'products.product.add_to_cart' | t }}
                        {%- endif -%}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>

                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}
              </product-form>

              <p class="product__inventory" id="ProductInventory-{{ section.id }}" hidden></p>

              {%- if is_preorder -%}
                <p class="product__inventory">{{ 'products.product.preorder_note' | t }}</p>
              {%- endif -%}
            </div>

          {%- when 'trust' -%}
            <ul class="product__trust" {{ block.shopify_attributes }}>
              {%- if block.settings.item_1 != blank -%}
                <li>{% render 'icon', name: block.settings.icon_1 %}<span>{{ block.settings.item_1 }}</span></li>
              {%- endif -%}
              {%- if block.settings.item_2 != blank -%}
                <li>{% render 'icon', name: block.settings.icon_2 %}<span>{{ block.settings.item_2 }}</span></li>
              {%- endif -%}
              {%- if block.settings.item_3 != blank -%}
                <li>{% render 'icon', name: block.settings.icon_3 %}<span>{{ block.settings.item_3 }}</span></li>
              {%- endif -%}
            </ul>

          {%- when 'guarantee' -%}
            <div class="product__guarantee" {{ block.shopify_attributes }}>
              {% render 'icon', name: 'shield' %}
              <div>
                {%- if block.settings.heading != blank -%}
                  <strong>{{ block.settings.heading }}</strong>
                {%- endif -%}
                {{ block.settings.text }}
              </div>
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}

          {%- when 'accordion' -%}
            {%- liquid
              assign content = block.settings.content
              if block.settings.metafield != blank
                assign parts = block.settings.metafield | split: '.'
                assign namespace = parts[0]
                assign key = parts[1]
                assign meta_value = product.metafields[namespace][key]
                if meta_value != blank
                  assign content = meta_value
                endif
              endif
            -%}

            {%- if content != blank -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary>
                  {{ block.settings.heading }}
                  {% render 'icon', name: 'plus' %}
                </summary>
                <div class="accordion__content rte">{{ content }}</div>
              </details>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'share' -%}
            <a
              class="link-arrow"
              href="https://wa.me/?text={{ shop.url | append: product.url | url_encode }}"
              target="_blank"
              rel="noopener"
              aria-describedby="a11y-new-window-message"
              {{ block.shopify_attributes }}
            >
              {% render 'icon', name: 'whatsapp' %}
              {{ 'products.product.share' | t }}
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.enable_sticky_atc and product.available -%}
  <sticky-atc class="sticky-atc" data-target="[data-main-atc]" aria-hidden="true">
    <div class="sticky-atc__inner">
      {%- if product.featured_media -%}
        <img
          class="sticky-atc__image"
          src="{{ product.featured_media | image_url: width: 120, height: 120, crop: 'center' }}"
          alt=""
          width="48"
          height="48"
          loading="lazy"
        >
      {%- endif -%}
      <div class="sticky-atc__info">
        <span class="sticky-atc__title">{{ product.title | escape }}</span>
        <span class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</span>
      </div>
      <button type="button" class="btn" data-sticky-submit>
        {%- if is_preorder -%}
          {{ 'products.product.preorder' | t }}
        {%- else -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- endif -%}
      </button>
    </div>
  </sticky-atc>
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 400 | json }},
    "sku": {{ current_variant.sku | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
    {%- if product.featured_media -%}
      "image": {{ product.featured_media | image_url: width: 1200 | prepend: "https:" | json }},
    {%- endif -%}
    {%- if rating_value and rating_count -%}
      "aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ rating_value | json }}, "reviewCount": {{ rating_count | json }} },
    {%- endif -%}
    "url": {{ shop.url | append: product.url | json }},
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "sku": {{ variant.sku | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "url": {{ shop.url | append: product.url | append: '?variant=' | append: variant.id | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "main-product-section",
  "settings": [
    {
      "type": "select",
      "id": "media_layout",
      "label": "t:sections.main_product.settings.media_layout.label",
      "options": [
        { "value": "stacked", "label": "t:sections.main_product.settings.media_layout.options__1" },
        { "value": "thumbnails", "label": "t:sections.main_product.settings.media_layout.options__2" }
      ],
      "default": "thumbnails"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "t:sections.main_product.settings.enable_sticky_info.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_atc",
      "label": "t:sections.main_product.settings.enable_sticky_atc.label",
      "info": "t:sections.main_product.settings.enable_sticky_atc.info",
      "default": true
    }
  ],
  "blocks": [
    { "type": "badges", "name": "Badges", "limit": 1 },
    { "type": "title", "name": "t:sections.main_product.blocks.title.name", "limit": 1 },
    {
      "type": "rating",
      "name": "t:sections.main_product.blocks.rating.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "fallback_rating", "label": "t:sections.main_product.blocks.rating.settings.fallback_rating.label", "info": "t:sections.main_product.blocks.rating.settings.fallback_rating.info" },
        { "type": "text", "id": "fallback_count", "label": "t:sections.main_product.blocks.rating.settings.fallback_count.label" },
        { "type": "text", "id": "link", "label": "t:sections.main_product.blocks.rating.settings.link.label", "info": "t:sections.main_product.blocks.rating.settings.link.info", "default": "#reviews" }
      ]
    },
    {
      "type": "price",
      "name": "t:sections.main_product.blocks.price.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "note", "label": "t:sections.main_product.blocks.price.settings.note.label", "info": "t:sections.main_product.blocks.price.settings.note.info", "default": "+ $4 flat shipping · Free shipping on 3+ · Cash on delivery" }
      ]
    },
    {
      "type": "flavors",
      "name": "t:sections.main_product.blocks.flavors.name",
      "limit": 1,
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.main_product.blocks.flavors.settings.collection.label", "info": "t:sections.main_product.blocks.flavors.settings.collection.info" },
        { "type": "text", "id": "label", "label": "t:sections.main_product.blocks.flavors.settings.label.label", "default": "Flavor" },
        { "type": "text", "id": "strip_text", "label": "t:sections.main_product.blocks.flavors.settings.strip_text.label", "info": "t:sections.main_product.blocks.flavors.settings.strip_text.info", "default": "LipPlumper" }
      ]
    },
    {
      "type": "benefits",
      "name": "t:sections.main_product.blocks.benefits.name",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "text", "label": "t:sections.main_product.blocks.benefits.settings.text.label", "info": "t:sections.main_product.blocks.benefits.settings.text.info", "default": "Visibly fuller lips in about 60 seconds\nHydrating, high-shine gloss finish\nNo needles, no filler, no downtime" }
      ]
    },
    { "type": "variant_picker", "name": "t:sections.main_product.blocks.variant_picker.name", "limit": 1 },
    { "type": "quantity_selector", "name": "t:sections.main_product.blocks.quantity_selector.name", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "t:sections.main_product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.label", "default": true },
        { "type": "checkbox", "id": "show_stock", "label": "t:sections.main_product.blocks.buy_buttons.settings.show_stock.label", "default": true },
        { "type": "range", "id": "low_stock_threshold", "min": 1, "max": 50, "step": 1, "label": "t:sections.main_product.blocks.buy_buttons.settings.low_stock_threshold.label", "default": 10 }
      ]
    },
    {
      "type": "trust",
      "name": "t:sections.main_product.blocks.trust.name",
      "limit": 1,
      "settings": [
        { "type": "select", "id": "icon_1", "label": "t:sections.main_product.blocks.trust.settings.icon_1.label", "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "clock", "label": "Clock" },
            { "value": "cash", "label": "Cash" },
            { "value": "refresh", "label": "Returns" },
            { "value": "lock", "label": "Lock" },
            { "value": "shield", "label": "Shield" },
            { "value": "rabbit", "label": "Cruelty-free" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "lips", "label": "Lips" }
          ], "default": "truck" },
        { "type": "text", "id": "item_1", "label": "t:sections.main_product.blocks.trust.settings.item_1.label", "default": "$4 flat shipping" },
        { "type": "select", "id": "icon_2", "label": "t:sections.main_product.blocks.trust.settings.icon_2.label", "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "clock", "label": "Clock" },
            { "value": "cash", "label": "Cash" },
            { "value": "refresh", "label": "Returns" },
            { "value": "lock", "label": "Lock" },
            { "value": "shield", "label": "Shield" },
            { "value": "rabbit", "label": "Cruelty-free" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "lips", "label": "Lips" }
          ], "default": "clock" },
        { "type": "text", "id": "item_2", "label": "t:sections.main_product.blocks.trust.settings.item_2.label", "default": "Delivered in 1–3 days" },
        { "type": "select", "id": "icon_3", "label": "t:sections.main_product.blocks.trust.settings.icon_3.label", "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "clock", "label": "Clock" },
            { "value": "cash", "label": "Cash" },
            { "value": "refresh", "label": "Returns" },
            { "value": "lock", "label": "Lock" },
            { "value": "shield", "label": "Shield" },
            { "value": "rabbit", "label": "Cruelty-free" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "lips", "label": "Lips" }
          ], "default": "cash" },
        { "type": "text", "id": "item_3", "label": "t:sections.main_product.blocks.trust.settings.item_3.label", "default": "Cash on delivery" }
      ]
    },
    {
      "type": "guarantee",
      "name": "t:sections.main_product.blocks.guarantee.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.main_product.blocks.guarantee.settings.heading.label", "default": "Love it or your money back" },
        { "type": "text", "id": "text", "label": "t:sections.main_product.blocks.guarantee.settings.text.label", "default": "Not plumped? Message us on WhatsApp within 30 days for a refund or exchange." }
      ]
    },
    { "type": "description", "name": "t:sections.main_product.blocks.description.name", "limit": 1 },
    {
      "type": "accordion",
      "name": "t:sections.main_product.blocks.accordion.name",
      "settings": [
