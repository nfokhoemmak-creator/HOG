{{ 'section-offer-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme = section.settings.color_scheme | default: 'default'
  assign style = section.settings.style | default: 'brand'
  assign alignment = section.settings.text_alignment | default: 'left'
  assign image = section.settings.image
  assign overlay = section.settings.overlay_opacity | default: 60
  assign padding_mobile_top = section.settings.padding_top | times: 0.75 | round
  assign padding_mobile_bottom = section.settings.padding_bottom | times: 0.75 | round

  if style == 'image' and image == blank
    assign style = 'brand'
  endif

  assign button_class = 'btn btn--lg'
  if style == 'accent'
    assign button_class = 'btn btn--lg btn--secondary'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .offer-banner {
    padding-top: {{ padding_mobile_top }}px;
    padding-bottom: {{ padding_mobile_bottom }}px;
    --overlay: {{ overlay | divided_by: 100.0 }};
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .offer-banner {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="offer-banner section{% if scheme != 'default' %} section--{{ scheme }}{% endif %}{% if section.settings.full_width %} offer-banner--full{% endif %}">
  <div class="{% unless section.settings.full_width %}container{% endunless %}">
    <div class="offer-banner__band offer-banner__band--{{ style }} offer-banner__band--{{ alignment }}">
      {%- if style == 'image' -%}
        <div class="offer-banner__media" aria-hidden="true">
          <img
            src="{{ image | image_url: width: 1600 }}"
            srcset="{{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 1600 }} 1600w, {{ image | image_url: width: 2000 }} 2000w"
            sizes="(min-width: 1280px) 1280px, 100vw"
            alt=""
            width="{{ image.width }}"
            height="{{ image.height }}"
            loading="lazy"
          >
          <div class="offer-banner__scrim"></div>
        </div>
      {%- endif -%}

      <div class="offer-banner__content">
        {%- if section.settings.eyebrow != blank or section.settings.badge != blank -%}
          <div class="offer-banner__eyebrow-row">
            {%- if section.settings.badge != blank -%}
              <span class="badge sticker offer-banner__badge">{{ section.settings.badge | escape }}</span>
            {%- endif -%}
            {%- if section.settings.eyebrow != blank -%}
              <p class="eyebrow offer-banner__eyebrow">
                {% render 'icon', name: 'shark' %}
                <span>{{ section.settings.eyebrow | escape }}</span>
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="offer-banner__heading h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="offer-banner__text lead rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank or section.settings.link_label != blank -%}
          <div class="offer-banner__actions btn-row">
            {%- if section.settings.button_label != blank -%}
              <a class="{{ button_class }} offer-banner__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
            {%- endif -%}
            {%- if section.settings.link_label != blank -%}
              <a class="btn btn--ghost offer-banner__link" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">
                <span>{{ section.settings.link_label | escape }}</span>
                {% render 'icon', name: 'arrow-right' %}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Offer banner",
  "tag": "section",
  "class": "section-offer-banner",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "brand", "label": "Navy band" },
        { "value": "accent", "label": "Coral band" },
        { "value": "image", "label": "Image with navy scrim" }
      ],
      "default": "brand"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Used by the image style."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay strength (image style)",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Best gift"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Cozy Set"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Add the blanket, get 25% off it"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Any pair of slippers plus the wearable shark blanket. The discount is applied automatically in your cart.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Build the Cozy Set"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/pages/bundles"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Secondary link label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Secondary link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width band",
      "default": false,
      "info": "Off: rounded band inside the page width. On: edge to edge."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Section background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Soft aqua" },
        { "value": "brand", "label": "Navy" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Offer banner"
    }
  ]
}
{% endschema %}
