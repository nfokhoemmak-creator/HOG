{%- liquid
  assign target = collections[section.settings.collection]
  assign product_limit = section.settings.products_to_show

  assign fallback_title = 'onboarding.collection_title' | t
  assign heading = section.settings.title | default: target.title | default: fallback_title
-%}

<div class="section{% if section.settings.background == 'alt' %} section--alt{% endif %}">
  <div class="container">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="h2">{{ heading }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="lead" style="margin-top: var(--space-2);">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_view_all -%}
        <a class="link-arrow" href="{{ target.url | default: routes.all_products_collection_url }}">
          {{ 'sections.featured_collection.view_all' | t }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    <div
      class="product-grid"
      style="--cols-desktop: {{ section.settings.columns_desktop }}; --cols-mobile: {{ section.settings.columns_mobile }};"
    >
      {%- if target.products.size > 0 -%}
        {%- for product in target.products limit: product_limit -%}
          {%- liquid
            assign lazy = true
            if forloop.index <= 4
              assign lazy = false
            endif
          -%}
          {% render 'product-card', card_product: product, lazy_load: lazy %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..product_limit) -%}
          <div class="card">
            <div class="card__media card__media--{{ settings.card_image_ratio }}">
              {%- if forloop.first -%}
                <div class="card__badges"><span class="badge badge--accent">{{ 'products.product.bestseller' | t }}</span></div>
              {%- endif -%}
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'card__image' }}
            </div>
            <div class="card__info">
              <span class="card__title">{{ 'onboarding.product_title' | t }}</span>
              <span class="rating card__rating">{% render 'stars', rating: 5, size: 'small', uid: forloop.index %}<span>(128)</span></span>
              <div class="price"><span class="price__current">{{ 2900 | money }}</span></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "class": "featured-collection-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customer favorites"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.featured_collection.settings.title.label",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:sections.featured_collection.settings.subtitle.label",
      "default": "The products our customers reorder again and again."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "t:sections.featured_collection.settings.products_to_show.label",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:sections.featured_collection.settings.columns_desktop.label",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.featured_collection.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "t:sections.featured_collection.settings.columns_mobile.options__1" },
        { "value": "2", "label": "t:sections.featured_collection.settings.columns_mobile.options__2" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collection.settings.show_view_all.label",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Alternate" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name"
    }
  ]
}
{% endschema %}
