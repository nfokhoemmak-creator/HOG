<div class="container">
  <div class="page-head"><h1>{{ 'sections.collection_list.title' | t }}</h1></div>
  <div class="product-grid" style="--cols: 3; padding-bottom: var(--space-8);">
    {%- for collection in collections -%}
      <a class="product-card" href="{{ collection.url }}">
        <div class="product-card__media">
          {%- if collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.featured_image.alt | escape }}" width="800" height="800" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <span class="product-card__title">{{ collection.title | escape }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": []
}
{% endschema %}
