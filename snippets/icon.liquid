{%- comment -%}
  Renders an inline SVG icon.

  Accepts:
  - name: {String} one of the cases below (required)

  Usage:
  {% render 'icon', name: 'cart' %}
{%- endcomment -%}

{%- case name -%}
  {%- when 'cart' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M6 8h12l-1 12H7L6 8z"/>
      <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    </svg>

  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false">
      <circle cx="11" cy="11" r="6.5"/>
      <path d="m16 16 4.5 4.5"/>
    </svg>

  {%- when 'account' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="8.5" r="3.75"/>
      <path d="M4.5 20a7.5 7.5 0 0 1 15 0"/>
    </svg>

  {%- when 'menu' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="M3 6h18M3 12h18M3 18h18"/>
    </svg>

  {%- when 'close' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="m5 5 14 14M19 5 5 19"/>
    </svg>

  {%- when 'plus' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="M12 5v14M5 12h14"/>
    </svg>

  {%- when 'chevron-down' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="m6 9 6 6 6-6"/>
    </svg>

  {%- when 'arrow-right' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M4 12h16m-6-6 6 6-6 6"/>
    </svg>

  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    </svg>

  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/>
    </svg>

  {%- when 'star-half' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <defs><linearGradient id="half-{{ uid | default: 'g' }}"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="currentColor" stop-opacity="0.25"/></linearGradient></defs>
      <path fill="url(#half-{{ uid | default: 'g' }})" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/>
    </svg>

  {%- when 'star-empty' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" opacity="0.25" aria-hidden="true" focusable="false">
      <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/>
    </svg>

  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/>
      <circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    </svg>

  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"/>
      <path d="m9 12 2 2 4-4"/>
    </svg>

  {%- when 'refresh' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M20 12a8 8 0 0 1-14.5 4.6M4 12a8 8 0 0 1 14.5-4.6"/>
      <path d="M20 4v4h-4M4 20v-4h4"/>
    </svg>

  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/>
      <path d="M5 19c3-4 6-7 10-9"/>
    </svg>

  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
    </svg>

  {%- when 'sparkle' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M12 2l1.8 5.7L19.5 9.5l-5.7 1.8L12 17l-1.8-5.7L4.5 9.5l5.7-1.8z"/>
      <path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/>
    </svg>

  {%- when 'drop' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>
    </svg>

  {%- when 'lock' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="5" y="10" width="14" height="10" rx="2"/>
      <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
    </svg>

  {%- when 'gift' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="3" y="8" width="18" height="5"/><path d="M5 13v7h14v-7M12 8v12"/>
      <path d="M12 8c-2-4-6-4-6-1.5S10 8 12 8zm0 0c2-4 6-4 6-1.5S14 8 12 8z"/>
    </svg>

  {%- when 'rabbit' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M9 11c-2-6-1-9 1-9s2 4 2 7M12 9c0-3 0-7 2-7s3 3 1 9"/>
      <path d="M7 15a5 5 0 0 1 10 0c0 3-2 5-5 5s-5-2-5-5z"/>
      <circle cx="10.5" cy="15" r="0.6" fill="currentColor"/><circle cx="13.5" cy="15" r="0.6" fill="currentColor"/>
    </svg>

  {%- when 'face' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9"/>
      <path d="M8.5 14.5c1 1.3 2.2 2 3.5 2s2.5-.7 3.5-2"/>
      <circle cx="9" cy="10" r="0.7" fill="currentColor"/><circle cx="15" cy="10" r="0.7" fill="currentColor"/>
    </svg>

  {%- when 'chat' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M4 5h16v11H9l-5 4z"/>
    </svg>

  {%- when 'badge' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="9" r="6"/>
      <path d="m8.5 14-1.5 7 5-2.5 5 2.5-1.5-7"/>
    </svg>

  {%- when 'clock' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="8.5"/>
      <path d="M12 7.5V12l3 2"/>
    </svg>

  {%- when 'cash' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="3" y="6.5" width="18" height="11" rx="2"/>
      <circle cx="12" cy="12" r="2.6"/>
      <path d="M6.5 9.5h.01M17.5 14.5h.01"/>
    </svg>

  {%- when 'lips' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3 12c3-4 5.5-5 7.5-3.2L12 10l1.5-1.2C15.5 7 18 8 21 12c-3 4-6 6-9 6s-6-2-9-6z"/>
      <path d="M3 12h18"/>
    </svg>

  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/>
      <circle cx="12" cy="12" r="3.75"/>
      <circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/>
    </svg>

  {%- when 'tiktok' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M16.5 3h-2.6v11.4a2.6 2.6 0 1 1-2.2-2.57V9.2a5.2 5.2 0 1 0 4.8 5.19V8.6a6.2 6.2 0 0 0 3.5 1.1V7.1a3.6 3.6 0 0 1-3.5-3.6z"/>
    </svg>

  {%- when 'whatsapp' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M12 2a10 10 0 0 0-8.6 15.05L2 22l5.1-1.33A10 10 0 1 0 12 2zm0 2a8 8 0 1 1-4.2 14.8l-.3-.18-3 .78.8-2.92-.2-.31A8 8 0 0 1 12 4zm-3.4 4.3c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1s.9 2.44 1.03 2.6c.13.17 1.75 2.79 4.32 3.8 2.14.84 2.58.67 3.04.63.46-.04 1.5-.61 1.71-1.2.21-.59.21-1.1.15-1.2-.06-.1-.23-.17-.48-.29-.25-.13-1.5-.74-1.73-.82-.23-.09-.4-.13-.57.12-.17.25-.65.82-.8.99-.14.16-.29.19-.54.06-.25-.12-1.07-.39-2.04-1.25-.75-.67-1.26-1.5-1.4-1.75-.15-.25-.02-.38.1-.51.11-.11.25-.29.38-.44.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.37-.77-1.87-.2-.49-.4-.42-.56-.43z"/>
    </svg>

  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M14 8.5V6.8c0-.7.2-1.1 1.2-1.1H17V3h-2.6c-2.6 0-3.6 1.4-3.6 3.6v1.9H9V11h1.8v10H14V11h2.5l.4-2.5H14z"/>
    </svg>

  {%- else -%}
{%- endcase -%}
