{%- comment -%}
  The cart drawer. cart-drawer.js re-fetches this section by id after every
  Ajax cart mutation and swaps the markup in, so everything the drawer shows
  must be rendered here — nothing is templated client-side.
{%- endcomment -%}

<cart-drawer class="cart-drawer" aria-hidden="true">
  <div class="cart-drawer__overlay" tabindex="-1"></div>

  <div
    class="cart-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'sections.cart.title' | t }}"
  >
    <div class="cart-drawer__head">
      <h2 class="h4">{{ 'sections.cart.title' | t }}</h2>
      <button type="button" class="header__icon" data-cart-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    <div class="cart-drawer__body">
      <p class="form__error" data-cart-error hidden></p>

      {%- if cart.item_count == 0 -%}
        <div class="empty-state">
          <p class="h4">{{ 'sections.cart.empty' | t }}</p>
          <p class="muted">{{ 'sections.cart.empty_body' | t }}</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">
            {{ 'sections.cart.browse_catalog' | t }}
          </a>
        </div>
      {%- else -%}
        <ul class="cart-items">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a class="cart-item__image" href="{{ item.url }}">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 200 }}"
                    alt="{{ item.image.alt | escape }}"
                    width="100"
                    height="133"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>

              <div class="cart-item__details">
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>

                {%- unless item.product.has_only_default_variant -%}
                  <span class="cart-item__variant">{{ item.variant.title }}</span>
                {%- endunless -%}

                {%- if item.selling_plan_allocation -%}
                  <span class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</span>
                {%- endif -%}

                {%- for property in item.properties -%}
                  {%- if property.last != blank -%}
                    <span class="cart-item__variant">{{ property.first }}: {{ property.last }}</span>
                  {%- endif -%}
                {%- endfor -%}

                <div class="cart-item__actions">
                  <quantity-input class="quantity-input">
                    <button
                      type="button"
                      data-action="decrease"
                      aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title }}"
                    >
                      &minus;
                    </button>
                    <input
                      type="number"
                      value="{{ item.quantity }}"
                      min="0"
                      data-line-quantity="{{ item.key }}"
                      aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title }}"
                    >
                    <button
                      type="button"
                      data-action="increase"
                      aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title }}"
                    >
                      +
                    </button>
                  </quantity-input>

                  <span class="price">{{ item.final_line_price | money }}</span>
                </div>

                <button type="button" class="cart-item__remove" data-line-remove="{{ item.key }}">
                  {{ 'sections.cart.remove' | t }}
                </button>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if settings.cart_show_note -%}
          <details class="accordion" style="margin-top: var(--space-5);">
            <summary>
              {{ 'sections.cart.note' | t }}
              {% render 'icon', name: 'plus' %}
            </summary>
            <div class="accordion__content">
              <label class="visually-hidden" for="CartDrawerNote">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartDrawerNote"
                name="note"
                form="cart-drawer-form"
                placeholder="{{ 'sections.cart.note_placeholder' | t }}"
              >{{ cart.note }}</textarea>
            </div>
          </details>
        {%- endif -%}

        {%- liquid
          # Cross-sell strip: merchant-picked collection first, otherwise the
          # collection the most recent cart item lives in. Products already
          # in the cart (and sold-out ones) are skipped.
          assign upsell_source = blank
          if section.settings.show_upsells
            assign upsell_source = section.settings.upsell_collection
            if upsell_source == blank or upsell_source.products.size == 0
              assign upsell_source = cart.items.first.product.collections.first
            endif
          endif

          assign cart_product_ids = ','
          for item in cart.items
            assign cart_product_ids = cart_product_ids | append: item.product_id | append: ','
          endfor

          assign upsell_matches = 0
          if upsell_source != blank
            for candidate in upsell_source.products limit: 12
              assign probe = ',' | append: candidate.id | append: ','
              if candidate.available and cart_product_ids contains probe
                continue
              elsif candidate.available
                assign upsell_matches = upsell_matches | plus: 1
              endif
            endfor
          endif
        -%}

        {%- if upsell_matches > 0 -%}
          <div class="cart-upsell">
            <p class="eyebrow">{{ section.settings.upsell_heading }}</p>

            <div class="cart-upsell__list">
              {%- liquid
                assign upsell_shown = 0
              -%}
              {%- for candidate in upsell_source.products limit: 12 -%}
                {%- liquid
                  if upsell_shown >= section.settings.upsell_count
                    break
                  endif
                  assign probe = ',' | append: candidate.id | append: ','
                  if candidate.available == false or cart_product_ids contains probe
                    continue
                  endif
                  assign upsell_shown = upsell_shown | plus: 1
                -%}

                <div class="cart-upsell__card">
                  <a class="cart-upsell__media" href="{{ candidate.url }}" tabindex="-1" aria-hidden="true">
                    {%- if candidate.featured_media -%}
                      <img
                        src="{{ candidate.featured_media | image_url: width: 400 }}"
                        alt="{{ candidate.featured_media.alt | escape }}"
                        width="{{ candidate.featured_media.width }}"
                        height="{{ candidate.featured_media.height }}"
                        loading="lazy"
                      >
                    {%- endif -%}
                  </a>

                  <a class="cart-upsell__title" href="{{ candidate.url }}">{{ candidate.title | escape }}</a>

                  {% render 'price', product: candidate %}

                  {%- if candidate.variants.size == 1 -%}
                    <form method="post" action="{{ routes.cart_add_url }}" data-quick-add-form>
                      <input type="hidden" name="form_type" value="product">
                      <input type="hidden" name="utf8" value="✓">
                      <input type="hidden" name="id" value="{{ candidate.variants.first.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button
                        type="submit"
                        class="btn btn--small btn--full"
                        aria-label="{{ 'products.product.quick_add_for' | t: product: candidate.title }}"
                      >
                        {{ 'products.product.quick_add' | t }}
                      </button>
                    </form>
                  {%- elsif candidate.options.size == 1 and candidate.variants.size <= 8 -%}
                    <div class="cart-upsell__sizes" role="group" aria-label="{{ 'products.product.quick_add_for' | t: product: candidate.title }}">
                      {%- for variant in candidate.variants -%}
                        {%- if variant.available -%}
                          <form method="post" action="{{ routes.cart_add_url }}" data-quick-add-form>
                            <input type="hidden" name="form_type" value="product">
                            <input type="hidden" name="utf8" value="✓">
                            <input type="hidden" name="id" value="{{ variant.id }}">
                            <input type="hidden" name="quantity" value="1">
                            <button
                              type="submit"
                              class="card__size"
                              data-quick-add-quiet
                              aria-label="{{ 'products.product.quick_add_size' | t: product: candidate.title, size: variant.title }}"
                            >
                              {{ variant.title }}
                            </button>
                          </form>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <a class="btn btn--small btn--outline btn--full" href="{{ candidate.url }}">
                      {{ 'products.product.choose_options' | t }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__foot">
        <div class="cart-totals">
          <span>{{ 'sections.cart.subtotal' | t }}</span>
          <span>
            {%- if settings.currency_code_enabled -%}
              {{ cart.total_price | money_with_currency }}
            {%- else -%}
              {{ cart.total_price | money }}
            {%- endif -%}
          </span>
        </div>

        {%- if cart.cart_level_discount_applications.size > 0 -%}
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-totals accent">
              <span>{{ discount.title }}</span>
              <span>-{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
        {%- endif -%}

        <p class="cart-notice">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>

        <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form">
          <button type="submit" name="checkout" class="btn btn--accent btn--full">
            {{ 'sections.cart.checkout' | t }}
          </button>
        </form>

        <a class="cart-notice underline" href="{{ routes.cart_url }}">{{ 'sections.cart.view_cart' | t }}</a>

        {%- if settings.cart_notice != blank -%}
          <div class="cart-notice">{{ settings.cart_notice }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_upsells",
      "label": "Show cross-sell products",
      "info": "Suggests products the visitor doesn't have in the cart yet, with one-tap add.",
      "default": true
    },
    {
      "type": "text",
      "id": "upsell_heading",
      "label": "Cross-sell heading",
      "default": "Complete the look"
    },
    {
      "type": "collection",
      "id": "upsell_collection",
      "label": "Cross-sell collection",
      "info": "Leave empty to suggest products from the same collection as the items in the cart."
    },
    {
      "type": "range",
      "id": "upsell_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to suggest",
      "default": 4
    }
  ]
}
{% endschema %}
