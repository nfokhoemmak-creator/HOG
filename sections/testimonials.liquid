{{ 'section-testimonials.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme = section.settings.color_scheme | default: 'default'
  assign padding_mobile_top = section.settings.padding_top | times: 0.75 | round
  assign padding_mobile_bottom = section.settings.padding_bottom | times: 0.75 | round

  assign rating_value = settings.store_rating
  assign rating_count = settings.store_review_count
  if section.settings.rating_value != blank
    assign rating_value = section.settings.rating_value
  endif
  if section.settings.rating_count != blank
    assign rating_count = section.settings.rating_count
  endif

  assign testimonial_count = 0
  for block in section.blocks
    if block.type == 'testimonial'
      assign testimonial_count = testimonial_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .testimonials {
    padding-top: {{ padding_mobile_top }}px;
    padding-bottom: {{ padding_mobile_bottom }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .testimonials {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | escape }}"{% endif %}
  class="testimonials section{% if scheme != 'default' %} section--{{ scheme }}{% endif %}"
>
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.text != blank or section.settings.show_summary -%}
      <header class="section__header section__header--center testimonials__header">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="section__title h2">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="section__subtitle">{{ section.settings.text | escape }}</p>
          {%- endif -%}
          {%- if section.settings.show_summary and rating_value != blank -%}
            <div class="testimonials__summary">
              {% render 'rating', value: rating_value, count: rating_count, size: 'md' %}
            </div>
          {%- endif -%}
        </div>
      </header>
    {%- endif -%}

    {%- if testimonial_count > 0 -%}
      <ul class="testimonials__grid grid{% if testimonial_count >= 3 %} grid--3{% elsif testimonial_count == 2 %} grid--2{% endif %}" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' -%}
            {%- liquid
              assign stars = block.settings.stars | default: 5
              assign author = block.settings.author
              assign product_label = block.settings.product
            -%}
            <li class="card testimonials__card reveal" {{ block.shopify_attributes }}>
              <figure class="testimonials__figure card__body">
                {%- if stars > 0 -%}
                  <div class="testimonials__stars">
                    {% render 'rating', value: stars, show_count: false, size: 'sm' %}
                  </div>
                {%- endif -%}
                {%- if block.settings.quote != blank -%}
                  <blockquote class="testimonials__quote rte">{{ block.settings.quote }}</blockquote>
                {%- endif -%}
                <figcaption class="testimonials__meta">
                  {%- if block.settings.image != blank -%}
                    <img
                      class="testimonials__avatar"
                      src="{{ block.settings.image | image_url: width: 96 }}"
                      srcset="{{ block.settings.image | image_url: width: 96 }} 1x, {{ block.settings.image | image_url: width: 192 }} 2x"
                      alt="{{ block.settings.image.alt | default: author | escape }}"
                      width="48"
                      height="48"
                      loading="lazy"
                    >
                  {%- else -%}
                    <span class="testimonials__avatar testimonials__avatar--initial" aria-hidden="true">{{ author | slice: 0, 1 | default: '★' }}</span>
                  {%- endif -%}
                  <span class="testimonials__who">
                    {%- if author != blank -%}
                      <span class="testimonials__author">{{ author | escape }}</span>
                    {%- endif -%}
                    {%- if product_label != blank -%}
                      <span class="testimonials__product small muted">{{ product_label | escape }}</span>
                    {%- endif -%}
                  </span>
                </figcaption>
              </figure>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="testimonials__app" {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hear it from the shark fans"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor id",
      "info": "Optional. Product pages set this to \"reviews\" so the rating count can link here."
    },
    {
      "type": "header",
      "content": "Rating summary"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show store rating summary",
      "default": true,
      "info": "Uses the store rating from Theme settings > Offers unless overridden below."
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Rating override",
      "info": "Leave blank to use the theme setting."
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Review count override",
      "info": "Leave blank to use the theme setting."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Soft aqua" },
        { "value": "brand", "label": "Navy" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>Cozy, warm, and hilariously fun – my feet stay toasty and I smile every time I wear them.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Shark fan"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product bought",
          "default": "Winter slippers"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo (optional)"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Cozy, warm, and hilariously fun – the SharkBite Winter Slippers keep my feet toasty while making me smile every time I wear them! 🦈❄️</p>",
            "author": "Rahaf L.",
            "product": "Winter slippers",
            "stars": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Light, comfy, and breathable – the SharkBite Summer Slippers are perfect for sunny days with a splash of fun!</p>",
            "author": "Wael K.",
            "product": "Originals slides",
            "stars": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Amazing customer support and super fast shipping – my SharkBite Slippers arrived in no time, and the team was so helpful!</p>",
            "author": "Ghida L.",
            "product": "Shark slippers",
            "stars": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
