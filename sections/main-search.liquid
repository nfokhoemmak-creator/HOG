{%- liquid
  assign scheme_class = ''
  if section.settings.color_scheme != blank and section.settings.color_scheme != 'default'
    assign scheme_class = ' section--' | append: section.settings.color_scheme
  endif
  assign padding_mobile_top = section.settings.padding_top | times: 0.75 | round
  assign padding_mobile_bottom = section.settings.padding_bottom | times: 0.75 | round
  assign columns = section.settings.columns_desktop
  assign card_sizes = '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  if columns == 3
    assign card_sizes = '(min-width: 750px) 33vw, 50vw'
  elsif columns == 2
    assign card_sizes = '(min-width: 750px) 50vw, 50vw'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .search-page {
    padding-top: {{ padding_mobile_top }}px;
    padding-bottom: {{ padding_mobile_bottom }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .search-page {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="search-page section{{ scheme_class }}">
  <div class="container">
    <header class="page-header">
      {%- if search.performed -%}
        <h1 class="h1">{{ 'general.search.results_for' | t: terms: search.terms | escape }}</h1>
        <p class="muted" role="status">
          {%- if search.results_count == 1 -%}
            {{ 'general.search.results_count.one' | t: count: search.results_count }}
          {%- else -%}
            {{ 'general.search.results_count.other' | t: count: search.results_count }}
          {%- endif -%}
        </p>
      {%- else -%}
        <h1 class="h1">{{ 'general.search.title' | t }}</h1>
        {%- if section.settings.text != blank -%}
          <p class="lead muted">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      {%- endif -%}

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <div class="field">
          <label class="visually-hidden" for="Search-{{ section.id }}">{{ 'general.search.placeholder' | t }}</label>
          <span class="search-form__icon">{% render 'icon', name: 'search' %}</span>
          <input
            class="field__input"
            type="search"
            id="Search-{{ section.id }}"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.placeholder' | t }}"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
          >
          <input type="hidden" name="options[prefix]" value="last">
        </div>
        <button type="submit" class="btn btn--secondary">{{ 'general.search.submit' | t }}</button>
      </form>
    </header>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="empty-state">
          {% render 'icon', name: 'shark' %}
          <h2 class="empty-state__title h3">{{ 'general.search.no_results' | t: terms: search.terms | escape }}</h2>
          <div class="btn-row">
            <a class="btn" href="{{ section.settings.empty_button_link }}">{{ section.settings.empty_button_label | escape }}</a>
            <a class="btn btn--ghost" href="{{ section.settings.empty_link_2 }}">
              {{ section.settings.empty_link_label_2 | escape }}
              {% render 'icon', name: 'arrow-right' %}
            </a>
          </div>
        </div>
      {%- else -%}
        {%- paginate search.results by section.settings.results_per_page -%}
          {%- liquid
            assign product_count = 0
            assign article_count = 0
            assign page_count = 0
            for item in search.results
              if item.object_type == 'product'
                assign product_count = product_count | plus: 1
              elsif item.object_type == 'article'
                assign article_count = article_count | plus: 1
              elsif item.object_type == 'page'
                assign page_count = page_count | plus: 1
              endif
            endfor
          -%}

          <div class="search-results">
            {%- if product_count > 0 -%}
              <section class="search-results__group" aria-labelledby="SearchProducts-{{ section.id }}">
                <h2 class="h4" id="SearchProducts-{{ section.id }}">{{ 'general.search.products' | t }}</h2>
                <ul class="product-grid product-grid--{{ columns }}" role="list">
                  {%- for item in search.results -%}
                    {%- if item.object_type == 'product' -%}
                      {%- liquid
                        assign lazy = true
                        if forloop.index <= columns
                          assign lazy = false
                        endif
                      -%}
                      <li>{% render 'product-card', card_product: item, lazy_load: lazy, sizes: card_sizes %}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </section>
            {%- endif -%}

            {%- if article_count > 0 -%}
              <section class="search-results__group" aria-labelledby="SearchArticles-{{ section.id }}">
                <h2 class="h4" id="SearchArticles-{{ section.id }}">{{ 'general.search.articles' | t }}</h2>
                <ul class="result-list" role="list">
                  {%- for item in search.results -%}
                    {%- if item.object_type == 'article' -%}
                      <li>
                        <a href="{{ item.url }}">
                          <span class="h5">{{ item.title | escape }}</span>
                          {%- if item.excerpt_or_content != blank -%}
                            <span class="muted small" style="display: block; margin-top: 0.4rem;">
                              {{ item.excerpt_or_content | strip_html | truncatewords: 30 }}
                            </span>
                          {%- endif -%}
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </section>
            {%- endif -%}

            {%- if page_count > 0 -%}
              <section class="search-results__group" aria-labelledby="SearchPages-{{ section.id }}">
                <h2 class="h4" id="SearchPages-{{ section.id }}">{{ 'general.search.pages' | t }}</h2>
                <ul class="result-list" role="list">
                  {%- for item in search.results -%}
                    {%- if item.object_type == 'page' -%}
                      <li>
                        <a href="{{ item.url }}">
                          <span class="h5">{{ item.title | escape }}</span>
                          {%- if item.content != blank -%}
                            <span class="muted small" style="display: block; margin-top: 0.4rem;">
                              {{ item.content | strip_html | truncatewords: 30 }}
                            </span>
                          {%- endif -%}
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </section>
            {%- endif -%}
          </div>

          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "class": "section-main-search",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Intro text",
      "info": "Shown before a search is made.",
      "default": "Looking for a size, a colour or the blanket? Type it in."
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Product columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "No results"
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Button label",
      "default": "Shop slippers"
    },
    {
      "type": "url",
      "id": "empty_button_link",
      "label": "Button link",
      "default": "/collections/shark-slippers"
    },
    {
      "type": "text",
      "id": "empty_link_label_2",
      "label": "Secondary link label",
      "default": "Ask us on WhatsApp"
    },
    {
      "type": "url",
      "id": "empty_link_2",
      "label": "Secondary link",
      "default": "/pages/contact"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Soft aqua" },
        { "value": "brand", "label": "Navy" }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "enabled_on": {
    "templates": ["search"]
  }
}
{% endschema %}
