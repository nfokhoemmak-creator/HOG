{%- assign newsletter_fallback = 'general.newsletter_form.heading' | t -%}

<div class="section section--tight">
  <div class="container container--medium">
    <div class="newsletter">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pill">{% render 'icon', name: 'gift' %}{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h2 class="h2">{{ section.settings.heading | default: newsletter_fallback }}</h2>

      {%- if section.settings.text != blank -%}
        <div class="lead">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter-form newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="Newsletter-{{ section.id }}">
          {{ 'general.newsletter_form.email_placeholder' | t }}
        </label>
        <input
          id="Newsletter-{{ section.id }}"
          class="field__input"
          type="email"
          name="contact[email]"
          placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
          autocomplete="email"
          required
        >
        <button type="submit" class="btn">{{ 'general.newsletter_form.submit' | t }}</button>

        {%- if form.errors -%}
          <p class="form__error" style="width: 100%;">
            {{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}
          </p>
        {%- elsif form.posted_successfully? -%}
          <p class="form__success" style="width: 100%;">{{ 'general.newsletter_form.confirmation' | t }}</p>
        {%- endif -%}
      {%- endform -%}

      <p class="newsletter__fine">{{ 'general.newsletter_form.fine_print' | t }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.newsletter.settings.eyebrow.label",
      "default": "Welcome gift"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "Get 10% off your first order"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.newsletter.settings.text.label",
      "default": "<p>Join the Jamalati list for launches, skincare tips and subscriber-only offers.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.name"
    }
  ]
}
{% endschema %}
