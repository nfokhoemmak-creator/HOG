{%- comment -%}
  The cart drawer. cart-drawer.js re-fetches this section by id after every
  Ajax cart mutation and swaps the markup in, so everything the drawer shows
  must be rendered here — nothing is templated client-side.
{%- endcomment -%}

{%- liquid
  assign fp = settings.featured_product
  assign upsell_variant = blank
  assign upsell_line = blank
  if settings.cart_show_upsell and fp != blank and fp.variants.size > 1
    for item in cart.items
      if item.product.id == fp.id and item.variant.id == fp.variants.first.id and item.quantity == 1
        assign upsell_line = item
        assign upsell_variant = fp.variants[1]
        break
      endif
    endfor
  endif
  assign upsell_saving = 0
  if upsell_variant != blank and upsell_variant.compare_at_price > upsell_variant.price
    assign upsell_saving = upsell_variant.compare_at_price | minus: upsell_variant.price
  endif
  assign upsell_saving_money = upsell_saving | money
  assign upsell_price_money = upsell_variant.price | money
-%}

<cart-drawer class="cart-drawer" aria-hidden="true">
  <div class="cart-drawer__overlay" tabindex="-1"></div>

  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'sections.cart.title' | t }}">
    <div class="cart-drawer__head">
      <h2 class="h4">{{ 'sections.cart.title' | t }}{% if cart.item_count > 0 %} <span class="muted">({{ cart.item_count }})</span>{% endif %}</h2>
      <button type="button" class="header__icon" data-cart-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    <div class="cart-drawer__body">
      <p class="form__error" data-cart-error hidden></p>

      {%- if cart.item_count == 0 -%}
        <div class="empty-state">
          {% render 'icon', name: 'paw' %}
          <p class="h4">{{ 'sections.cart.empty' | t }}</p>
          <p class="muted">{{ 'sections.cart.empty_body' | t }}</p>
          <a class="btn" href="{% if fp != blank %}{{ fp.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
            {{ 'sections.cart.shop_now' | t }}
          </a>
        </div>
      {%- else -%}
        <ul class="cart-items">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a class="cart-item__image" href="{{ item.url }}">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="84" height="84" loading="lazy">
                {%- endif -%}
              </a>

              <div class="cart-item__details">
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>

                {%- unless item.product.has_only_default_variant -%}
                  <span class="cart-item__variant">{{ item.variant.title }}</span>
                {%- endunless -%}

                {%- if item.selling_plan_allocation -%}
                  <span class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</span>
                {%- endif -%}

                {%- for discount in item.line_level_discount_allocations -%}
                  <span class="cart-item__variant text-green">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</span>
                {%- endfor -%}

                <div class="cart-item__actions">
                  <quantity-input class="quantity-input">
                    <button type="button" data-action="decrease" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title }}">&minus;</button>
                    <input
                      type="number"
                      value="{{ item.quantity }}"
                      min="0"
                      data-line-quantity="{{ item.key }}"
                      aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title }}"
                    >
                    <button type="button" data-action="increase" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title }}">+</button>
                  </quantity-input>

                  <span class="price">
                    {%- if item.original_line_price > item.final_line_price -%}
                      <s class="muted small">{{ item.original_line_price | money }}</s>
                    {%- endif -%}
                    {{ item.final_line_price | money }}
                  </span>
                </div>

                <button type="button" class="cart-item__remove" data-line-remove="{{ item.key }}">
                  {{ 'sections.cart.remove' | t }}
                </button>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if upsell_variant != blank and upsell_variant.available -%}
          <div class="cart-upsell">
            {% render 'icon', name: 'gift' %}
            <div>
              <strong>
                {%- if upsell_saving > 0 -%}
                  {{ 'sections.cart.upsell_heading_saving' | t: bundle: upsell_variant.title, amount: upsell_saving_money }}
                {%- else -%}
                  {{ 'sections.cart.upsell_heading' | t: bundle: upsell_variant.title }}
                {%- endif -%}
              </strong>
              <button type="button" data-upsell-swap="{{ upsell_line.key }}" data-upsell-variant="{{ upsell_variant.id }}">
                {{ 'sections.cart.upsell_cta' | t: price: upsell_price_money }} &rarr;
              </button>
            </div>
          </div>
        {%- endif -%}

        {%- if settings.cart_show_note -%}
          <details class="accordion" style="margin-top: var(--space-5);">
            <summary>
              {{ 'sections.cart.note' | t }}
              <span class="accordion__icon">{% render 'icon', name: 'plus' %}</span>
            </summary>
            <div class="accordion__content">
              <label class="visually-hidden" for="CartDrawerNote">{{ 'sections.cart.note' | t }}</label>
              <textarea id="CartDrawerNote" class="field__input" name="note" form="cart-drawer-form" placeholder="{{ 'sections.cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
            </div>
          </details>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__foot">
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-totals accent">
            <span>{{ discount.title }}</span>
            <span>-{{ discount.total_allocated_amount | money }}</span>
          </div>
        {%- endfor -%}

        <div class="cart-totals">
          <span>{{ 'sections.cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>

        <p class="cart-notice">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>

        <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form">
          <button type="submit" name="checkout" class="btn btn--full btn--lg">
            {% render 'icon', name: 'lock' %}
            {{ 'sections.cart.checkout' | t }}
          </button>
        </form>

        <div class="cart-drawer__trust">
          <span>{% render 'icon', name: 'shield-check' %} {{ settings.guarantee_days }}-{{ 'general.day' | t }} {{ 'general.guarantee' | t }}</span>
          <span>{% render 'icon', name: 'lock' %} {{ 'sections.cart.secure' | t }}</span>
        </div>

        {%- if settings.cart_notice != blank -%}
          <div class="cart-notice">{{ settings.cart_notice }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
