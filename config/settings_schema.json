[
  {
    "name": "theme_info",
    "theme_name": "Shark Bite",
    "theme_version": "2.0.0",
    "theme_author": "Shark Bite",
    "theme_documentation_url": "https://sharkbitelb.store",
    "theme_support_url": "https://sharkbitelb.store/pages/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 320,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 150
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Scaled down to 32 x 32px."
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social sharing image",
        "info": "Shown when a link to the store is shared. 1200 x 630px works best."
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Tagline",
        "default": "Jaw-droppingly cozy."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Surfaces"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#FBF8F2"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Cards and drawers",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_surface_alt",
        "label": "Alternate section background",
        "default": "#DDEFF1"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Hairlines and dividers",
        "default": "#E3DED3"
      },
      {
        "type": "header",
        "content": "Text"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#0E1B2E"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Secondary text",
        "default": "#5B6675"
      },
      {
        "type": "header",
        "content": "Brand"
      },
      {
        "type": "color",
        "id": "color_brand",
        "label": "Brand (navy)",
        "info": "Footer, announcement bar and secondary buttons.",
        "default": "#0B3B6F"
      },
      {
        "type": "color",
        "id": "color_brand_contrast",
        "label": "Text on brand",
        "default": "#FBF8F2"
      },
      {
        "type": "header",
        "content": "Primary button"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Primary button (coral)",
        "info": "Used only for the main call-to-action button.",
        "default": "#FF6A3D"
      },
      {
        "type": "color",
        "id": "color_accent_contrast",
        "label": "Text on primary button",
        "default": "#0E1B2E"
      },
      {
        "type": "header",
        "content": "Status"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Success",
        "info": "Free-shipping unlocked, in stock.",
        "default": "#177A4C"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale badge",
        "default": "#BF3A24"
      },
      {
        "type": "color",
        "id": "color_star",
        "label": "Rating stars",
        "default": "#E8A700"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "outfit_n7"
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading size",
        "default": 100
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "nunito_sans_n4"
      },
      {
        "type": "range",
        "id": "type_body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Body size",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "layout_max_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1280
      },
      {
        "type": "range",
        "id": "layout_gutter",
        "min": 16,
        "max": 48,
        "step": 4,
        "unit": "px",
        "label": "Side gutter (desktop)",
        "default": 32
      },
      {
        "type": "range",
        "id": "layout_corner_radius",
        "min": 0,
        "max": 28,
        "step": 2,
        "unit": "px",
        "label": "Corner radius",
        "info": "0 makes cards, buttons and badges square.",
        "default": 16
      },
      {
        "type": "range",
        "id": "grid_gap",
        "min": 8,
        "max": 32,
        "step": 4,
        "unit": "px",
        "label": "Grid gap",
        "default": 16
      },
      {
        "type": "checkbox",
        "id": "animations_enabled",
        "label": "Enable reveal animations",
        "info": "Always off for visitors who prefer reduced motion.",
        "default": true
      }
    ]
  },
  {
    "name": "Offers",
    "settings": [
      {
        "type": "header",
        "content": "Free standard shipping"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free standard shipping threshold",
        "info": "Must match the automatic Free shipping discount in Discounts. 0 disables the bar.",
        "default": 30
      },
      {
        "type": "text",
        "id": "free_shipping_text",
        "label": "Free standard shipping message",
        "info": "[amount] is replaced with the threshold.",
        "default": "Free standard shipping over [amount] across Lebanon"
      },
      {
        "type": "header",
        "content": "Bundle discounts"
      },
      {
        "type": "range",
        "id": "bundle_tier_min",
        "min": 2,
        "max": 5,
        "step": 1,
        "label": "Pairs needed for the tier discount",
        "info": "Must match the automatic 'Slipper pairs' discount minimum quantity.",
        "default": 2
      },
      {
        "type": "range",
        "id": "bundle_tier_percent",
        "min": 0,
        "max": 50,
        "step": 5,
        "unit": "%",
        "label": "Tier discount on slippers",
        "info": "Must match the automatic 'Slipper pairs' discount. 0 hides the offer.",
        "default": 20
      },
      {
        "type": "range",
        "id": "set_discount_percent",
        "min": 0,
        "max": 50,
        "step": 5,
        "unit": "%",
        "label": "Blanket discount with slippers",
        "info": "Must match the automatic 'Blanket with slippers' discount. 0 hides the offer.",
        "default": 25
      },
      {
        "type": "checkbox",
        "id": "show_offer_badges",
        "label": "Show offer badges",
        "default": true
      },
      {
        "type": "header",
        "content": "Social proof"
      },
      {
        "type": "text",
        "id": "store_rating",
        "label": "Store-wide rating",
        "info": "Shown in the hero, announcement bar, marquee and testimonials.",
        "default": "4.9"
      },
      {
        "type": "text",
        "id": "store_review_count",
        "label": "Store-wide review count",
        "default": "26"
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "min": 0,
        "max": 10,
        "step": 1,
        "label": "Low stock threshold",
        "info": "0 disables 'Only N left'",
        "default": 3
      },
      {
        "type": "checkbox",
        "id": "structured_data_rating",
        "label": "Add rating to product structured data",
        "info": "Fera already emits Product JSON-LD with aggregateRating — enable only if that app embed is removed",
        "default": false
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "options": [
          { "value": "square", "label": "Square" },
          { "value": "portrait", "label": "Portrait" },
          { "value": "natural", "label": "Natural" }
        ],
        "default": "square"
      },
      {
        "type": "checkbox",
        "id": "card_hover_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show rating",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_badges",
        "label": "Show badges",
        "info": "Tags 'bestseller' and 'new' become badges. Sale and sold out are automatic.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Enable quick add",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "currency_code_enabled",
        "label": "Show currency code",
        "info": "Shows 'USD' after prices.",
        "default": false
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Enable order note",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "cart_show_upsells",
        "label": "Show bundle suggestions in cart",
        "default": true
      },
      {
        "type": "richtext",
        "id": "cart_notice",
        "label": "Cart notice",
        "default": "<p>Delivery across Lebanon: standard courier 3–5 days ($3, free over $30) or express 1–2 days ($6). Orders are prepared within 3–5 business days.</p>"
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/yourshop"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "info": "https://tiktok.com/@yourshop"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "info": "https://facebook.com/yourshop"
      },
      {
        "type": "text",
        "id": "social_whatsapp_number",
        "label": "WhatsApp number",
        "info": "International format, digits only (e.g. 96171801588). Powers the chat button and support links.",
        "default": "96171801588"
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "Enable predictive search",
        "default": true
      }
    ]
  }
]
