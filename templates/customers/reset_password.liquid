<section class="section">
  <div class="container container--narrow">
    <div class="auth-card">
      <h1 class="h2">{{ 'customer.reset_password.title' | t }}</h1>
      <p class="auth-card__intro">{{ 'customer.reset_password.subtext' | t }}</p>

      {%- form 'reset_customer_password', class: 'form' -%}
        {%- if form.errors -%}
          <div class="form__error" role="alert">
            {% render 'icon', name: 'info' %}
            <div>{{ form.errors | default_errors }}</div>
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
          <input class="field__input" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
        </div>

        <div class="field">
          <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
          <input class="field__input" type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>

        <button type="submit" class="btn btn--full">{{ 'customer.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>
