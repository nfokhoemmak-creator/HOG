text":"<p>Secure Shopify checkout</p>","max_width":"none","type_preset":"custom","font":"var(--font-subheading--family)","font_size":"0.875rem","letter_spacing":"loose","case":"uppercase","wrap":"nowrap","text_color":"#14343A"}},"i6":{"type":"icon","settings":{"icon":"star","width":12,"link":"","icon_color":"#14343A"}}},"block_order":["t0","i0","t1","i1","t2","i2","t3","i3","t4","i4","t5","i5","t6","i6"],"name":"Facts","settings":{"background_color":"#E58C74","padding-block-start":14,"padding-block-end":14,"gap_between_elements":40}},"story":{"type":"section","blocks":{"image":{"type":"image","settings":{"image":"shopify://shop_images/mareluce-hero-juliette-poster.png","link":"shopify://products/swinging-collar-dress","image_ratio":"portrait","border_radius":4}},"copy":{"type":"group","settings":{"gap":14,"toggle_overlay":false},"blocks":{"eyebrow":{"type":"text","settings":{"text":"<p>Our story</p>","width":"100%","type_preset":"h6","wrap":"pretty"}},"heading":{"type":"text","settings":{"text":"<h2>We started with the hour, not the dress.</h2>","width":"100%","max_width":"narrow","type_preset":"h2","wrap":"pretty"}},"p1":{"type":"text","settings":{"text":"<p>Mareluce began with a question we kept asking each other: what do you wear into that last hour of light, when the day is done and the evening has not decided what it is yet? Most of what we found either cost more than the evening or looked cheaper than it. We wanted the narrow middle: pieces that look the part at a price that does not need an occasion.</p>","width":"100%","max_width":"narrow","type_preset":"paragraph","wrap":"pretty"}},"p2":{"type":"text","settings":{"text":"<p>Every style is chosen from partner suppliers with that hour in mind: the fall of a satin slip, the way a cowl neck settles, the weight of a wool-blend knit when the evening turns cool. We keep the styles that run from XS to 3XL where the maker offers them, and we list the size run on every product page.</p>","width":"100%","max_width":"narrow","type_preset":"paragraph","wrap":"pretty"}},"p3":{"type":"text","settings":{"text":"<p>Mareluce is the new name for Jamálati. Same pieces, priced in USD as before, and the same inbox answering your messages. We are based in the UAE, we curate rather than make, and we would rather tell you where an order ships from than let you find out later.</p>","width":"100%","max_width":"narrow","type_preset":"paragraph","wrap":"pretty"}},"sign":{"type":"text","settings":{"text":"<p>The Mareluce team</p>","width":"100%","type_preset":"h6","wrap":"pretty","text_color":"#5C6F73"}},"cta":{"type":"button","settings":{"label":"Read our story","link":"/pages/our-story","style_class":"button-secondary"}}},"block_order":["eyebrow","heading","p1","p2","p3","sign","cta"]}},"block_order":["image","copy"],"name":"Our story","settings":{"content_direction":"row","horizontal_alignment":"space-between","gap":56,"background_color":"#F7F6F2","toggle_overlay":false,"padding-block-start":72,"padding-block-end":72}},"looks":{"type":"collection-list","blocks":{"header":{"type":"group","settings":{"gap":8,"toggle_overlay":false},"blocks":{"eyebrow":{"type":"text","settings":{"text":"<p>Looks</p>","width":"100%","type_preset":"h6","wrap":"pretty"}},"heading":{"type":"text","settings":{"text":"<h2>Three ways to wear the evening.</h2>","width":"100%","max_width":"narrow","type_preset":"h2","wrap":"pretty"}},"body":{"type":"text","settings":{"text":"<p>Full prices, added up on each look page. Pick your sizes there.</p>","width":"100%","max_width":"narrow","type_preset":"paragraph","wrap":"pretty"}}},"block_order":["eyebrow","heading","body"]},"static-collection-card":{"type":"_collection-card","static":true,"settings":{"placement":"below_image","vertical_alignment":"flex-end","collection_card_gap":10},"blocks":{"collection-card-image":{"type":"_collection-card-image","static":true,"settings":{"toggle_overlay":false}},"collection-title":{"type":"collection-title","settings":{"type_preset":"h4","font":"var(--font-heading--family)","font_size":"","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","width":"fit-content","max_width":"normal","alignment":"left","background":false,"background_color":"#ffffff","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0}}},"block_order":["collection-title"]}},"block_order":["header"],"name":"Looks","settings":{"collection_list":["the-golden-hour-look","satin-and-boots","the-knit-set"],"columns":3,"mobile_columns":"1","columns_gap":16,"rows_gap":24,"gap":28,"background_color":"#F7F6F2","padding-block-start":48,"padding-block-end":72}},"trust":{"type":"section","blocks":{"t1":{"type":"group","settings":{"gap":14,"toggle_overlay":false},"blocks":{"icon":{"type":"icon","settings":{"icon":"lock","width":28,"link":"","icon_color":"#E58C74"}},"txt":{"type":"group","settings":{"gap":6,"toggle_overlay":false},"blocks":{"h":{"type":"text","settings":{"text":"<h3>Secure Shopify checkout</h3>","width":"100%","type_preset":"h4","wrap":"pretty"}},"p":{"type":"text","settings":{"text":"<p>Payment is handled by Shopify's checkout. We never see your card details.</p>","width":"100%","type_preset":"paragraph","wrap":"pretty","text_color":"#5C6F73"}}},"block_order":["h","p"]}},"block_order":["icon","txt"]},"t2":{"type":"group","settings":{"gap":14,"toggle_overlay":false},"blocks":{"icon":{"type":"icon","settings":{"icon":"truck","width":28,"link":"","icon_color":"#E58C74"}},"txt":{"type":"group","settings":{"gap":6,"toggle_overlay":false},"blocks":{"h":{"type":"text","settings":{"text":"<h3>Ships to 41 countries</h3>","width":"100%","type_preset":"h4","wrap":"pretty"}},"p":{"type":"text","settings":{"text":"<p>Your shipping rate and delivery window are shown at checkout, before you pay. Orders are fulfilled from partner supplier warehouses.</p>","width":"100%","type_preset":"paragraph","wrap":"pretty","text_color":"#5C6F73"}}},"block_order":["h","p"]}},"block_order":["icon","txt"]},"t3":{"type":"group","settings":{"gap":14,"toggle_overlay":false},"blocks":{"icon":{"type":"icon","settings":{"icon":"ruler","width":28,"link":"","icon_color":"#E58C74"}},"txt":{"type":"group","settings":{"gap":6,"toggle_overlay":false},"blocks":{"h":{"type":"text","settings":{"text":"<h3>The size run, on every page</h3>","width":"100%","type_preset":"h4","wrap":"pretty"}},"p":{"type":"text","settings":{"text":"<p>Each style lists its own run, from XS to 3XL depending on the piece.</p>","width":"100%","type_preset":"paragraph","wrap":"pretty","text_color":"#5C6F73"}}},"block_order":["h","p"]}},"block_order":["icon","txt"]},"t4":{"type":"group","settings":{"gap":14,"toggle_overlay":false},"blocks":{"icon":{"type":"icon","settings":{"icon":"chat_bubble","width":28,"link":"","icon_color":"#E58C74"}},"txt":{"type":"group","settings":{"gap":6,"toggle_overlay":false},"blocks":{"h":{"type":"text","settings":{"text":"<h3>A person answers</h3>","width":"100%","type_preset":"h4","wrap":"pretty"}},"p":{"type":"text","settings":{"text":"<p>Not sure between two sizes? <a href=\"/pages/contact\">Email us</a> before you order and we will tell you what we would pick.</p>","width":"100%","type_preset":"paragraph","wrap":"pretty","text_color":"#5C6F73"}}},"block_order":["h","p"]}},"block_order":["icon","txt"]}},"block_order":["t1","t2","t3","t4"],"name":"What you can count on","settings":{"content_direction":"row","vertical_alignment":"flex-start","gap":32,"background_color":"#F7F6F2","toggle_overlay":false,"border":"solid","padding-block-start":56,"padding-block-end":56,"border_color":"#E1E0DA"}},"faq":{"type":"section","blocks":{"head":{"type":"group","settings":{"gap":8,"width":"custom","custom_width":40,"toggle_overlay":false},"blocks":{"eyebrow":{"type":"text","settings":{"text":"<p>Questions</p>","width":"100%","type_preset":"h6","wrap":"pretty"}},"heading":{"type":"text","settings":{"text":"<h2>Questions to ask before you order.</h2>","width":"100%","max_width":"narrow","type_preset":"h2","wrap":"pretty"}},"body":{"type":"text","settings":{"text":"<p>Straight answers on sizing, delivery, returns and fabric. Anything else, <a href=\"/pages/contact\">email us</a>.</p>","width":"100%","max_width":"narrow","type_preset":"paragraph","wrap":"pretty"}}},"block_order":["eyebrow","heading","body"]},"accordion":{"type":"accordion","settings":{"icon":"plus","divider_color":"#E1E0DA","type_preset":"h4"},"blocks":{"row0":{"type":"_accordion-row","settings":{"heading":"How do I choose my size?","open_by_default":true},"blocks":{"text":{"type":"text","settings":{"text":"<p>Each style has its own size run, listed on its product page, from XS to 3XL depending on the piece. Measure a dress or top you already own and like the fit of, then compare it with the measurements on the product page. If a page is missing a measurement you need, email us before you order and we will check with the supplier.</p>","width":"100%","type_preset":"paragraph","wrap":"pretty","text_color":"#5C6F73"}}},"block_order":["text"]},"row1":{"type":"_accordion-row","settings":{"heading":"How long will delivery take, and what will it cost?"},"blocks":{"text":{"type":"text","settings":{"text":"<p>The shipping cost and the delivery window for your country are shown at checkout before you pay. Orders are fulfilled from partner supplier warehouses, which means international transit, so allow for that when you are ordering for a date.</p>","width":"100%","type_preset":"paragraph","wrap":"pretty","text_color":"#5C6F73"}}},"block_order":["text"]},"row2":{"type":"_accordion-row","settings":{"heading":"Can I return something that does not fit?"},"blocks":{"text":{"type":"text","settings":{"text":"<p>Email us before you send anything back. We will confirm whether the item can be returned, where to send it and who pays the postage, so nothing goes to the wrong place.</p>","width":"100%","type_preset":"paragraph","wrap":"pretty","text_color":"#5C6F73"}}},"block_order":["text"]},"row3":{"type":"_accordion-row","settings":{"heading":"What are the pieces made of?"},"blocks":{"text":{"type":"text","settings":{"text":"<p>The Amalfi is a satin slip, the Savona is all-over lace, the Verona and the Colette are lace-trimmed, the Costa is a knit, the Nova is a cable knit and the Como is a wool-blend knit. Fabric and care details are listed on the product page where the maker supplies them. A few styles in the catalogue are shown with digital renders rather than photographs and are marked as such on their own pages.</p>","width":"100%","type_preset":"paragraph","wrap":"pretty","text_color":"#5C6F73"}}},"block_order":["text"]},"row4":{"type":"_accordion-row","settings":{"heading":"I am between two sizes. Which one?"},"blocks":{"text":{"type":"text","settings":{"text":"<p>Go by the measurement that matters most for the style. Woven satin and lace have less give than knit, so for a slip, a corset or a bodycon dress take the larger size if your bust or hip sits between two columns. Knits and the two-piece sets forgive more, so the smaller size usually works. Still unsure? Send us your bust, waist and hip measurements and the style name and we will tell you what we would pick.</p>","width":"100%","type_preset":"paragraph","wrap":"pretty","text_color":"#5C6F73"}}},"block_order":["text"]}},"block_order":["row0","row1","row2","row3","row4"]}},"block_order":["head","accordion"],"name":"FAQ","settings":{"content_direction":"row","vertical_alignment":"flex-start","gap":48,"background_color":"#F7F6F2","toggle_overlay":false,"padding-block-start":72,"padding-block-end":72}},"newsletter":{"type":"section","blocks":{"heading":{"type":"text","settings":{"text":"<h2>First to know when a style lands.</h2>","width":"100%","max_width":"narrow","alignment":"center","type_preset":"h2","wrap":"pretty"}},"body":{"type":"text","settings":{"text":"<p>One email when a new style lands. No daily sends. Unsubscribe from any email in one tap.</p>","width":"100%","max_width":"narrow","alignment":"center","type_preset":"paragraph","wrap":"pretty"}},"signup":{"type":"email-signup","settings":{"width":"custom","custom_width":50,"heading":"","input_style":"custom","border_radius":2,"input_background_color":"#F7F6F2","input_text_color":"#14343A","input_border_color":"#14343A","style_class":"button-custom","custom_button_background":"#14343A","custom_button_text":"#F7F6F2","custom_button_border":"#14343A","label":"Sign me up","integrated_button":true}}},"block_order":["heading","body","signup"],"name":"Newsletter","settings":{"vertical_alignment":"flex-start","horizontal_alignment_flex_direction_column":"center","gap":16,"background_color":"#F7D9CC","toggle_overlay":false,"padding-block-start":72,"padding-block-end":72}}},"order":["hero","new-in","collections","film","facts","story","looks","trust","faq","newsletter"]}