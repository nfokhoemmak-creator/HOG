{{ 'section-main-password.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = settings.brand_tagline
  endif

  assign whatsapp_number = settings.social_whatsapp_number | replace: ' ', '' | replace: '+', '' | replace: '-', ''
  assign logo_width = settings.logo_width | default: 150
  assign logo_height = logo_width
  if settings.logo != blank and settings.logo.aspect_ratio > 0
    assign logo_height = logo_width | divided_by: settings.logo.aspect_ratio | round
  endif
  assign logo_width_2x = logo_width | times: 2
-%}

<div class="password__inner password-page">
  {%- if settings.logo != blank -%}
    <div class="password__logo">
      <img
        src="{{ settings.logo | image_url: width: logo_width_2x }}"
        srcset="{{ settings.logo | image_url: width: logo_width }} 1x, {{ settings.logo | image_url: width: logo_width_2x }} 2x"
        alt="{{ shop.name | escape }}"
        width="{{ logo_width }}"
        height="{{ logo_height }}"
        loading="eager"
        style="width: {{ logo_width }}px;"
      >
    </div>
    <h1 class="visually-hidden">{{ shop.name }}</h1>
  {%- else -%}
    <h1 class="password__heading h2">{{ shop.name }}</h1>
  {%- endif -%}

  <p class="eyebrow password-page__eyebrow">
    {% render 'icon', name: 'shark' %}
    {{ 'sections.password.opening_soon' | t }}
  </p>

  {%- if heading != blank -%}
    <p class="password__heading h2">{{ heading | escape }}</p>
  {%- endif -%}

  {%- if section.settings.text != blank -%}
    <div class="rte lead muted password-page__text">{{ section.settings.text }}</div>
  {%- endif -%}

  {%- if section.settings.show_newsletter -%}
    {%- form 'customer', id: 'PasswordNewsletter', class: 'password-page__newsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
      {%- if form.posted_successfully? -%}
        <div class="form__success" role="status" tabindex="-1" autofocus>
          {% render 'icon', name: 'check' %}
          <p>{{ 'sections.newsletter.success' | t }}</p>
        </div>
      {%- else -%}
        {%- if form.errors -%}
          <div class="form__error" role="alert" tabindex="-1" autofocus>
            {% render 'icon', name: 'info' %}
            <p>{{ 'sections.newsletter.error' | t }}</p>
          </div>
        {%- endif -%}
        <div class="password-page__newsletter-row">
          <div class="field">
            <label class="visually-hidden" for="PasswordNewsletter-email">{{ 'sections.newsletter.email' | t }}</label>
            <input
              class="field__input"
              type="email"
              id="PasswordNewsletter-email"
              name="contact[email]"
              placeholder="{{ 'sections.newsletter.email' | t }}"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              required
            >
          </div>
          <button type="submit" class="btn">{{ 'sections.newsletter.submit' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  {%- endif -%}

  {%- if section.settings.show_whatsapp and whatsapp_number != blank -%}
    <p class="password-page__whatsapp">
      <a class="btn btn--ghost btn--sm" href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener">
        {% render 'icon', name: 'whatsapp' %}
        {{ 'general.whatsapp_cta' | t }}
        <span class="visually-hidden">({{ 'general.new_window' | t }})</span>
      </a>
    </p>
  {%- endif -%}

  {%- if section.settings.show_social -%}
    <div class="password-page__social">
      {% render 'social-links' %}
    </div>
  {%- endif -%}

  {%- form 'storefront_password', class: 'password-page__login-form' -%}
    <details class="password-page__login"{% if form.errors %} open{% endif %}>
      <summary class="password-page__login-summary">
        {% render 'icon', name: 'lock' %}
        {{ 'sections.password.login_password' | t }}
      </summary>

      <div class="password__form form">
        <div class="field">
          <label class="field__label" for="StorePassword">{{ 'sections.password.login_form_password_label' | t }}</label>
          <input
            class="field__input"
            type="password"
            id="StorePassword"
            name="password"
            placeholder="{{ 'sections.password.login_form_password_placeholder' | t }}"
            autocomplete="current-password"
            {% if form.errors %}aria-invalid="true" aria-describedby="StorePassword-error"{% endif %}
          >
        </div>

        {%- if form.errors -%}
          <div class="form__error" id="StorePassword-error" role="alert">
            {% render 'icon', name: 'info' %}
            <p>{{ 'sections.password.login_form_error' | t }}</p>
          </div>
        {%- endif -%}

        <button type="submit" class="btn btn--secondary btn--full">{{ 'sections.password.login_form_submit' | t }}</button>
      </div>
    </details>
  {%- endform -%}

  <p class="password__footer">
    {{ 'sections.password.admin_link_html' | t }}
    <br>
    {%- capture shopify_link -%}
      <a href="https://www.shopify.com" rel="nofollow" target="_blank" class="underline">Shopify<span class="visually-hidden"> ({{ 'general.new_window' | t }})</span></a>
    {%- endcapture -%}
    {{ 'sections.password.powered_by_shopify_html' | t: shopify: shopify_link }}
  </p>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the brand tagline from theme settings.",
      "default": "Something cozy is coming."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Plush shark slippers and the famous shark blanket, delivered across Lebanon. Leave your email and we'll tell you the moment the doors open.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show email sign-up",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true
    }
  ],
  "enabled_on": {
    "templates": ["password"]
  }
}
{% endschema %}
