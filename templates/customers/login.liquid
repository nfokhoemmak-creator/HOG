<div class="container container--narrow account">
  <div class="account__form">
    <h1 class="h2" style="margin-bottom: var(--space-5);">{{ 'customer.login_page.title' | t }}</h1>

    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <p class="form__error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
        <input class="field__input" type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
      </div>

      {%- if form.password_needed -%}
        <div class="field">
          <label class="field__label" for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
          <input class="field__input" type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password">
        </div>

        <a class="underline muted" href="#recover" style="font-size: 1.3rem;">
          {{ 'customer.login_page.forgot_password' | t }}
        </a>
      {%- endif -%}

      <button type="submit" class="btn btn--full" style="margin-top: var(--space-4);">
        {{ 'customer.login_page.sign_in' | t }}
      </button>
    {%- endform -%}

    <p class="muted" style="margin-top: var(--space-5);">
      <a class="underline" href="{{ routes.account_register_url }}">
        {{ 'customer.login_page.create_account' | t }}
      </a>
    </p>

    <div id="recover" style="margin-top: var(--space-7); padding-top: var(--space-5); border-top: 1px solid var(--color-border);">
      <h2 class="h4" style="margin-bottom: var(--space-3);">{{ 'customer.recover_password.title' | t }}</h2>
      <p class="muted" style="margin-bottom: var(--space-4);">{{ 'customer.recover_password.subtext' | t }}</p>

      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}
          <p class="form__success">{{ 'customer.recover_password.success' | t }}</p>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
          <input class="field__input" type="email" id="RecoverEmail" name="email" autocomplete="email" required>
        </div>

        <button type="submit" class="btn btn--outline">{{ 'customer.recover_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>
