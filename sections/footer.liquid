<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              <ul class="footer__menu">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>

            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              {%- else -%}
                {%- if settings.logo != blank -%}
                  <img class="footer__logo" src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="{{ settings.logo.width }}" height="{{ settings.logo.height }}" loading="lazy">
                {%- else -%}
                  <img class="footer__logo" src="{{ 'jamalati-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1462" height="399" loading="lazy">
                {%- endif -%}
              {%- endif -%}
              <div class="footer__menu">{{ block.settings.text }}</div>
              {%- if section.settings.show_social -%}
                <div style="margin-top: var(--space-4);">
                  {% render 'social-links' %}
                </div>
              {%- endif -%}

            {%- when 'contact' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              <ul class="footer__menu">
                {%- if block.settings.email != blank -%}
                  <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  <li><a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a></li>
                {%- endif -%}
                {%- if block.settings.address != blank -%}
                  <li>{{ block.settings.address }}</li>
                {%- endif -%}
              </ul>
          {%- endcase -%}
        </div>
      {%- endfor -%}

      {%- if section.settings.show_newsletter -%}
        <div>
          {%- assign newsletter_fallback = 'general.newsletter_form.heading' | t -%}
          <h2 class="footer__heading">
            {{ section.settings.newsletter_heading | default: newsletter_fallback }}
          </h2>

          {%- form 'customer', class: 'newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="FooterNewsletter">
              {{ 'general.newsletter_form.email_placeholder' | t }}
            </label>
            <input
              id="FooterNewsletter"
              class="field__input"
              type="email"
              name="contact[email]"
              placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="btn">{{ 'general.newsletter_form.submit' | t }}</button>

            {%- if form.errors -%}
              <p class="form__error">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
            {%- elsif form.posted_successfully? -%}
              <p class="form__success">{{ 'general.newsletter_form.confirmation' | t }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ settings.brand_tagline }}</span>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="payment-list">
          {%- for type in shop.enabled_payment_types -%}
            <li>
              <span class="visually-hidden">{{ type }}</span>
              {{ type | payment_type_svg_tag: class: 'payment-icon' }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "div",
  "class": "footer-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.footer.settings.show_newsletter.label",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:sections.footer.settings.newsletter_heading.label",
      "default": "Get 10% off your first order"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.footer.settings.show_social.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.settings.show_payment_icons.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.menu.settings.heading.label",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.menu.settings.menu.label",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.text.settings.heading.label",
          "info": "Leave empty to show the logo instead."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.text.settings.text.label",
          "default": "<p>Clean, effective beauty made to be loved every day.</p>"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Address"
        }
      ]
    }
  ]
}
{% endschema %}
