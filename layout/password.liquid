<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {%- liquid
      assign body_font = settings.type_body_font
      assign heading_font = settings.type_heading_font
    -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {{ heading_font | font_face: font_display: 'swap' }}

    <style>
      :root {
        --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-weight: {{ heading_font.weight }};
        --font-heading-tracking: {{ settings.type_heading_tracking }}px;
        --font-body-scale: {{ settings.type_body_scale | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.type_heading_scale | divided_by: 100.0 }};
        --color-bg: {{ settings.color_background }};
        --color-bg-alt: {{ settings.color_background_alt }};
        --color-fg: {{ settings.color_text }};
        --color-muted: {{ settings.color_text_muted }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-contrast: {{ settings.color_accent_contrast }};
        --color-border: {{ settings.color_border }};
        --color-btn-bg: {{ settings.color_button_background }};
        --color-btn-fg: {{ settings.color_button_text }};
        --container: {{ settings.layout_max_width }}px;
        --gutter: {{ settings.layout_gutter }}px;
        --radius: {{ settings.layout_corner_radius }}px;
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body class="template-password">
    <main id="MainContent" class="password-layout" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
