{%- comment -%}
  Renders a 5-star rating with partial fills. This is the ONLY place the
  Fera review metafields are read (reviews.rating is a rating-type metafield
  whose .value is an object, reviews.rating_count is a number).

  Accepts:
  - product:    {Object} product — reads product.metafields.reviews.* (preferred)
  - value:      {Number|String} rating 0–5 (used when no product is given)
  - count:      {Number|String} review count (used when no product is given)
  - size:       {String} 'sm' (default) | 'md' | 'lg'
  - show_count: {Boolean} default true
  - count_url:  {String} optional href; when set the count becomes a link (e.g. '#reviews')
  - class:      {String} extra classes on the wrapper

  Renders nothing when no rating value is available.

  Usage:
  {% render 'rating', product: product, size: 'sm' %}
  {% render 'rating', value: settings.store_rating, count: settings.store_review_count %}
{%- endcomment -%}

{%- liquid
  assign rating_value = blank
  assign rating_max = 5.0
  assign rating_count = 0

  if product
    assign mf = product.metafields.reviews.rating.value
    if mf.rating != blank
      assign rating_value = mf.rating | times: 1.0
    elsif mf.value != blank
      assign rating_value = mf.value | times: 1.0
    endif
    if mf.scale_max != blank
      assign rating_max = mf.scale_max | times: 1.0
    endif
    assign rating_count = product.metafields.reviews.rating_count.value | default: 0 | times: 1
  else
    if value != blank
      assign rating_value = value | times: 1.0
    endif
    if count != blank
      assign rating_count = count | times: 1
    endif
  endif

  if rating_max <= 0
    assign rating_max = 5.0
  endif

  if show_count == false
    assign display_count = false
  else
    assign display_count = true
  endif

  assign size_class = size | default: 'sm'
-%}

{%- if rating_value != blank -%}
  {%- liquid
    assign normalized = rating_value | times: 5.0 | divided_by: rating_max
    if normalized > 5
      assign normalized = 5.0
    endif
    if normalized < 0
      assign normalized = 0.0
    endif
    assign display_value = normalized | round: 1
    if rating_count > 0
      assign label = 'accessibility.rating_label' | t: value: display_value, count: rating_count
    else
      assign label = 'accessibility.rating_label_no_count' | t: value: display_value
    endif
  -%}
  {%- liquid
    if rating_count == 1
      assign count_label = 'products.product.review_one' | t
    else
      assign count_label = 'products.product.reviews' | t: count: rating_count
    endif
  -%}
  <div class="rating rating--{{ size_class }}{% if class != blank %} {{ class }}{% endif %}">
    <span class="rating__stars" role="img" aria-label="{{ label | escape }}">
      {%- for i in (1..5) -%}
        {%- liquid
          assign lower = i | minus: 1
          if normalized >= i
            assign pct = 100
          elsif normalized > lower
            assign pct = normalized | minus: lower | times: 100 | round
          else
            assign pct = 0
          endif
          assign grad_id = 'sb-star-fill-' | append: pct
        -%}
        <svg class="rating__star" viewBox="0 0 24 24" width="16" height="16" focusable="false">
          {%- if pct > 0 and pct < 100 -%}
            <defs>
              <linearGradient id="{{ grad_id }}" x1="0" x2="1" y1="0" y2="0">
                <stop offset="{{ pct }}%" style="stop-color: var(--color-star)"/>
                <stop offset="{{ pct }}%" style="stop-color: transparent"/>
              </linearGradient>
            </defs>
            <path fill="url(#{{ grad_id }})" d="M12 2.8l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.7l-5.9 3.1 1.2-6.5L2.5 9.7l6.6-.9z"/>
          {%- elsif pct >= 100 -%}
            <path fill="var(--color-star)" d="M12 2.8l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.7l-5.9 3.1 1.2-6.5L2.5 9.7l6.6-.9z"/>
          {%- else -%}
            <path fill="transparent" d="M12 2.8l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.7l-5.9 3.1 1.2-6.5L2.5 9.7l6.6-.9z"/>
          {%- endif -%}
        </svg>
      {%- endfor -%}
    </span>
    <span class="rating__text">
      <span aria-hidden="true">{{ display_value }}</span>
      {%- if display_count and rating_count > 0 -%}
        {%- if count_url != blank -%}
          <a class="rating__count" href="{{ count_url }}" aria-label="{{ count_label | escape }}"> ({{ rating_count }})</a>
        {%- else -%}
          <span class="rating__count" aria-hidden="true"> ({{ rating_count }})</span>
        {%- endif -%}
      {%- endif -%}
    </span>
  </div>
{%- endif -%}
