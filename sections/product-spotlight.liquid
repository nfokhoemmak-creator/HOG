{{ 'section-product-spotlight.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign product = s.product
  if product == blank
    assign product = collections['shark-slippers'].products[0]
  endif

  case s.color_scheme
    when 'alt'
      assign scheme_class = ' section--alt'
    when 'brand'
      assign scheme_class = ' section--brand'
    else
      assign scheme_class = ''
  endcase

  assign pt = s.padding_top
  assign pb = s.padding_bottom
  assign pt_mobile = pt | times: 0.75 | round
  assign pb_mobile = pb | times: 0.75 | round
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .spotlight {
    padding-top: {{ pt_mobile }}px;
    padding-bottom: {{ pb_mobile }}px;
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .spotlight {
      padding-top: {{ pt }}px;
      padding-bottom: {{ pb }}px;
    }
  }
{%- endstyle -%}

{%- if product != blank -%}
  {%- liquid
    assign form_id = 'spotlight-form-' | append: section.id
    assign price_id = 'spotlight-price-' | append: section.id
    assign current_variant = product.selected_or_first_available_variant

    assign collection_handles = product.collections | map: 'handle'
    assign in_slippers = false
    if collection_handles contains 'shark-slippers'
      assign in_slippers = true
    endif
    assign show_bundle_hint = false
    if in_slippers and settings.bundle_tier_percent > 0 and s.show_bundle_hint
      assign show_bundle_hint = true
    endif

    assign compare_at = current_variant.compare_at_price | default: 0
    assign on_sale = false
    assign saving_text = ''
    if compare_at > current_variant.price
      assign on_sale = true
      assign saving = compare_at | minus: current_variant.price
      assign saving_remainder = saving | modulo: 100
      if saving_remainder == 0
        assign saving_money = saving | money_without_trailing_zeros
      else
        assign saving_money = saving | money
      endif
      assign saving_text = 'products.product.save_amount' | t: amount: saving_money
    endif

    if settings.currency_code_enabled
      assign price_money = current_variant.price | money_with_currency
      assign compare_money = compare_at | money_with_currency
    else
      assign price_money = current_variant.price | money
      assign compare_money = compare_at | money
    endif

    assign heading = s.heading | default: product.title
    assign free_ship_amount = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros

    assign media_items = product.media | slice: 0, 4
    assign media_count = media_items.size
    assign active_media_id = current_variant.featured_media.id | default: product.featured_media.id
    assign reviews_url = product.url | append: '#reviews'
  -%}

  <div class="section spotlight{{ scheme_class }}">
    <div class="container">
      <div class="spotlight__inner">
        {%- comment -%} Gallery (first 4 media, swipeable, thumbs) {%- endcomment -%}
        <spotlight-gallery class="spotlight__gallery" data-gallery>
          {%- if media_count > 0 -%}
            <div class="spotlight__viewer" data-gallery-viewer role="region" aria-label="{{ 'accessibility.carousel' | t }}" tabindex="0">
              {%- for media in media_items -%}
                {%- liquid
                  assign img = media.preview_image
                  assign is_active = false
                  if media.id == active_media_id
                    assign is_active = true
                  endif
                  assign img_loading = 'lazy'
                  if forloop.first
                    assign img_loading = 'eager'
                  endif
                -%}
                <div class="spotlight__slide{% if is_active %} is-active{% endif %}" data-media-id="{{ media.id }}">
                  <img
                    class="spotlight__image"
                    src="{{ img | image_url: width: 1000 }}"
                    srcset="
                      {{ img | image_url: width: 400 }} 400w,
                      {{ img | image_url: width: 600 }} 600w,
                      {{ img | image_url: width: 800 }} 800w,
                      {{ img | image_url: width: 1000 }} 1000w,
                      {{ img | image_url: width: 1400 }} 1400w
                    "
                    sizes="(min-width: 990px) 55vw, 100vw"
                    alt="{{ img.alt | default: product.title | escape }}"
                    width="{{ img.width }}"
                    height="{{ img.height }}"
                    loading="{{ img_loading }}"
                  >
                  {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                    <a class="spotlight__slide-play" href="{{ product.url }}" aria-label="{{ 'products.product.media.play_video' | t }}">
                      {% render 'icon', name: 'play' %}
                    </a>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>

            {%- if media_count > 1 -%}
              <div class="spotlight__thumbs" role="list">
                {%- for media in media_items -%}
                  {%- liquid
                    assign img = media.preview_image
                    assign is_active = false
                    if media.id == active_media_id
                      assign is_active = true
                    endif
                  -%}
                  <button
                    type="button"
                    class="spotlight__thumb{% if is_active %} is-active{% endif %}"
                    data-thumb="{{ media.id }}"
                    aria-current="{% if is_active %}true{% else %}false{% endif %}"
                    aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
                  >
                    <img
                      src="{{ img | image_url: width: 160 }}"
                      srcset="{{ img | image_url: width: 160 }} 1x, {{ img | image_url: width: 320 }} 2x"
                      alt=""
                      width="80"
                      height="80"
                      loading="lazy"
                    >
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="spotlight__viewer spotlight__viewer--empty">
              {{ 'product-1' | placeholder_svg_tag: 'spotlight__placeholder' }}
            </div>
          {%- endif -%}

          {%- if s.badge != blank -%}
            <span class="badge sticker spotlight__badge">{{ s.badge | escape }}</span>
          {%- endif -%}
        </spotlight-gallery>

        {%- comment -%} Info + product form (§4 markup contract) {%- endcomment -%}
        <div class="spotlight__info">
          <product-form
            class="spotlight__product-form"
            data-section-id="{{ section.id }}"
            data-product-id="{{ product.id }}"
            data-url="{{ product.url }}"
            data-handle="{{ product.handle }}"
            data-price-target="{{ price_id }}"
            data-update-url="false"
          >
            {%- form 'product', product, id: form_id, class: 'spotlight__form', data-type: 'add-to-cart-form' -%}
              <script type="application/json" data-variants>{{ product.variants | json }}</script>
              <script type="application/json" data-options>{{ product.options | json }}</script>

              {%- if s.eyebrow != blank -%}
                <p class="eyebrow spotlight__eyebrow">
                  <span class="accent" aria-hidden="true">{% render 'icon', name: 'shark' %}</span>
                  {{ s.eyebrow | escape }}
                </p>
              {%- endif -%}

              <h2 class="h2 spotlight__title">
                <a href="{{ product.url }}">{{ heading | escape }}</a>
              </h2>

              {%- if s.show_rating -%}
                {% render 'rating', product: product, size: 'md', count_url: reviews_url %}
              {%- endif -%}

              <div class="spotlight__price-row">
                <div id="{{ price_id }}" class="price price--lg{% if on_sale %} price--on-sale{% endif %}" data-price-target>
                  <span class="price__current" data-price data-price-current>{{ price_money }}</span>
                  <s class="price__compare" data-compare-price data-price-compare{% unless on_sale %} hidden{% endunless %}>
                    <span class="visually-hidden">{{ 'bundles.was' | t }} </span>{% if on_sale %}{{ compare_money }}{% endif %}
                  </s>
                  <span class="price__save badge badge--accent" data-save-badge data-price-save{% unless on_sale %} hidden{% endunless %}>{{ saving_text }}</span>
                </div>
                {%- if show_bundle_hint -%}
                  <span class="badge badge--accent spotlight__hint">
                    {{ 'products.product.bundle_hint' | t: min: settings.bundle_tier_min, percent: settings.bundle_tier_percent }}
                  </span>
                {%- endif -%}
              </div>

              {%- if s.bullets != blank -%}
                <div class="rte spotlight__bullets">{{ s.bullets }}</div>
              {%- endif -%}

              {%- unless product.has_only_default_variant -%}
                <div class="spotlight__options">
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign option_index = forloop.index0
                      assign select_id = section.id | append: '-option-' | append: option_index
                      assign option_name_down = option.name | downcase
                    -%}
                    <div class="field spotlight__option">
                      <label class="field__label" for="{{ select_id }}">
                        {{ option.name | escape }}:
                        <span class="spotlight__selected" data-selected-value data-option-index="{{ option_index }}">{{ option.selected_value | escape }}</span>
                      </label>
                      <select id="{{ select_id }}" class="select" data-option-index="{{ option_index }}">
                        {%- for value in option.values -%}
                          <option
                            value="{{ value.name | escape }}"
                            data-label="{{ value.name | escape }}"
                            {% if value.selected %}selected{% endif %}
                            {% unless value.available %}data-unavailable{% endunless %}
                          >
                            {{ value.name | escape }}{% unless value.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
                          </option>
                        {%- endfor -%}
                      </select>
                      {%- if option_name_down == 'size' -%}
                        <p class="field__hint small spotlight__size-help">
                          {{ 'products.product.size_help' | t }}
                          <a href="{{ product.url }}">{{ 'products.product.size_guide' | t }}</a>
                        </p>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
                <noscript>
                  <p class="small spotlight__noscript">
                    <a href="{{ product.url }}">{{ 'products.product.choose_options' | t }}</a>
                  </p>
                </noscript>
              {%- endunless -%}

              <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

              <div class="spotlight__buy">
                {%- if s.show_quantity -%}
                  <div class="spotlight__quantity">
                    <label class="visually-hidden" for="{{ section.id }}-quantity">{{ 'products.product.quantity' | t }}</label>
                    <quantity-input class="quantity-input">
                      <button type="button" data-action="decrease" aria-label="{{ 'products.product.decrease' | t }}">
                        {% render 'icon', name: 'minus' %}
                      </button>
                      <input
                        id="{{ section.id }}-quantity"
                        type="number"
                        inputmode="numeric"
                        name="quantity"
                        value="1"
                        min="1"
                      >
                      <button type="button" data-action="increase" aria-label="{{ 'products.product.increase' | t }}">
                        {% render 'icon', name: 'plus' %}
                      </button>
                    </quantity-input>
                  </div>
                {%- else -%}
                  <input type="hidden" name="quantity" value="1" min="1">
                {%- endif -%}

                <button
                  type="submit"
                  class="btn btn--lg btn--full spotlight__add"
                  data-add-button
                  {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
                >
                  <span data-add-text data-button-text>
                    {%- if current_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>
              </div>

              <p class="small muted spotlight__availability" data-availability hidden></p>
              <p class="small spotlight__stock" data-low-stock data-inventory-target hidden></p>
              <p class="form__error spotlight__error" data-form-error role="alert" hidden></p>
            {%- endform -%}
          </product-form>

          {%- if s.show_trust -%}
            <ul class="spotlight__trust small" role="list">
              {%- if settings.free_shipping_threshold > 0 -%}
                <li>
                  {% render 'icon', name: 'truck' %}
                  <span>{{ 'cart.trust_shipping' | t: amount: free_ship_amount }}</span>
                </li>
              {%- endif -%}
              {%- if s.trust_text != blank -%}
                <li>
                  {% render 'icon', name: 'shield' %}
                  <span>{{ s.trust_text | escape }}</span>
                </li>
              {%- endif -%}
              <li>
                {% render 'icon', name: 'lock' %}
                <span>{{ 'cart.trust_secure' | t }}</span>
              </li>
            </ul>
          {%- endif -%}

          <a class="btn btn--ghost spotlight__details" href="{{ product.url }}">
            {{ 'products.product.view_details' | t }}
            {% render 'icon', name: 'arrow-right' %}
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      if (window.customElements.get('spotlight-gallery')) return;
      var REDUCED = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      class SpotlightGallery extends HTMLElement {
        connectedCallback() {
          var self = this;
          this.viewer = this.querySelector('[data-gallery-viewer]');
          this.slides = Array.prototype.slice.call(this.querySelectorAll('[data-media-id]'));
          this.thumbs = Array.prototype.slice.call(this.querySelectorAll('[data-thumb]'));
          this.thumbs.forEach(function (thumb) {
            thumb.addEventListener('click', function () {
              self.showMedia(thumb.getAttribute('data-thumb'));
            });
          });
          if (this.viewer && 'IntersectionObserver' in window) {
            this.io = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (entry.isIntersecting && entry.intersectionRatio >= 0.6) {
                    self.setActive(entry.target.getAttribute('data-media-id'));
                  }
                });
              },
              { root: this.viewer, threshold: [0.6] }
            );
            this.slides.forEach(function (slide) {
              self.io.observe(slide);
            });
          }
        }

        disconnectedCallback() {
          if (this.io) this.io.disconnect();
        }

        setActive(id) {
          this.slides.forEach(function (slide) {
            slide.classList.toggle('is-active', slide.getAttribute('data-media-id') === id);
          });
          this.thumbs.forEach(function (thumb) {
            var active = thumb.getAttribute('data-thumb') === id;
            thumb.classList.toggle('is-active', active);
            thumb.setAttribute('aria-current', active ? 'true' : 'false');
          });
        }

        showMedia(id, options) {
          id = String(id);
          var slide = this.slides.filter(function (item) {
            return item.getAttribute('data-media-id') === id;
          })[0];
          if (!slide || !this.viewer) return;
          var instant = REDUCED || (options && options.initial);
          this.viewer.scrollTo({ left: slide.offsetLeft, behavior: instant ? 'auto' : 'smooth' });
          this.setActive(id);
        }
      }

      window.customElements.define('spotlight-gallery', SpotlightGallery);
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="section spotlight{{ scheme_class }}">
    <div class="container">
      <div class="spotlight__empty">
        {{ 'product-1' | placeholder_svg_tag: 'spotlight__placeholder' }}
        <p class="muted">Pick a product in the sidebar. Until then this section is hidden on the live store.</p>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product spotlight",
  "tag": "section",
  "class": "section-product-spotlight",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Falls back to the first product in the shark-slippers collection."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "This season's hero"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Leave blank to use the product title."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge on image",
      "default": ""
    },
    {
      "type": "richtext",
      "id": "bullets",
      "label": "Benefit bullets",
      "default": "<ul><li>Winter: plush fuzzy lining, warm on cold tiles · Originals: lightweight, airy EVA</li><li>Grippy sole for slippery floors</li><li>Sizes 36–45 (EU)</li><li>Free standard shipping over $30</li></ul>"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bundle_hint",
      "label": "Show “Buy 2+ pairs, save 20%” chip",
      "default": true,
      "info": "Only for products in the shark-slippers collection."
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust row",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Replacement line",
      "default": "Damaged on arrival? Replaced within 7 days"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Soft aqua" },
        { "value": "brand", "label": "Navy" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Product spotlight"
    }
  ]
}
{% endschema %}
