{{ 'section-benefits.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme = section.settings.color_scheme | default: 'default'
  assign padding_mobile_top = section.settings.padding_top | times: 0.75 | round
  assign padding_mobile_bottom = section.settings.padding_bottom | times: 0.75 | round
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .benefits {
    padding-top: {{ padding_mobile_top }}px;
    padding-bottom: {{ padding_mobile_bottom }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .benefits {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="benefits section{% if scheme != 'default' %} section--{{ scheme }}{% endif %}">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <header class="section__header section__header--center benefits__header">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="section__title h2">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="section__subtitle">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="benefits__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="benefits__item reveal" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="benefits__icon" aria-hidden="true">
                {% render 'icon', name: block.settings.icon %}
              </span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="benefits__title h5">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="benefits__text small">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Benefits",
  "tag": "section",
  "class": "section-benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Shark Bite"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Soft aqua" },
        { "value": "brand", "label": "Navy" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "snowflake", "label": "Snowflake" },
            { "value": "sun", "label": "Sun" },
            { "value": "shield", "label": "Shield" },
            { "value": "gift", "label": "Gift" },
            { "value": "truck", "label": "Truck" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "heart", "label": "Heart" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "lock", "label": "Lock" },
            { "value": "box", "label": "Box" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "star", "label": "Star" },
            { "value": "shark", "label": "Shark" }
          ],
          "default": "snowflake"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Plush, warm lining"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Thick fuzzy lining that keeps toes toasty on cold floors."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "snowflake",
            "title": "Plush, warm lining",
            "text": "Thick fuzzy lining that keeps toes toasty on cold floors."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "Grippy sole",
            "text": "Sure-footed on tile, balcony, kitchen — anywhere at home."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "sun",
            "title": "Light & breathable",
            "text": "The Originals slide is airy EVA — perfect for warm days."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "gift",
            "title": "The gift that always lands",
            "text": "Sizes 36–45 and a wearable shark blanket for the whole family."
          }
        }
      ]
    }
  ]
}
{% endschema %}
