{
  "name": "Header",
  "type": "header",
  "sections": {
    "announcement-bar": {
      "type": "announcement-bar",
      "settings": {
        "color_scheme": "brand",
        "autoplay": true,
        "speed": 5,
        "show_arrows": false
      },
      "blocks": {
        "announcement-shipping": {
          "type": "announcement",
          "settings": {
            "text": "Free standard shipping over $30 across Lebanon",
            "link": "/collections/shark-slippers",
            "icon": "shark"
          }
        },
        "announcement-pairs": {
          "type": "announcement",
          "settings": {
            "text": "Buy 2 pairs, save 20% — applied automatically",
            "link": "/pages/bundles",
            "icon": "gift"
          }
        },
        "announcement-rating": {
          "type": "rating",
          "settings": {
            "text": "Rated {{ rating }}★ by {{ count }} shark fans",
            "icon": "star"
          }
        }
      },
      "block_order": ["announcement-shipping", "announcement-pairs", "announcement-rating"]
    },
    "header": {
      "type": "header",
      "settings": {
        "menu": "main-menu",
        "logo_position": "left",
        "sticky": true,
        "show_search": true,
        "show_account": false,
        "show_free_shipping_pill": true
      }
    }
  },
  "order": ["announcement-bar", "header"]
}
