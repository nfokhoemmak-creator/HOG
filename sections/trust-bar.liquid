{%- if section.blocks.size > 0 -%}
  <div class="trust-bar">
    <ul class="container trust-bar__list">
      {%- for block in section.blocks -%}
        <li class="trust-bar__item" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <div>
            <strong>{{ block.settings.heading }}</strong>
            {%- if block.settings.text != blank -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "trust-bar-section",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck (shipping)" },
            { "value": "cash", "label": "Cash (cash on delivery)" },
            { "value": "clock", "label": "Clock (delivery time)" },
            { "value": "lips", "label": "Lips" },
            { "value": "refresh", "label": "Returns" },
            { "value": "rabbit", "label": "Cruelty-free" },
            { "value": "leaf", "label": "Leaf (clean / natural)" },
            { "value": "shield", "label": "Shield (guarantee)" },
            { "value": "lock", "label": "Lock (secure)" },
            { "value": "heart", "label": "Heart" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "face", "label": "Face (dermatologist-tested)" },
            { "value": "chat", "label": "Chat (support)" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "$4 flat shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Anywhere in Lebanon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "heading": "$4 flat shipping", "text": "Anywhere in Lebanon" } },
        { "type": "item", "settings": { "icon": "cash", "heading": "Cash on delivery", "text": "Pay when it arrives" } },
        { "type": "item", "settings": { "icon": "clock", "heading": "Delivered in 1–3 days", "text": "Ships within 24 hours" } },
        { "type": "item", "settings": { "icon": "rabbit", "heading": "Cruelty-free", "text": "Never tested on animals" } }
      ]
    }
  ]
}
{% endschema %}
