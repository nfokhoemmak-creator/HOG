{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  assign is_preorder = false
  if product.tags contains 'preorder' or product.title contains 'PRE-ORDER'
    assign is_preorder = true
  endif

  assign is_limited = false
  if product.tags contains 'limited'
    assign is_limited = true
  endif

  assign form_id = 'ProductForm-' | append: section.id
-%}

{% style %}
  /* Star rating row */
  .product-rating {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .product-rating__text {
    font-size: 1.3rem;
    color: var(--color-muted);
  }

  /* Evergreen flash-sale bar */
  .pdp-countdown {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-family: var(--font-heading-family);
    font-size: 1.2rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
  }

  .pdp-countdown[hidden] {
    display: none;
  }

  .pdp-countdown__timer {
    font-variant-numeric: tabular-nums;
    font-size: 1.5rem;
    min-width: 4.6rem;
    text-align: left;
  }

  /* Trust badges row */
  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .trust-badges__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 1.3rem;
  }

  .trust-badges__icon {
    display: inline-flex;
    color: var(--color-accent);
  }

  .trust-badges__icon svg {
    width: 2rem;
    height: 2rem;
  }

  /* Payment badges */
  .payment-badges {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    text-align: center;
  }

  .payment-badges__caption {
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .payment-badges .payment-list {
    justify-content: center;
  }

  /* Benefits checklist */
  .product-benefits ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .product-benefits li {
    position: relative;
    padding-left: 2.4rem;
    font-size: 1.4rem;
  }

  .product-benefits li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-accent);
    font-weight: var(--font-body-weight-bold, 700);
  }

  /* Mobile sticky add-to-cart bar */
  .sticky-atc {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding: var(--space-2) var(--gutter) calc(var(--space-2) + env(safe-area-inset-bottom, 0px));
    transform: translateY(100%);
    visibility: hidden;
    transition: transform var(--duration) var(--ease), visibility var(--duration);
  }

  .sticky-atc.is-visible {
    transform: none;
    visibility: visible;
  }

  .sticky-atc__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .sticky-atc__image {
    width: 4.8rem;
    height: 4.8rem;
    object-fit: cover;
    border-radius: var(--radius);
    flex-shrink: 0;
  }

  .sticky-atc__meta {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
    flex: 1;
  }

  .sticky-atc__title {
    font-family: var(--font-heading-family);
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sticky-atc__price {
    font-size: 1.3rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .sticky-atc .btn {
    flex-shrink: 0;
    padding-inline: var(--space-4);
  }

  @media screen and (min-width: 990px) {
    .sticky-atc {
      display: none;
    }
  }
{% endstyle %}

<div class="container">
  <div class="product">
    {%- comment -%} ------------------------------------------------ gallery {%- endcomment -%}
    <div class="product__media" data-gallery>
      <div class="product__media-list">
        {%- for media in product.media -%}
          <div data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <img
                  src="{{ media | image_url: width: 1400 }}"
                  srcset="
                    {{ media | image_url: width: 600 }} 600w,
                    {{ media | image_url: width: 1000 }} 1000w,
                    {{ media | image_url: width: 1400 }} 1400w,
                    {{ media | image_url: width: 1800 }} 1800w
                  "
                  sizes="(min-width: 990px) 60vw, 100vw"
                  alt="{{ media.alt | escape }}"
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                >

              {%- when 'video' -%}
                {{ media | video_tag: image_size: '1400x', controls: true, muted: true, playsinline: true }}

              {%- when 'external_video' -%}
                {{ media | external_video_tag }}

              {%- when 'model' -%}
                {{ media | model_viewer_tag }}

              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: '' }}
        {%- endfor -%}
      </div>

      {%- if product.media.size > 1 and section.settings.media_layout == 'thumbnails' -%}
        <div class="product__thumbs">
          {%- for media in product.media -%}
            <button
              type="button"
              class="product__thumb"
              data-thumb="{{ media.id }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
            >
              <img
                src="{{ media.preview_image | image_url: width: 200 }}"
                alt=""
                width="72"
                height="96"
                loading="lazy"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} --------------------------------------------------- info {%- endcomment -%}
    <div class="product__info{% if section.settings.enable_sticky_info %} product__info--sticky{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'badges' -%}
            {%- if is_preorder or is_limited or product.available == false -%}
              <div class="product__badges" {{ block.shopify_attributes }}>
                {%- if is_preorder -%}
                  <span class="badge badge--accent">{{ 'products.product.preorder' | t }}</span>
                {%- endif -%}
                {%- if is_limited -%}
                  <span class="badge badge--accent">{{ 'products.product.limited' | t }}</span>
                {%- endif -%}
                {%- unless product.available -%}
                  <span class="badge badge--sold">{{ 'products.product.sold_out' | t }}</span>
                {%- endunless -%}
              </div>
            {%- endif -%}

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'price' -%}
            <div id="ProductPrice-{{ section.id }}" {{ block.shopify_attributes }}>
              {% render 'price',
                product: product,
                use_variant: true,
                price_class: 'product__price',
                id_prefix: 'ProductPrice'
              %}
            </div>
            <p class="product__inventory" id="ProductInventory-{{ section.id }}" hidden></p>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset style="border: 0; margin: 0; padding: 0;">
                    <legend class="variant-option__label" style="width: 100%;">
                      <span>{{ option.name }}</span>
                    </legend>

                    <div class="variant-option__values">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                        <input
                          class="variant-option__input"
                          type="radio"
                          id="{{ input_id }}"
                          name="{{ option.name }}-{{ section.id }}"
                          value="{{ value | escape }}"
                          data-option-index="{{ forloop.parentloop.index0 }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label class="variant-option__value" for="{{ input_id }}">{{ value }}</label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'quantity_selector' -%}
            <div {{ block.shopify_attributes }}>
              <span class="variant-option__label">{{ 'sections.cart.quantity' | t }}</span>
              <quantity-input class="quantity-input">
                <button type="button" data-action="decrease" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title }}">&minus;</button>
                <input
                  type="number"
                  name="quantity"
                  form="ProductForm-{{ section.id }}"
                  value="1"
                  min="1"
                  aria-label="{{ 'products.product.quantity.input_label' | t: product: product.title }}"
                >
                <button type="button" data-action="increase" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title }}">+</button>
              </quantity-input>
            </div>

          {%- when 'buy_buttons' -%}
            <product-form
              data-section-id="{{ section.id }}"
              data-price-target="ProductPrice-{{ section.id }}"
              data-inventory-target="ProductInventory-{{ section.id }}"
              data-preorder="{{ is_preorder }}"
              {{ block.shopify_attributes }}
            >
              <script type="application/json" data-variants>
                {{ product.variants | json }}
              </script>

              {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">

                <button
                  type="submit"
                  name="add"
                  class="btn btn--accent btn--full"
                  {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
                >
                  <span data-button-text>
                    {%- if current_variant.available -%}
                      {%- if is_preorder -%}
                        {{ 'products.product.preorder' | t }}
                      {%- else -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- endif -%}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>

                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}

              {%- if is_preorder -%}
                <p class="product__inventory" style="margin-top: var(--space-2);">
                  {{ 'products.product.preorder_note' | t }}
                </p>
              {%- endif -%}
            </product-form>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}

          {%- when 'accordion' -%}
            {%- liquid
              assign content = block.settings.content
              if block.settings.metafield != blank
                assign parts = block.settings.metafield | split: '.'
                assign namespace = parts[0]
                assign key = parts[1]
                assign meta_value = product.metafields[namespace][key]
                if meta_value != blank
                  assign content = meta_value
                endif
              endif
            -%}

            {%- if content != blank -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary>
                  {{ block.settings.heading }}
                  {% render 'icon', name: 'plus' %}
                </summary>
                <div class="accordion__content rte">{{ content }}</div>
              </details>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'share' -%}
            <a
              class="underline eyebrow"
              href="https://wa.me/?text={{ shop.url | append: product.url | url_encode }}"
              target="_blank"
              rel="noopener"
              aria-describedby="a11y-new-window-message"
              {{ block.shopify_attributes }}
            >
              {{ 'products.product.share' | t }}
            </a>

          {%- when 'rating' -%}
            {%- liquid
              assign rating_value = block.settings.rating
              assign rating_count = block.settings.review_count
              assign mf_rating = product.metafields.reviews.rating.value
              if mf_rating != blank
                if mf_rating.rating
                  assign rating_value = mf_rating.rating
                else
                  assign rating_value = mf_rating
                endif
                assign mf_count = product.metafields.reviews.rating_count.value
                if mf_count != blank
                  assign rating_count = mf_count
                endif
              endif
            -%}
            <div class="product-rating" {{ block.shopify_attributes }}>
              {% render 'star-rating', rating: rating_value, size: 'small' %}
              <span class="product-rating__text">
                {{- rating_value }}/5 &middot; {{ rating_count }} reviews {{ block.settings.caption | escape -}}
              </span>
            </div>

          {%- when 'countdown' -%}
            <evergreen-countdown
              class="pdp-countdown"
              data-minutes="{{ block.settings.minutes }}"
              data-key="pdp-{{ product.id }}"
              {{ block.shopify_attributes }}
            >
              <span class="pdp-countdown__heading">{{ block.settings.heading | escape }}</span>
              <span class="pdp-countdown__timer" data-timer>--:--</span>
            </evergreen-countdown>

          {%- when 'bundle' -%}
            {% render 'bundle-offers', product: product, block: block, form_id: form_id %}

          {%- when 'trust_badges' -%}
            <div class="trust-badges" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- liquid
                  assign icon_key = 'item' | append: i | append: '_icon'
                  assign text_key = 'item' | append: i | append: '_text'
                  assign item_text = block.settings[text_key]
                -%}
                {%- if item_text != blank -%}
                  <div class="trust-badges__item">
                    <span class="trust-badges__icon">{% render 'icon-benefit', name: block.settings[icon_key] %}</span>
                    <span>{{ item_text | escape }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'payment_badges' -%}
            <div class="payment-badges" {{ block.shopify_attributes }}>
              {%- if block.settings.caption != blank -%}
                <p class="payment-badges__caption">{{ block.settings.caption | escape }}</p>
              {%- endif -%}
              <div class="payment-list">
                {%- for type in shop.enabled_payment_types -%}
                  {{ type | payment_type_svg_tag }}
                {%- endfor -%}
              </div>
            </div>

          {%- when 'benefits' -%}
            {%- if block.settings.text != blank -%}
              <div class="product-benefits" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.enable_sticky_atc -%}
    <sticky-atc class="sticky-atc" data-form-id="ProductForm-{{ section.id }}">
      <div class="sticky-atc__inner">
        {%- if product.featured_media -%}
          <img
            class="sticky-atc__image"
            src="{{ product.featured_media | image_url: width: 96, height: 96, crop: 'center' }}"
            alt="{{ product.featured_media.alt | escape }}"
            width="96"
            height="96"
            loading="lazy"
          >
        {%- endif -%}
        <div class="sticky-atc__meta">
          <span class="sticky-atc__title">{{ product.title | escape }}</span>
          <span class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</span>
        </div>
        <button type="button" class="btn btn--accent">Add to cart</button>
      </div>
    </sticky-atc>
  {%- endif -%}
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 400 | json }},
    "sku": {{ current_variant.sku | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
    {%- if product.featured_media -%}
      "image": {{ product.featured_media | image_url: width: 1200 | prepend: "https:" | json }},
    {%- endif -%}
    "url": {{ shop.url | append: product.url | json }},
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "sku": {{ variant.sku | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "url": {{ shop.url | append: product.url | append: '?variant=' | append: variant.id | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "main-product-section",
  "settings": [
    {
      "type": "select",
      "id": "media_layout",
      "label": "t:sections.main_product.settings.media_layout.label",
      "options": [
        { "value": "stacked", "label": "t:sections.main_product.settings.media_layout.options__1" },
        { "value": "thumbnails", "label": "t:sections.main_product.settings.media_layout.options__2" }
      ],
      "default": "stacked"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "t:sections.main_product.settings.enable_sticky_info.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_atc",
      "label": "Sticky add to cart on mobile",
      "default": true
    }
  ],
  "blocks": [
    { "type": "badges", "name": "Badges", "limit": 1 },
    { "type": "title", "name": "t:sections.main_product.blocks.title.name", "limit": 1 },
    { "type": "price", "name": "t:sections.main_product.blocks.price.name", "limit": 1 },
    { "type": "variant_picker", "name": "t:sections.main_product.blocks.variant_picker.name", "limit": 1 },
    { "type": "quantity_selector", "name": "t:sections.main_product.blocks.quantity_selector.name", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "t:sections.main_product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
          "default": true
        }
      ]
    },
    { "type": "description", "name": "t:sections.main_product.blocks.description.name", "limit": 1 },
    {
      "type": "accordion",
      "name": "t:sections.main_product.blocks.accordion.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.main_product.blocks.accordion.settings.heading.label",
          "default": "Materials"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.main_product.blocks.accordion.settings.content.label"
        },
        {
          "type": "text",
          "id": "metafield",
          "label": "t:sections.main_product.blocks.accordion.settings.metafield.label",
          "info": "t:sections.main_product.blocks.accordion.settings.metafield.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.main_product.blocks.text.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.main_product.blocks.text.settings.text.label"
        }
      ]
    },
    { "type": "share", "name": "t:sections.main_product.blocks.share.name", "limit": 1 },
    {
      "type": "rating",
      "name": "Star rating",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 3,
          "max": 5,
          "step": 0.1,
          "label": "Rating",
          "default": 4.8,
          "info": "Overridden by the reviews.rating metafield when present."
        },
        {
          "type": "number",
          "id": "review_count",
          "label": "Review count",
          "default": 847
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "from verified customers"
        }
      ]
    },
    {
      "type": "countdown",
      "name": "Countdown bar",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "FLASH SALE — OFFER ENDS IN"
        },
        {
          "type": "range",
          "id": "minutes",
          "min": 5,
          "max": 120,
          "step": 5,
          "unit": "min",
          "label": "Timer length",
          "default": 15,
          "info": "Evergreen: the deadline is stored per visitor for the browsing session."
        }
      ]
    },
    {
      "type": "bundle",
      "name": "Bundle & save",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "BUNDLE & SAVE"
        },
        { "type": "header", "content": "Tier 1" },
        {
          "type": "range",
          "id": "tier1_quantity",
          "min": 0,
          "max": 6,
          "step": 1,
          "label": "Quantity",
          "default": 1,
          "info": "0 disables this tier"
        },
        {
          "type": "range",
          "id": "tier1_discount",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "%",
          "label": "Discount",
          "default": 0
        },
        {
          "type": "text",
          "id": "tier1_label",
          "label": "Label",
          "default": "Buy 1"
        },
        {
          "type": "text",
          "id": "tier1_badge",
          "label": "Badge"
        },
        {
          "type": "text",
          "id": "tier1_code",
          "label": "Discount code",
          "info": "Applied automatically at checkout when this tier is added."
        },
        { "type": "header", "content": "Tier 2" },
        {
          "type": "range",
          "id": "tier2_quantity",
          "min": 0,
          "max": 6,
          "step": 1,
          "label": "Quantity",
          "default": 2,
          "info": "0 disables this tier"
        },
        {
          "type": "range",
          "id": "tier2_discount",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "%",
          "label": "Discount",
          "default": 10
        },
