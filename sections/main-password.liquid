<div class="password__inner">
  {%- if settings.logo != blank -%}
    <img
      class="password__logo"
      src="{{ settings.logo | image_url: width: 600 }}"
      alt="{{ shop.name | escape }}"
      width="{{ settings.logo.width }}"
      height="{{ settings.logo.height }}"
    >
  {%- else -%}
    <h1 class="password__heading">{{ shop.name }}</h1>
  {%- endif -%}

  <p class="eyebrow">{{ 'sections.password.opening_soon' | t }}</p>

  {%- if settings.brand_tagline != blank -%}
    <p class="h3">{{ settings.brand_tagline }}</p>
  {%- endif -%}

  {%- form 'customer', class: 'newsletter-form', style: 'justify-content: center;' -%}
    <input type="hidden" name="contact[tags]" value="prelaunch">
    <label class="visually-hidden" for="PasswordNewsletter">
      {{ 'general.newsletter_form.email_placeholder' | t }}
    </label>
    <input
      id="PasswordNewsletter"
      class="field__input"
      type="email"
      name="contact[email]"
      placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
      autocomplete="email"
      required
    >
    <button type="submit" class="btn btn--accent">{{ 'general.newsletter_form.submit' | t }}</button>

    {%- if form.posted_successfully? -%}
      <p class="form__success" style="width: 100%;">{{ 'general.newsletter_form.confirmation' | t }}</p>
    {%- endif -%}
  {%- endform -%}

  {% render 'social-links' %}

  <details data-dismissible>
    <summary class="eyebrow underline" style="cursor: pointer;">
      {{ 'sections.password.login_password' | t }}
    </summary>

    <div style="margin-top: var(--space-4);">
      {%- form 'storefront_password' -%}
        <div class="field">
          <label class="visually-hidden" for="StorePassword">
            {{ 'sections.password.login_form_password_label' | t }}
          </label>
          <input
            class="field__input"
            type="password"
            id="StorePassword"
            name="password"
            placeholder="{{ 'sections.password.login_form_password_placeholder' | t }}"
            autocomplete="current-password"
          >
        </div>

        {%- if form.errors -%}
          <p class="form__error">{{ 'sections.password.login_form_error' | t }}</p>
        {%- endif -%}

        <button type="submit" class="btn btn--full">{{ 'sections.password.login_form_submit' | t }}</button>
      {%- endform -%}

      <p class="muted" style="margin-top: var(--space-3); font-size: 1.2rem;">
        {{ 'sections.password.admin_link_html' | t }}
      </p>
    </div>
  </details>
</div>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
