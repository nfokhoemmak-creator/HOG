{%- liquid
  assign scheme_class = ''
  if section.settings.color_scheme != blank and section.settings.color_scheme != 'default'
    assign scheme_class = ' section--' | append: section.settings.color_scheme
  endif
  assign padding_mobile_top = section.settings.padding_top | times: 0.75 | round
  assign padding_mobile_bottom = section.settings.padding_bottom | times: 0.75 | round
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .main-page {
    padding-top: {{ padding_mobile_top }}px;
    padding-bottom: {{ padding_mobile_bottom }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .main-page {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="main-page section{{ scheme_class }}">
  <div class="container{% if section.settings.narrow %} container--narrow{% endif %}">
    {%- if section.settings.show_title -%}
      <header class="page-header{% if section.settings.text_alignment == 'center' %} page-header--center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">
            {% render 'icon', name: 'shark' %}
            {{ section.settings.eyebrow | escape }}
          </p>
        {%- endif -%}
        <h1 class="h1">{{ page.title | escape }}</h1>
      </header>
    {%- endif -%}

    <div class="page-content rte">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page content",
  "tag": "section",
  "class": "section-main-page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Optional short label above the title, shown with the shark mark."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Title alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "narrow",
      "label": "Narrow reading width",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Soft aqua" },
        { "value": "brand", "label": "Navy" }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
