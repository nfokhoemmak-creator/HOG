{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "badges": { "type": "badges", "settings": {} },
        "title": { "type": "title", "settings": {} },
        "price": { "type": "price", "settings": {} },
        "variant_picker": { "type": "variant_picker", "settings": {} },
        "size_guide": {
          "type": "size_guide",
          "settings": {
            "label": "Size guide",
            "metafield": "custom.size_guide",
            "chart": "Size, Chest (cm), Length (cm), Sleeve (cm)\nS, 52, 68, 60\nM, 55, 70, 62\nL, 58, 72, 64\nXL, 61, 74, 66",
            "note": "<p>Garments are measured flat. For the chest, measure across just under the arms and double it. Between sizes? Size up for the intended relaxed fit.</p>"
          }
        },
        "quantity": { "type": "quantity_selector", "settings": {} },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true
          }
        },
        "description": { "type": "description", "settings": {} },
        "fabric": {
          "type": "accordion",
          "settings": {
            "heading": "Materials",
            "metafield": "custom.fabric"
          }
        },
        "fit": {
          "type": "accordion",
          "settings": {
            "heading": "Fit",
            "metafield": "custom.fit"
          }
        },
        "shipping": {
          "type": "accordion",
          "settings": {
            "heading": "Shipping & returns",
            "content": "<p>Delivery all over Lebanon, 2–4 business days. Exchanges accepted within 7 days on unworn pieces with tags attached.</p>"
          }
        },
        "share": { "type": "share", "settings": {} }
      },
      "block_order": [
        "badges",
        "title",
        "price",
        "variant_picker",
        "size_guide",
        "quantity",
        "buy_buttons",
        "description",
        "fabric",
        "fit",
        "shipping",
        "share"
      ],
      "settings": {
        "media_layout": "stacked",
        "enable_sticky_info": true
      }
    },
    "videos": {
      "type": "video-showcase",
      "blocks": {
        "video-1": { "type": "video", "settings": {} },
        "video-2": { "type": "video", "settings": {} },
        "video-3": { "type": "video", "settings": {} }
      },
      "block_order": ["video-1", "video-2", "video-3"],
      "settings": {
        "eyebrow": "As worn",
        "heading": "In motion",
        "autoplay": true
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "heading": "You may also like",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2"
      }
    }
  },
  "order": ["main", "videos", "recommendations"]
}
