<section class="section{% if section.settings.alt_background %} section--alt{% endif %}">
  <div class="container">
    <div class="split{% if section.settings.layout == 'right' %} split--reverse{% endif %}">
      <div class="split__media reveal reveal--scale">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1000 }}"
            srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 1000 }} 1000w"
            sizes="(min-width: 990px) 45vw, 90vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        <div class="rte muted">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--green" style="margin-top: var(--space-5);" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "layout", "label": "Image position", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "checkbox", "id": "alt_background", "label": "Alternate background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We got tired of the cheese trick" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Goodest Chews started with one stubborn beagle and a kitchen counter full of half-used supplement bottles. We built the chew we wished existed: one soft treat that covers everything.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read our story" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
