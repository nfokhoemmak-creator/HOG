<div class="section">
  <div class="container container--narrow" style="text-align: {{ section.settings.text_alignment }};">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2" style="margin-bottom: var(--space-4);">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="page-content" style="padding-block: 0; margin-inline: {% if section.settings.text_alignment == 'center' %}auto{% else %}0{% endif %};">
        {{ section.settings.text }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "tag": "section",
  "class": "rich-text-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.rich_text.settings.heading.label",
      "default": "About Jamalati"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.rich_text.settings.text.label",
      "default": "<p>Clean, effective beauty made in small batches and shipped all over Lebanon.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.rich_text.settings.text_alignment.label",
      "options": [
        { "value": "left", "label": "t:sections.rich_text.settings.text_alignment.options__1" },
        { "value": "center", "label": "t:sections.rich_text.settings.text_alignment.options__2" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich_text.name"
    }
  ]
}
{% endschema %}
