{%- comment -%}
  Renders the brand logo. Uses the uploaded image from theme settings when
  present, otherwise draws the wordmark (GOODEST in green with the smiling
  O's, CHEWS in orange) in CSS/SVG so the header never looks empty.

  Accepts:
  - size: {Number} wordmark font size in px (default 30); also scales the image
  - inverse: {Boolean} for dark backgrounds — uses the "logo for dark
    backgrounds" image when set, otherwise the cream wordmark

  Usage:
  {% render 'logo', size: 34 %}
{%- endcomment -%}

{%- liquid
  assign size = size | default: 30
  assign logo_px = settings.logo_width | times: size | divided_by: 28
  assign image = settings.logo
  if inverse
    assign image = settings.logo_inverse
  endif
-%}

{%- if image != blank -%}
  <img
    class="logo-img"
    src="{{ image | image_url: width: 800 }}"
    srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 800 }} 800w"
    sizes="{{ logo_px }}px"
    alt="{{ shop.name | escape }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
    style="--logo-width: {{ logo_px }}px;"
    loading="eager"
    fetchpriority="high"
  >
{%- else -%}
  <span
    class="wordmark{% if inverse %} wordmark--inverse{% endif %}"
    style="--wordmark-size: {{ size }}px;"
    role="img"
    aria-label="{{ shop.name | escape }}"
  >
    <span class="wordmark__top" aria-hidden="true">
      G<svg class="wordmark__face" viewBox="0 0 132 62" aria-hidden="true" focusable="false"><circle cx="31" cy="31" r="21" fill="none" stroke="currentColor" stroke-width="17"/><circle cx="101" cy="31" r="21" fill="none" stroke="currentColor" stroke-width="17"/><path d="M50 36c3 11 29 11 32 0" fill="none" stroke="{% if inverse %}{{ settings.color_primary_dark }}{% else %}{{ settings.color_background }}{% endif %}" stroke-width="12" stroke-linecap="round"/><path d="M50 36c3 11 29 11 32 0" fill="none" stroke="{{ settings.color_accent }}" stroke-width="7" stroke-linecap="round"/></svg>DEST<span class="wordmark__tm">TM</span>
    </span>
    <span class="wordmark__bottom" aria-hidden="true">CHEWS</span>
  </span>
{%- endif -%}
