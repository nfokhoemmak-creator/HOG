<div class="drop-banner">
  {%- if section.settings.background_image != blank -%}
    <img
      class="drop-banner__bg"
      src="{{ section.settings.background_image | image_url: width: 2000 }}"
      alt=""
      width="{{ section.settings.background_image.width }}"
      height="{{ section.settings.background_image.height }}"
      loading="lazy"
      aria-hidden="true"
    >
  {%- endif -%}

  <div class="container drop-banner__content{% if settings.animations_enabled %} reveal{% endif %}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="drop-banner__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="drop-banner__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--outline" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>

  {%- comment -%}
    Decorative ticker along the band's bottom edge. Two identical runs so the
    -50% loop in section 10 is seamless; the whole strip is hidden from
    assistive tech because the heading already says it.
  {%- endcomment -%}
  {%- if section.settings.marquee != blank -%}
    <div class="marquee marquee--mini drop-banner__marquee" aria-hidden="true">
      <div class="marquee__track">
        {%- for i in (1..8) -%}
          <span class="marquee__item">{{ section.settings.marquee }}</span>
        {%- endfor -%}
        {%- for i in (1..8) -%}
          <span class="marquee__item">{{ section.settings.marquee }}</span>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.drop_banner.name",
  "tag": "section",
  "class": "drop-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.drop_banner.settings.eyebrow.label",
      "default": "Limited run"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.drop_banner.settings.heading.label",
      "default": "NO RESTOCKS"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.drop_banner.settings.text.label",
      "default": "<p>Every piece is made in a small batch. When a size sells out, that's it.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.drop_banner.settings.button_label.label",
      "default": "Shop the catalog"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.drop_banner.settings.button_link.label"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.drop_banner.settings.background_image.label"
    },
    {
      "type": "text",
      "id": "marquee",
      "label": "t:sections.drop_banner.settings.marquee.label",
      "info": "t:sections.drop_banner.settings.marquee.info",
      "default": "EVERYBODY CAN'T HAVE LIMITED ITEMS ·"
    }
  ],
  "presets": [
    {
      "name": "t:sections.drop_banner.name"
    }
  ]
}
{% endschema %}
