<div class="section{% if section.settings.background == 'alt' %} section--alt{% endif %}" id="reviews">
  <div class="container">
    <div class="section__head section__head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.summary_rating != blank -%}
        <div class="rating-summary">
          {% render 'stars', rating: section.settings.summary_rating, uid: section.id %}
          <strong>{{ section.settings.summary_rating }}/5</strong>
          {%- if section.settings.summary_text != blank -%}
            <span class="muted">{{ section.settings.summary_text }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="testimonials" style="--cols-desktop: {{ section.settings.columns_desktop }};">
      {%- for block in section.blocks -%}
        <figure class="testimonial{% if settings.animations_enabled %} reveal{% endif %}" {{ block.shopify_attributes }}>
          {% render 'stars', rating: block.settings.rating, size: 'small', uid: block.id %}
          <blockquote class="testimonial__quote">{{ block.settings.quote }}</blockquote>
          <figcaption class="testimonial__meta">
            {%- if block.settings.avatar != blank -%}
              <img
                class="testimonial__avatar"
                src="{{ block.settings.avatar | image_url: width: 120, height: 120, crop: 'center' }}"
                alt=""
                width="40"
                height="40"
                loading="lazy"
              >
            {%- else -%}
              <span class="testimonial__avatar" aria-hidden="true">{{ block.settings.name | slice: 0 | upcase }}</span>
            {%- endif -%}
            <div>
              <span class="testimonial__name">{{ block.settings.name }}</span>
              {%- if block.settings.verified -%}
                <span class="testimonial__verified">{% render 'icon', name: 'check' %}{{ 'sections.testimonials.verified' | t }}</span>
              {%- endif -%}
              {%- if block.settings.product != blank -%}
                <span class="testimonial__product"> · {{ block.settings.product }}</span>
              {%- endif -%}
            </div>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "testimonials-section",
  "max_blocks": 9,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Real results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by thousands of glowing customers"
    },
    {
      "type": "text",
      "id": "summary_rating",
      "label": "Average rating",
      "info": "e.g. 4.9. Leave blank to hide the summary pill.",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "summary_text",
      "label": "Summary text",
      "default": "based on 2,300+ verified reviews"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Alternate" }
      ],
      "default": "alt"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "My skin has never looked this good. Two weeks in and the glow is real — I get compliments every day."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Maya K."
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product bought",
          "default": "Glow Serum"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show “Verified buyer”",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "rating": 5, "quote": "My skin has never looked this good. Two weeks in and the glow is real — I get compliments every day.", "name": "Maya K.", "product": "Glow Serum" } },
        { "type": "testimonial", "settings": { "rating": 5, "quote": "Finally a lip tint that lasts through coffee and lunch. The shade range is perfect for Middle Eastern skin tones.", "name": "Nour H.", "product": "Velvet Lip Tint" } },
        { "type": "testimonial", "settings": { "rating": 5, "quote": "I have super sensitive skin and nothing stings. Delivery to Beirut took two days and the packaging is gorgeous.", "name": "Lea S.", "product": "Calm Cleanser" } }
      ]
    }
  ]
}
{% endschema %}
