<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_brand }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- liquid
      assign body_font = settings.type_body_font
      assign body_font_bold = body_font | font_modify: 'weight', 'bold'
      assign heading_font = settings.type_heading_font
      assign heading_font_bolder = heading_font | font_modify: 'weight', 'bolder'
      assign heading_font_medium = heading_font | font_modify: 'weight', '600'

      assign heading_weight_bolder = heading_font.weight
      if heading_font_bolder
        assign heading_weight_bolder = heading_font_bolder.weight
      endif

      assign heading_weight_medium = heading_font.weight
      if heading_font_medium
        assign heading_weight_medium = heading_font_medium.weight
      endif

      assign body_weight_bold = body_font.weight | plus: 300 | at_most: 900
      if body_font_bold
        assign body_weight_bold = body_font_bold.weight
      endif
    -%}

    {{ heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <style>
      {{ body_font | font_face: font_display: 'swap' }}
      {%- if body_font_bold %}{{ body_font_bold | font_face: font_display: 'swap' }}{% endif -%}
      {{ heading_font | font_face: font_display: 'swap' }}
      {%- if heading_font_bolder %}{{ heading_font_bolder | font_face: font_display: 'swap' }}{% endif -%}
      {%- if heading_font_medium %}{{ heading_font_medium | font_face: font_display: 'swap' }}{% endif %}

      :root {
        --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body-style: {{ body_font.style }};
        --font-body-weight: {{ body_font.weight }};
        --font-body-weight-bold: {{ body_weight_bold }};
        --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-style: {{ heading_font.style }};
        --font-heading-weight: {{ heading_font.weight }};
        --font-heading-weight-bolder: {{ heading_weight_bolder }};
        --font-heading-weight-medium: {{ heading_weight_medium }};
        --font-body-scale: {{ settings.type_body_scale | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.type_heading_scale | divided_by: 100.0 }};

        --color-bg: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-surface-alt: {{ settings.color_surface_alt }};
        --color-ink: {{ settings.color_text }};
        --color-muted: {{ settings.color_text_muted }};
        --color-border: {{ settings.color_border }};
        --color-brand: {{ settings.color_brand }};
        --color-brand-contrast: {{ settings.color_brand_contrast }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-contrast: {{ settings.color_accent_contrast }};
        --color-success: {{ settings.color_success }};
        --color-sale: {{ settings.color_sale }};
        --color-star: {{ settings.color_star }};

        --container: {{ settings.layout_max_width }}px;
        --gutter-desktop: {{ settings.layout_gutter }}px;
        --radius: {{ settings.layout_corner_radius }}px;
        --grid-gap: {{ settings.grid_gap }}px;
        --logo-width: {{ settings.logo_width }}px;
      }
    </style>

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body class="template-password">
    <a class="skip-to-content visually-hidden" href="#MainContent">
      {{ 'general.skip_to_content' | t }}
    </a>

    <main id="MainContent" class="password-layout" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <div class="visually-hidden" aria-live="polite" role="status" id="LiveRegion"></div>
  </body>
</html>
