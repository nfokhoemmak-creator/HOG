{%- liquid
  assign scheme_class = ''
  if section.settings.color_scheme != blank and section.settings.color_scheme != 'default'
    assign scheme_class = ' section--' | append: section.settings.color_scheme
  endif
  assign padding_mobile_top = section.settings.padding_top | times: 0.75 | round
  assign padding_mobile_bottom = section.settings.padding_bottom | times: 0.75 | round

  assign title = section.settings.heading
  if title == blank
    assign title = '404.title' | t
  endif

  assign text = section.settings.text
  if text == blank
    assign text = '404.text' | t
  endif

  assign button_label = section.settings.button_label
  if button_label == blank
    assign button_label = '404.button' | t
  endif

  assign link_label_2 = section.settings.link_label_2
  if link_label_2 == blank
    assign link_label_2 = '404.blanket_link' | t
  endif

  assign link_label_3 = section.settings.link_label_3
  if link_label_3 == blank
    assign link_label_3 = '404.bundles_link' | t
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .not-found-section {
    padding-top: {{ padding_mobile_top }}px;
    padding-bottom: {{ padding_mobile_bottom }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .not-found-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="not-found-section section{{ scheme_class }}">
  <div class="container container--narrow">
    <div class="not-found">
      <p class="eyebrow">
        {% render 'icon', name: 'shark' %}
        404
      </p>
      <h1 class="display">{{ title | escape }}</h1>
      <p class="lead">{{ text | escape }}</p>

      <div class="btn-row">
        <a class="btn btn--lg" href="{{ section.settings.button_link }}">{{ button_label | escape }}</a>
        <a class="btn btn--lg btn--outline" href="{{ section.settings.link_2 }}">{{ link_label_2 | escape }}</a>
        <a class="btn btn--lg btn--ghost" href="{{ section.settings.link_3 }}">
          {{ link_label_3 | escape }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      </div>

      {%- if section.settings.show_search -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="margin: var(--space-7) auto 0;">
          <div class="field">
            <label class="visually-hidden" for="Search-{{ section.id }}">{{ 'general.search.placeholder' | t }}</label>
            <span class="search-form__icon">{% render 'icon', name: 'search' %}</span>
            <input
              class="field__input"
              type="search"
              id="Search-{{ section.id }}"
              name="q"
              placeholder="{{ 'general.search.placeholder' | t }}"
              autocomplete="off"
            >
            <input type="hidden" name="options[prefix]" value="last">
          </div>
          <button type="submit" class="btn btn--secondary">{{ 'general.search.submit' | t }}</button>
        </form>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "class": "section-main-404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the default: This page swam away"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "info": "Leave blank to use the default text."
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "info": "Leave blank for: Shop slippers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link",
      "default": "/collections/shark-slippers"
    },
    {
      "type": "header",
      "content": "Second link"
    },
    {
      "type": "text",
      "id": "link_label_2",
      "label": "Label",
      "info": "Leave blank for: Shark blanket"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link",
      "default": "/products/sharkbite-blanket"
    },
    {
      "type": "header",
      "content": "Third link"
    },
    {
      "type": "text",
      "id": "link_label_3",
      "label": "Label",
      "info": "Leave blank for: Bundles & save"
    },
    {
      "type": "url",
      "id": "link_3",
      "label": "Link",
      "default": "/pages/bundles"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search box",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Soft aqua" },
        { "value": "brand", "label": "Navy" }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "enabled_on": {
    "templates": ["404"]
  }
}
{% endschema %}
