<section class="section{% if section.settings.alt_background %} section--alt{% endif %}">
  <div class="container container--narrow text-center reveal">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="rte lead muted">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}
      <a class="btn" style="margin-top: var(--space-5);" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "alt_background", "label": "Alternate background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk about your brand" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share a little about what makes Goodest Chews different.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
