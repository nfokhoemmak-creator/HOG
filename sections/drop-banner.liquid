<div class="drop-banner">
  {%- if section.settings.background_image != blank -%}
    <img
      class="drop-banner__bg"
      src="{{ section.settings.background_image | image_url: width: 2000 }}"
      alt=""
      width="{{ section.settings.background_image.width }}"
      height="{{ section.settings.background_image.height }}"
      loading="lazy"
      aria-hidden="true"
    >
  {%- endif -%}

  <div class="container drop-banner__content{% if settings.animations_enabled %} reveal{% endif %}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="h0">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="hero__subheading">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--outline" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.marquee != blank -%}
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {%- for i in (1..8) -%}
        <span class="marquee__item">{{ section.settings.marquee }}</span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.drop_banner.name",
  "tag": "section",
  "class": "drop-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.drop_banner.settings.eyebrow.label",
      "default": "Drop 03"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.drop_banner.settings.heading.label",
      "default": "SOLD OUT SOON"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.drop_banner.settings.text.label",
      "default": "<p>Every piece is a limited run. Nothing gets restocked.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.drop_banner.settings.button_label.label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.drop_banner.settings.button_link.label"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.drop_banner.settings.background_image.label"
    },
    {
      "type": "text",
      "id": "marquee",
      "label": "t:sections.drop_banner.settings.marquee.label",
      "default": "EVERYBODY CAN'T HAVE LIMITED ITEMS ·"
    }
  ],
  "presets": [
    {
      "name": "t:sections.drop_banner.name"
    }
  ]
}
{% endschema %}
