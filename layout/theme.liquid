<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" href="data:image/svg+xml,{{ '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><circle cx="32" cy="32" r="30" fill="#0F5132"/><path d="M18 30c0 9 6.3 14 14 14s14-5 14-14" fill="none" stroke="#F07F1F" stroke-width="7" stroke-linecap="round"/><circle cx="23" cy="24" r="4" fill="#FFFBF4"/><circle cx="41" cy="24" r="4" fill="#FFFBF4"/></svg>' | url_encode }}">
    {%- endif -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- assign tag_list = current_tags | join: ', ' -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: tag_list }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {%- liquid
      case settings.type_heading_font
        when 'baloo'
          assign google_heading = 'Baloo+2:wght@600;700;800'
        when 'nunito'
          assign google_heading = ''
        else
          assign google_heading = 'Fredoka:wght@500;600;700'
      endcase
    -%}

    {%- if google_heading != blank -%}
      <link href="https://fonts.googleapis.com/css2?family={{ google_heading }}&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    {%- else -%}
      <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    {%- endif -%}

    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- liquid
      comment
        Placeholders the JS swaps at runtime. Built inside a tag because an
        output tag would end at the first "}}".
      endcomment
      assign ph_count = '{{ count }}'
      assign ph_price = '{{ price }}'
      assign ph_amount = '{{ amount }}'
      assign ph_percent = '{{ percent }}'
    -%}
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          adding: {{ 'products.product.adding' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          lowStock: {{ 'products.product.low_stock' | t: count: ph_count | json }},
          perBag: {{ 'products.product.per_bag' | t: price: ph_price | json }},
          save: {{ 'products.product.save_amount' | t: amount: ph_amount | json }},
          savePercent: {{ 'products.product.save_percent' | t: percent: ph_percent | json }},
          cartError: {{ 'sections.cart.error' | t | json }},
          itemAdded: {{ 'sections.cart.item_added' | t | json }}
        },
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        cartType: {{ settings.cart_type | json }},
        animations: {{ settings.animations_enabled | json }}
      };
    </script>

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}-{{ template.suffix | handle }}{% endif %}{% if settings.animations_enabled %} animate{% endif %}">
    <a class="skip-to-content visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="gc-star-half" x1="0" x2="1" y1="0" y2="0">
          <stop offset="50%" stop-color="currentColor"/>
          <stop offset="50%" stop-color="transparent"/>
        </linearGradient>
      </defs>
    </svg>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- if template.name == 'index' -%}
      {% render 'sticky-cta' %}
    {%- endif -%}

    <div class="visually-hidden" aria-live="polite" role="status" id="LiveRegion"></div>

    <ul hidden>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>
  </body>
</html>
