{%- assign newsletter_fallback = 'general.newsletter_form.heading' | t -%}

<div class="newsletter section">
  <div class="container">
    <div class="newsletter__inner{% if settings.animations_enabled %} reveal{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h2 class="h2">{{ section.settings.heading | default: newsletter_fallback }}</h2>

      {%- if section.settings.text != blank -%}
        <div class="newsletter__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="Newsletter-{{ section.id }}">
          {{ 'general.newsletter_form.email_placeholder' | t }}
        </label>
        <input
          id="Newsletter-{{ section.id }}"
          class="field__input"
          type="email"
          name="contact[email]"
          placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
          autocomplete="email"
          required
        >
        <button type="submit" class="btn">{{ 'general.newsletter_form.submit' | t }}</button>

        {%- if form.errors -%}
          <p class="form__error">
            {{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}
          </p>
        {%- elsif form.posted_successfully? -%}
          <p class="form__success">{{ 'general.newsletter_form.confirmation' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "Get the drop first"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.newsletter.settings.text.label",
      "default": "<p>New releases go to the list before anywhere else.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.name"
    }
  ]
}
{% endschema %}
