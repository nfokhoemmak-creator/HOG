{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-main-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign submit_id = 'ProductSubmit-' | append: section.id
  assign size_guide_id = 'SizeGuide-' | append: section.id
  assign tiers_anchor = 'ProductTiers-' | append: section.id

  assign collection_handles = product.collections | map: 'handle'
  assign in_slippers = false
  assign in_blankets = false
  if collection_handles contains 'shark-slippers'
    assign in_slippers = true
  endif
  if collection_handles contains 'shark-blankets'
    assign in_blankets = true
  endif

  assign is_preorder = false
  if product.tags contains 'preorder'
    assign is_preorder = true
  endif

  assign whatsapp_number = settings.social_whatsapp_number | default: '' | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign whatsapp_url = 'https://wa.me/' | append: whatsapp_number

  assign tier_percent = settings.bundle_tier_percent | default: 0
  assign tier_min = settings.bundle_tier_min | default: 2
  assign threshold_cents = settings.free_shipping_threshold | default: 0 | times: 100
  assign cart_total = cart.total_price | default: 0

  comment
    Which blocks exist decides a few layout rules: the quantity input hides
    when tiers drive the quantity, the size-help line only offers the modal
    when a size_guide block renders it, and the sticky bar needs a target.
  endcomment
  assign has_quantity_block = false
  assign has_size_guide = false
  assign has_tiers = false
  assign has_sticky = false
  for block in section.blocks
    case block.type
      when 'quantity'
        assign has_quantity_block = true
      when 'size_guide'
        assign has_size_guide = true
      when 'tiers'
        if block.settings.show_tiers and in_slippers and tier_percent > 0
          assign has_tiers = true
        endif
      when 'sticky_atc'
        assign has_sticky = true
    endcase
  endfor

  assign quantity_visible = false
  if has_quantity_block and has_tiers == false
    assign quantity_visible = true
  endif

  case s.color_scheme
    when 'alt'
      assign scheme_class = ' section--alt'
    when 'brand'
      assign scheme_class = ' section--brand'
    else
      assign scheme_class = ''
  endcase

  assign pt = s.padding_top
  assign pb = s.padding_bottom
  assign pt_mobile = pt | times: 0.75 | round
  assign pb_mobile = pb | times: 0.75 | round
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .product {
    padding-top: {{ pt_mobile }}px;
    padding-bottom: {{ pb_mobile }}px;
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .product {
      padding-top: {{ pt }}px;
      padding-bottom: {{ pb }}px;
    }
  }
{%- endstyle -%}

<div class="section product{{ scheme_class }}{% if s.enable_sticky_info %} product--sticky-info{% endif %}">
  <div class="container">
    <div class="product__grid">
      <div class="product__media">
        {% render 'product-gallery', product: product, section_id: section.id, current_variant: current_variant, enable_zoom: s.enable_zoom, show_thumbnails: s.show_thumbnails %}
      </div>

      <div class="product__info">
        <product-form
          class="product__form-wrapper"
          data-section-id="{{ section.id }}"
          data-product-id="{{ product.id }}"
          data-url="{{ product.url }}"
          data-handle="{{ product.handle }}"
          {% if is_preorder %}data-preorder{% endif %}
        >
          {%- form 'product', product, id: form_id, class: 'product__form', data-type: 'add-to-cart-form' -%}
            <script type="application/json" data-variants>{{ product.variants | json }}</script>
            <script type="application/json" data-options>{{ product.options | json }}</script>

            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'rating' -%}
                  {%- liquid
                    assign reviews_anchor = block.settings.reviews_anchor | default: '#reviews'
                  -%}
                  <div class="product__rating" {{ block.shopify_attributes }}>
                    {% render 'rating', product: product, size: 'md', count_url: reviews_anchor %}
                  </div>

                {%- when 'title' -%}
                  <h1 class="product__title h2" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

                {%- when 'price' -%}
                  <div class="product__price-row" {{ block.shopify_attributes }}>
                    {% render 'price', product: product, use_variant: true, price_class: 'price--lg', data_hooks: true %}
                    {%- if block.settings.show_bundle_hint and in_slippers and tier_percent > 0 -%}
                      <span class="badge badge--accent product__hint">
                        {{ 'products.product.bundle_hint' | t: min: tier_min, percent: tier_percent }}
                      </span>
                    {%- endif -%}
                  </div>

                {%- when 'bullets' -%}
                  {%- if block.settings.text != blank -%}
                    <div class="product__bullets rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
                  {%- endif -%}

                {%- when 'variant_picker' -%}
                  {%- unless product.has_only_default_variant -%}
                    <div class="product__options" {{ block.shopify_attributes }}>
                      {%- for option in product.options_with_values -%}
                        {%- liquid
                          assign option_index = forloop.index0
                          assign option_name_down = option.name | downcase
                          assign is_style = false
                          assign is_size = false
                          if option_name_down == 'style' or option_name_down == 'color' or option_name_down == 'colour'
                            assign is_style = true
                          elsif option_name_down == 'size'
                            assign is_size = true
                          endif
                          assign option_key = section.id | append: '-option-' | append: option_index
                        -%}

                        {%- if block.settings.picker_type == 'dropdowns' -%}
                          <div class="field product-option product-option--select">
                            <label class="field__label" for="{{ option_key }}">
                              {{ option.name | escape }}:
                              <span class="product-option__value" data-selected-value data-option-index="{{ option_index }}">{{ option.selected_value | escape }}</span>
                            </label>
                            <select id="{{ option_key }}" class="select" name="options[{{ option.name | escape }}]" data-option-index="{{ option_index }}">
                              {%- for value in option.values -%}
                                <option
                                  value="{{ value.name | escape }}"
                                  data-label="{{ value.name | escape }}"
                                  {% if value.selected %}selected{% endif %}
                                  {% unless value.available %}data-unavailable{% endunless %}
                                >
                                  {{- value.name | escape -}}
                                  {%- unless value.available %} — {{ 'products.product.sold_out' | t }}{% endunless -%}
                                </option>
                              {%- endfor -%}
                            </select>
                          </div>
                        {%- else -%}
                          <fieldset class="product-option{% if is_style %} product-option--swatches{% else %} product-option--pills{% endif %}">
                            <legend class="product-option__label">
                              {{ option.name | escape }}:
                              <span class="product-option__value" data-selected-value data-option-index="{{ option_index }}">{{ option.selected_value | escape }}</span>
                            </legend>
                            <div class="option-values">
                              {%- for value in option.values -%}
                                {%- liquid
                                  assign input_id = option_key | append: '-' | append: forloop.index
                                  assign value_label = value.name
                                  unless value.available
                                    assign sold_out_label = 'products.product.sold_out' | t
                                    assign value_label = value.name | append: ' — ' | append: sold_out_label
                                  endunless
                                -%}
                                {%- if is_style -%}
                                  {%- liquid
                                    assign swatch_hex = ''
                                    if value.swatch != blank and value.swatch.color != blank
                                      assign swatch_hex = value.swatch.color
                                    else
                                      assign value_down = value.name | downcase | strip
                                      case value_down
                                        when 'pink'
                                          assign swatch_hex = '#F7A8C4'
                                        when 'grey', 'gray'
                                          assign swatch_hex = '#9AA3AD'
                                        when 'dark grey', 'dark gray'
                                          assign swatch_hex = '#4B5563'
                                        when 'blue'
                                          assign swatch_hex = '#3B82F6'
                                        when 'dark blue', 'navy'
                                          assign swatch_hex = '#1E3A8A'
                                        when 'yellow'
                                          assign swatch_hex = '#FACC15'
                                        when 'turquoise', 'teal'
                                          assign swatch_hex = '#2DD4BF'
                                        when 'red'
                                          assign swatch_hex = '#EF4444'
                                        when 'beige', 'sand'
                                          assign swatch_hex = '#E7D3B5'
                                        when 'orange'
                                          assign swatch_hex = '#FB923C'
                                        when 'green'
                                          assign swatch_hex = '#22C55E'
                                        else
                                          assign swatch_hex = '#CBD5E1'
                                      endcase
                                    endif
                                  -%}
                                  <label
                                    class="swatch{% if value.selected %} is-selected{% endif %}{% unless value.available %} is-unavailable{% endunless %}"
                                    for="{{ input_id }}"
                                    style="--swatch-color: {{ swatch_hex }};"
                                    title="{{ value_label | escape }}"
                                  >
                                    <input
                                      type="radio"
                                      id="{{ input_id }}"
                                      name="options[{{ option.name | escape }}]"
                                      value="{{ value.name | escape }}"
                                      data-option-index="{{ option_index }}"
                                      aria-label="{{ value_label | escape }}"
                                      {% if value.selected %}checked{% endif %}
                                      {% unless value.available %}data-unavailable{% endunless %}
                                    >
                                    <span class="swatch__color" aria-hidden="true"></span>
                                  </label>
                                {%- else -%}
                                  <label
                                    class="size-pill{% if value.selected %} is-selected{% endif %}{% unless value.available %} is-unavailable{% endunless %}"
                                    for="{{ input_id }}"
                                  >
                                    <input
                                      type="radio"
                                      id="{{ input_id }}"
                                      name="options[{{ option.name | escape }}]"
                                      value="{{ value.name | escape }}"
                                      data-option-index="{{ option_index }}"
                                      aria-label="{{ value_label | escape }}"
                                      {% if value.selected %}checked{% endif %}
                                      {% unless value.available %}data-unavailable{% endunless %}
                                    >
                                    <span aria-hidden="true">{{ value.name | escape }}</span>
                                  </label>
                                {%- endif -%}
                              {%- endfor -%}
                            </div>
                          </fieldset>
                        {%- endif -%}

                        {%- if is_size and block.settings.show_size_help -%}
                          <p class="product-option__help small">
                            <span class="muted">{{ 'products.product.size_help' | t }}</span>
                            {%- if has_size_guide -%}
                              <button type="button" class="product-option__link" data-modal-open="{{ size_guide_id }}">
                                {% render 'icon', name: 'ruler' %}
                                {{ 'products.product.size_guide' | t }}
                              </button>
                            {%- else -%}
                              <a class="product-option__link" href="/pages/winter-size-chart">
                                {% render 'icon', name: 'ruler' %}
                                {{ 'products.product.size_guide' | t }}
                              </a>
                            {%- endif -%}
                            {%- if whatsapp_number != blank -%}
                              <a class="product-option__link" href="{{ whatsapp_url }}" target="_blank" rel="noopener">
                                {% render 'icon', name: 'whatsapp' %}
                                {{ 'products.product.ask_whatsapp' | t }}
                                <span class="visually-hidden">{{ 'general.new_window' | t }}</span>
                              </a>
                            {%- endif -%}
                          </p>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endunless -%}

                {%- when 'size_guide' -%}
                  <div class="product__size-guide" {{ block.shopify_attributes }}>
                    <button type="button" class="btn btn--ghost btn--sm product__size-guide-btn" data-modal-open="{{ size_guide_id }}">
                      {% render 'icon', name: 'ruler' %}
                      {{ 'products.product.size_guide' | t }}
                    </button>
                  </div>

                {%- when 'tiers' -%}
                  {%- if has_tiers -%}
                    <div class="product__tiers" {{ block.shopify_attributes }}>
                      {% render 'product-tiers', product: product, current_variant: current_variant, section_id: section.id, form_id: form_id, block: block %}
                    </div>
                  {%- endif -%}

                {%- when 'quantity' -%}
                  {%- if quantity_visible -%}
                    <div class="product__quantity field" {{ block.shopify_attributes }}>
                      <label class="field__label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                      <quantity-input class="quantity-input">
                        <button type="button" data-action="decrease" aria-label="{{ 'products.product.decrease' | t | escape }}">
                          {% render 'icon', name: 'minus' %}
                        </button>
                        <input
                          id="Quantity-{{ section.id }}"
                          type="number"
                          inputmode="numeric"
                          name="quantity"
                          value="1"
                          min="1"
                        >
                        <button type="button" data-action="increase" aria-label="{{ 'products.product.increase' | t | escape }}">
                          {% render 'icon', name: 'plus' %}
                        </button>
                      </quantity-input>
                    </div>
                  {%- endif -%}

                {%- when 'buy_buttons' -%}
                  <div class="product__buy" {{ block.shopify_attributes }}>
                    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                    {%- unless quantity_visible -%}
                      <input type="hidden" name="quantity" value="1" min="1">
                    {%- endunless -%}

                    <button
                      type="submit"
                      id="{{ submit_id }}"
                      class="btn btn--lg btn--full product__add"
                      data-add-button
                      {% if is_preorder %}data-preorder{% endif %}
                      {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
                    >
                      <span data-add-text>
                        {%- if current_variant.available -%}
                          {%- if is_preorder -%}
                            {{ 'products.product.preorder' | t }}
                          {%- else -%}
                            {{ 'products.product.add_to_cart' | t }}
                          {%- endif -%}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </span>
                    </button>

                    {%- if block.settings.show_dynamic_checkout -%}
                      <div class="product__payment-button">
                        {{ form | payment_button }}
                      </div>
                    {%- endif -%}

                    <p class="small muted product__availability" data-availability hidden></p>
                    <p class="small product__stock" data-low-stock hidden></p>
                    <p class="form__error product__error" data-form-error role="alert" hidden></p>
                  </div>

                {%- when 'free_shipping' -%}
                  {%- if threshold_cents > 0 -%}
                    {%- liquid
                      assign ship_price = current_variant.price | default: product.price
                      assign ship_qty = 1
                      assign ship_line = ship_price | times: ship_qty
                      assign ship_projected = cart_total | plus: ship_line
                      assign threshold_money = threshold_cents | money_without_trailing_zeros
                      assign ship_qualifies = false
                      if ship_projected >= threshold_cents
                        assign ship_qualifies = true
                      else
                        assign ship_away = threshold_cents | minus: ship_projected
                        assign ship_away_money = ship_away | money_without_trailing_zeros
                      endif

                      assign qualifies_text = 'products.product.free_shipping_qualifies' | t: amount: threshold_money
                      if in_slippers and tier_percent > 0
                        assign needs_template = 'products.product.free_shipping_needs' | t: amount: '[amount]', percent: tier_percent
                      else
                        assign needs_template = 'bundles.free_shipping_away' | t: amount: '[amount]'
                      endif
                      assign needs_parts = needs_template | split: ' — '
                      assign needs_head = needs_parts[0]
                      assign needs_tail = ''
                      if needs_parts.size > 1 and has_tiers
                        assign needs_tail = needs_parts[1]
                      endif
                      if ship_qualifies == false
                        assign needs_head_text = needs_head | replace: '[amount]', ship_away_money
                      endif
                    -%}
                    <product-ship-note
                      class="ship-bar ship-bar--compact ship-bar--boxed product__shipping{% if ship_qualifies %} ship-bar--unlocked{% endif %}"
                      data-section-id="{{ section.id }}"
                      data-threshold="{{ threshold_cents }}"
                      data-cart-total="{{ cart_total }}"
                      data-price="{{ ship_price }}"
                      data-quantity="{{ ship_qty }}"
                      data-percent="{% if in_slippers %}{{ tier_percent }}{% else %}0{% endif %}"
                      data-min="{{ tier_min }}"
                      data-qualifies-text="{{ qualifies_text | escape }}"
                      data-needs-template="{{ needs_template | escape }}"
                      data-tiers-anchor="{% if has_tiers %}#{{ tiers_anchor }}{% endif %}"
                      aria-live="polite"
                      {{ block.shopify_attributes }}
                    >
                      <p class="ship-bar__text">
                        <span class="product__shipping-icon" data-ship-icon="check"{% unless ship_qualifies %} hidden{% endunless %}>{% render 'icon', name: 'check' %}</span>
                        <span class="product__shipping-icon" data-ship-icon="truck"{% if ship_qualifies %} hidden{% endif %}>{% render 'icon', name: 'truck' %}</span>
                        {%- if ship_qualifies -%}
                          <span data-ship-text>{{ qualifies_text }}</span>
                        {%- else -%}
                          <span data-ship-text>
                            {{- needs_head_text -}}
                            {%- if needs_tail != blank %} — <a href="#{{ tiers_anchor }}" data-ship-tiers-link>{{ needs_tail }}</a>{% endif -%}
                          </span>
                        {%- endif -%}
                      </p>
                    </product-ship-note>
                  {%- endif -%}

                {%- when 'trust' -%}
                  <div class="product__trust" {{ block.shopify_attributes }}>
                    {% render 'product-trust', block: block, whatsapp_number: whatsapp_number %}
                  </div>

                {%- when 'text' -%}
                  {%- if block.settings.text != blank -%}
                    <div class="product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          {%- endform -%}
        </product-form>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <product-description
                  class="product__description{% if block.settings.collapse %} product__description--collapsible{% endif %}"
                  {% if block.settings.collapse %}data-collapse{% endif %}
                  {{ block.shopify_attributes }}
                >
                  <h2 class="product__description-title h5">{{ 'products.product.description' | t }}</h2>
                  <div class="product__description-body rte" data-description-body>{{ product.description }}</div>
                  <button type="button" class="product__description-toggle" data-description-toggle aria-expanded="false" hidden>
                    <span data-description-toggle-text data-more="{{ 'products.product.read_more' | t | escape }}" data-less="{{ 'products.product.read_less' | t | escape }}">{{ 'products.product.read_more' | t }}</span>
                    {% render 'icon', name: 'chevron-down' %}
                  </button>
                </product-description>
              {%- endif -%}

            {%- when 'accordion' -%}
              {%- liquid
                assign accordion_content = ''
                if block.settings.metafield != blank
                  assign mf_parts = block.settings.metafield | split: '.'
                  if mf_parts.size == 2
                    assign mf_namespace = mf_parts[0] | strip
                    assign mf_key = mf_parts[1] | strip
                    assign mf_field = product.metafields[mf_namespace][mf_key]
                    if mf_field != blank
                      assign accordion_content = mf_field | metafield_tag
                    endif
                  endif
                endif
                if accordion_content == blank
                  assign accordion_content = block.settings.content
                endif
              -%}
              {%- if accordion_content != blank and block.settings.heading != blank -%}
                <details class="accordion product__accordion" {{ block.shopify_attributes }}{% if block.settings.open_by_default %} open{% endif %}>
                  <summary>
                    <span>{{ block.settings.heading | escape }}</span>
                    {% render 'icon', name: 'chevron-down' %}
                  </summary>
                  <div class="accordion__content rte">{{ accordion_content }}</div>
                </details>
              {%- endif -%}

            {%- when 'complementary' -%}
              {%- liquid
                assign companion = block.settings.product
                if companion == blank
                  if in_blankets
                    assign companion = collections['shark-slippers'].products[0]
                  else
                    assign companion = collections['shark-blankets'].products[0]
                  endif
                endif
              -%}
              {%- if companion != blank and companion.id != product.id -%}
                <div class="product__complementary" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h2 class="product__complementary-title h5">
                      {% render 'icon', name: 'gift' %}
                      {{ block.settings.heading | escape }}
                    </h2>
                  {%- endif -%}
                  {% render 'bundle-companion', companion: companion, section_id: section.id, text: block.settings.text %}
                </div>
              {%- endif -%}

            {%- when 'share' -%}
              {%- liquid
                assign share_url = request.origin | append: product.url
                assign share_text = product.title | append: ' ' | append: share_url
              -%}
              <div class="product__share" {{ block.shopify_attributes }}>
                <span class="small muted product__share-label">{{ 'products.product.share' | t }}</span>
                <a class="btn btn--ghost btn--sm" href="https://wa.me/?text={{ share_text | url_encode }}" target="_blank" rel="noopener">
                  {% render 'icon', name: 'whatsapp' %}
                  {{ 'products.product.share_whatsapp' | t }}
                  <span class="visually-hidden">{{ 'general.new_window' | t }}</span>
                </a>
                <button
                  type="button"
                  class="btn btn--ghost btn--sm"
                  data-copy-link="{{ share_url | escape }}"
                  data-copied-text="{{ 'products.product.link_copied' | t | escape }}"
                >
                  {% render 'icon', name: 'refresh' %}
                  <span data-copy-link-text>{{ 'products.product.copy_link' | t }}</span>
                </button>
              </div>

            {%- when '@app' -%}
              <div class="product__app" {{ block.shopify_attributes }}>
                {% render block %}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'size_guide' -%}
      {% render 'size-guide-modal', section_id: section.id, block: block, whatsapp_number: whatsapp_number %}
    {%- endif -%}
  {%- endfor -%}
</div>

{%- if has_sticky -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'sticky_atc' -%}
      {%- liquid
        assign sticky_image = current_variant.featured_image | default: product.featured_image
      -%}
      <sticky-atc
        class="sticky-atc"
        data-form="{{ form_id }}"
        data-observe="#{{ submit_id }}"
        data-section-id="{{ section.id }}"
        aria-hidden="true"
        {{ block.shopify_attributes }}
      >
        <div class="container sticky-atc__inner">
          {%- if sticky_image -%}
            <img
              class="sticky-atc__image"
              src="{{ sticky_image | image_url: width: 160 }}"
              alt="{{ sticky_image.alt | default: product.title | escape }}"
              width="64"
              height="64"
              loading="lazy"
              data-sticky-image
            >
          {%- endif -%}
          <div class="sticky-atc__info">
            <span class="sticky-atc__title" data-sticky-title data-product-title="{{ product.title | escape }}">{{ product.title | escape }}</span>
            <span class="sticky-atc__price price">
              <span class="price__current" data-sticky-price>{{ current_variant.price | money }}</span>
              <s class="price__compare" data-sticky-compare{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>
                {%- if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money }}{% endif -%}
              </s>
            </span>
          </div>
          <button type="button" class="btn sticky-atc__button" data-sticky-button{% unless current_variant.available %} disabled{% endunless %}>
            <span data-sticky-button-text>
              {%- if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif -%}
            </span>
          </button>
        </div>
      </sticky-atc>
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- liquid
  assign ld_rating_count = 0
  assign ld_rating_value = blank
  assign ld_rating_max = 5
  if settings.structured_data_rating
    assign ld_mf = product.metafields.reviews.rating.value
    if ld_mf.rating != blank
      assign ld_rating_value = ld_mf.rating
    elsif ld_mf.value != blank
      assign ld_rating_value = ld_mf.value
    endif
    if ld_mf.scale_max != blank
      assign ld_rating_max = ld_mf.scale_max
    endif
    assign ld_rating_count = product.metafields.reviews.rating_count.value | default: 0 | times: 1
  endif
  assign ld_images = product.media | where: 'media_type', 'image'
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    "image": [
      {%- for media in ld_images -%}
        {{ media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "description": {{ product.description | strip_html | strip_newlines | truncate: 500 | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | default: shop.name | json }}
    },
    {%- if current_variant.sku != blank -%}
      "sku": {{ current_variant.sku | json }},
    {%- endif -%}
    {%- if ld_rating_value != blank and ld_rating_count > 0 -%}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ ld_rating_value | json }},
        "bestRating": {{ ld_rating_max | json }},
        "reviewCount": {{ ld_rating_count | json }}
      },
    {%- endif -%}
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "url": {{ request.origin | append: variant.url | json }},
          "name": {{ variant.title | json }},
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "itemCondition": "https://schema.org/NewCondition",
          "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

