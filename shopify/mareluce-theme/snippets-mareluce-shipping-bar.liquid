{%- doc -%}
  Free shipping progress bar for the cart drawer.
  The threshold below is in the store currency and must match the "Free shipping" rates in Settings > Shipping and delivery.
{%- enddoc -%}
{%- liquid
  assign threshold = 120
  assign show_bar = false
  if threshold > 0 and cart.item_count > 0
    assign show_bar = true
    assign threshold_cents = threshold | times: 100
    assign remaining = threshold_cents | minus: cart.total_price
    assign progress = cart.total_price | times: 100 | divided_by: threshold_cents
    if progress > 100
      assign progress = 100
    endif
  endif
-%}
{%- if show_bar -%}
  <div class="ml-ship" role="status" aria-live="polite">
    <p class="ml-ship__text">
      {%- if remaining > 0 -%}
        You are <strong>{{ remaining | money }}</strong> away from free shipping.
      {%- else -%}
        <strong>Free shipping unlocked.</strong> It is applied at checkout.
      {%- endif -%}
    </p>
    <div class="ml-ship__track" aria-hidden="true">
      <div class="ml-ship__fill" style="width: {{ progress }}%;"></div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .ml-ship {
    padding: var(--padding-sm) var(--cart-drawer-padding, var(--padding-lg)) var(--padding-xs);
  }

  .ml-ship__text {
    margin: 0 0 var(--margin-xs);
    font-size: var(--font-size--sm);
    color: var(--color-foreground);
  }

  .ml-ship__track {
    height: 4px;
    border-radius: 2px;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.12);
  }

  .ml-ship__fill {
    height: 100%;
    background: #E58C74;
    transition: width 0.4s ease;
  }
{% endstylesheet %}
