<section class="section">
  <div class="container container--narrow">
    <div class="auth-card">
      <h1 class="h2" style="margin-bottom: var(--space-5);">{{ 'customer.login_page.title' | t }}</h1>

      {%- form 'customer_login', novalidate: 'novalidate', class: 'form' -%}
        {%- if form.errors -%}
          <div class="form__error" role="alert">
            {% render 'icon', name: 'info' %}
            <div>{{ form.errors | default_errors }}</div>
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
          <input class="field__input" type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        </div>

        {%- if form.password_needed -%}
          <div class="field">
            <label class="field__label" for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
            <input class="field__input" type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password">
            <a class="field__hint underline" href="#recover">{{ 'customer.login_page.forgot_password' | t }}</a>
          </div>
        {%- endif -%}

        <button type="submit" class="btn btn--full">{{ 'customer.login_page.sign_in' | t }}</button>
      {%- endform -%}

      {%- if shop.checkout.guest_login -%}
        <div class="auth-card__footer">
          <h2 class="h5" style="margin-bottom: var(--space-2);">{{ 'customer.login_page.guest_title' | t }}</h2>
          {%- form 'guest_login' -%}
            <button type="submit" class="btn btn--outline btn--sm">{{ 'customer.login_page.guest_continue' | t }}</button>
          {%- endform -%}
        </div>
      {%- endif -%}

      <p class="auth-card__footer">
        {{ 'customer.register.title' | t }}?
        <a class="underline" href="{{ routes.account_register_url }}">{{ 'customer.login_page.create_account' | t }}</a>
      </p>
    </div>

    <div class="auth-card" id="recover" style="margin-top: var(--space-5);">
      <h2 class="h4" style="margin-bottom: var(--space-2);">{{ 'customer.recover_password.title' | t }}</h2>
      <p class="auth-card__intro">{{ 'customer.recover_password.subtext' | t }}</p>

      {%- form 'recover_customer_password', class: 'form' -%}
        {%- if form.posted_successfully? -%}
          <div class="form__success" role="status">
            {% render 'icon', name: 'check' %}
            <div>{{ 'customer.recover_password.success' | t }}</div>
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="form__error" role="alert">
            {% render 'icon', name: 'info' %}
            <div>{{ form.errors | default_errors }}</div>
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
          <input class="field__input" type="email" id="RecoverEmail" name="email" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        </div>

        <div class="btn-row">
          <button type="submit" class="btn btn--secondary">{{ 'customer.recover_password.submit' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>
