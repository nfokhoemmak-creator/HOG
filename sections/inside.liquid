{%- liquid
  assign product = settings.featured_product
  assign image = section.settings.image
  if image == blank and product != blank
    assign image = product.images[1] | default: product.featured_image
  endif
-%}

<section class="section" id="{{ section.settings.anchor | default: 'inside' }}">
  <div class="container">
    <div class="split{% if section.settings.layout == 'right' %} split--reverse{% endif %}">
      <div class="split__media split__media--contain reveal reveal--scale">
        {%- if section.settings.badge != blank -%}<span class="badge badge--green">{{ section.settings.badge | escape }}</span>{%- endif -%}
        {%- if image != blank -%}
          <img
            src="{{ image | image_url: width: 1000 }}"
            srcset="{{ image | image_url: width: 500 }} 500w, {{ image | image_url: width: 1000 }} 1000w"
            sizes="(min-width: 990px) 45vw, 90vw"
            alt="{{ image.alt | escape }}"
            width="{{ image.width }}"
            height="{{ image.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="lead muted">{{ section.settings.text | escape }}</p>{%- endif -%}

        <ul class="ingredient-list">
          {%- for block in section.blocks -%}
            <li class="ingredient" {{ block.shopify_attributes }}>
              <div class="ingredient__icon">{% render 'icon', name: block.settings.icon %}</div>
              <div>
                <h4>{{ block.settings.title | escape }}</h4>
                <p>{{ block.settings.text | escape }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.panel != blank -%}
          <details class="accordion" style="margin-top: var(--space-5);">
            <summary>{{ section.settings.panel_heading | escape }}<span class="accordion__icon">{% render 'icon', name: 'plus' %}</span></summary>
            <div class="accordion__content rte">{{ section.settings.panel }}</div>
          </details>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "What's inside",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "inside" },
    { "type": "select", "id": "layout", "label": "Image position", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the product's second image." },
    { "type": "text", "id": "badge", "label": "Image badge", "default": "120 soft chews" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What makes them the goodest" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built like a supplement. Loved like a treat." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every chew is soft, treat-shaped and made to be looked forward to — so the healthy habit actually sticks." },
    { "type": "text", "id": "panel_heading", "label": "Ingredient panel heading", "default": "Full ingredients & guaranteed analysis" },
    { "type": "richtext", "id": "panel", "label": "Ingredient panel", "info": "Paste the ingredient list and guaranteed analysis from the bag. Hidden while empty." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "paw", "label": "Paw" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "award", "label": "Award" },
            { "value": "shield-check", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "package", "label": "Package" },
            { "value": "badge-check", "label": "Verified" }
          ],
          "default": "paw"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "8 benefits in every chew" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Joints, heart, skin & coat, digestion, immunity, liver, antioxidants and energy." }
      ]
    }
  ],
  "presets": [{ "name": "What's inside" }]
}
{% endschema %}
