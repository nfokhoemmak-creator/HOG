{%- liquid
  assign scheme_class = ''
  case section.settings.color_scheme
    when 'orange'
      assign scheme_class = 'announcement-bar--orange'
    when 'cream'
      assign scheme_class = 'announcement-bar--cream'
  endcase
-%}

{%- if section.blocks.size > 0 -%}
  <announcement-rotator
    class="announcement-bar {{ scheme_class }}"
    data-speed="{{ section.settings.rotate_speed }}"
    {% unless section.settings.rotate %}data-static{% endunless %}
    role="region"
    aria-label="{{ 'sections.announcements.announcement' | t }}"
  >
    <div class="container announcement-bar__inner">
      {%- for block in section.blocks -%}
        <div
          class="announcement-bar__item"
          {% if forloop.index > 1 and section.settings.rotate %}hidden{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.icon != 'none' -%}
            {% render 'icon', name: block.settings.icon %}
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            <span>{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </announcement-rotator>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "aside",
  "class": "announcement-bar-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour",
      "options": [
        { "value": "green", "label": "Green" },
        { "value": "orange", "label": "Orange" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "green"
    },
    { "type": "checkbox", "id": "rotate", "label": "Rotate messages", "default": true },
    { "type": "range", "id": "rotate_speed", "min": 3, "max": 12, "step": 1, "unit": "s", "label": "Seconds per message", "default": 5 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "60-day Happy Dog Guarantee — if they don't love it, we refund you" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "paw", "label": "Paw" },
            { "value": "shield-check", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "star", "label": "Star" },
            { "value": "tag", "label": "Tag" },
            { "value": "award", "label": "Award" }
          ],
          "default": "paw"
        },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ]
}
{% endschema %}
