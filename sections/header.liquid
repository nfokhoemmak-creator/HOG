{%- liquid
  assign product = settings.featured_product
  assign cta_link = section.settings.cta_link
  if cta_link == blank
    if request.page_type == 'index'
      assign cta_link = '#bundles'
    elsif product != blank
      assign cta_link = product.url
    else
      assign cta_link = routes.all_products_collection_url
    endif
  endif
-%}

<header class="header">
  <div class="container header__inner">
    <menu-drawer class="menu-toggle">
      <button
        type="button"
        class="header__icon"
        data-menu-open
        aria-expanded="false"
        aria-controls="MenuDrawer"
        aria-label="{{ 'general.menu' | t }}"
      >
        {% render 'icon', name: 'menu' %}
      </button>

      <div class="menu-drawer" id="MenuDrawer" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}">
        <div class="menu-drawer__panel">
          <div class="menu-drawer__head">
            <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{% render 'logo', size: 22 %}</a>
            <button type="button" class="header__icon" data-menu-close aria-label="{{ 'general.close' | t }}">
              {% render 'icon', name: 'close' %}
            </button>
          </div>

          <nav class="menu-drawer__list" aria-label="{{ 'general.menu' | t }}">
            {%- for block in section.blocks -%}
              {%- liquid
                assign href = block.settings.url
                assign first_char = href | slice: 0
                if first_char == '#' and request.page_type != 'index'
                  assign href = routes.root_url | append: href
                endif
              -%}
              <a href="{{ href }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
            {%- endfor -%}
          </nav>

          <div class="menu-drawer__foot">
            <a class="btn btn--full" href="{{ cta_link }}">{{ section.settings.cta_label | escape }}</a>
            <p class="small muted text-center">{{ settings.guarantee_days }}-{{ 'general.day' | t }} {{ settings.guarantee_title }} · {{ settings.shipping_short }}</p>
          </div>
        </div>
      </div>
    </menu-drawer>

    {%- if request.page_type == 'index' -%}
      <h1 class="header__logo">
    {%- else -%}
      <div class="header__logo">
    {%- endif -%}
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {% render 'logo', size: 28 %}
      </a>
    {%- if request.page_type == 'index' -%}
      </h1>
    {%- else -%}
      </div>
    {%- endif -%}

    <nav class="header__nav" aria-label="{{ 'general.menu' | t }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign href = block.settings.url
          assign first_char = href | slice: 0
          if first_char == '#' and request.page_type != 'index'
            assign href = routes.root_url | append: href
          endif
        -%}
        <a href="{{ href }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
      {%- endfor -%}
    </nav>

    <div class="header__actions">
      {%- if section.settings.show_search -%}
        <a class="header__icon" href="{{ routes.search_url }}" aria-label="{{ 'general.search.search' | t }}">
          {% render 'icon', name: 'search' %}
        </a>
      {%- endif -%}

      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a
          class="header__icon"
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          aria-label="{{ 'general.account' | t }}"
        >
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}

      <a
        class="header__icon"
        href="{{ routes.cart_url }}"
        aria-label="{{ 'general.cart' | t }}"
        {% if settings.cart_type == 'drawer' %}data-cart-trigger{% endif %}
      >
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>
          {{- cart.item_count -}}
        </span>
      </a>

      {%- if section.settings.cta_label != blank -%}
        <a class="btn btn--sm header__cta" href="{{ cta_link }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</header>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | append: routes.root_url | json }},
    {%- if settings.logo -%}
      "logo": {{ settings.logo | image_url: width: 600 | prepend: "https:" | json }},
    {%- endif -%}
    {%- if settings.social_instagram_link != blank -%}
      "sameAs": [{{ settings.social_instagram_link | json }}],
    {%- endif -%}
    "description": {{ shop.description | default: settings.brand_tagline | json }}
  }
</script>

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "class": "header-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave empty to send visitors to the bundles on the homepage, or to the product page elsewhere." },
    { "type": "checkbox", "id": "show_search", "label": "Show search icon", "default": false },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": false }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Navigation link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Benefits" },
        { "type": "text", "id": "url", "label": "Link", "default": "#benefits", "info": "Use #benefits, #bundles, #reviews or #faq to jump to a homepage section, or any page URL." }
      ]
    }
  ]
}
{% endschema %}
