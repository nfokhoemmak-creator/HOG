<article class="container container--narrow page-content">
  <p class="article__meta">{{ article.published_at | date: '%b %d, %Y' }}{% if article.author != blank %} · {{ 'sections.article.by_author' | t: author: article.author }}{% endif %}</p>
  <h1>{{ article.title | escape }}</h1>
  {%- if article.image -%}
    <div class="article__image">
      <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.image.alt | escape }}" width="{{ article.image.width }}" height="{{ article.image.height }}">
    </div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p style="margin-top: var(--space-6);"><a class="link-arrow" href="{{ blog.url }}">{% render 'icon', name: 'arrow-left' %}{{ 'sections.article.back_to_blog' | t: title: blog.title }}</a></p>
</article>

{% schema %}
{
  "name": "Article",
  "tag": "section",
  "settings": []
}
{% endschema %}
