{{ 'section-main-contact.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme_class = ''
  if section.settings.color_scheme != blank and section.settings.color_scheme != 'default'
    assign scheme_class = ' section--' | append: section.settings.color_scheme
  endif
  assign padding_mobile_top = section.settings.padding_top | times: 0.75 | round
  assign padding_mobile_bottom = section.settings.padding_bottom | times: 0.75 | round

  assign whatsapp_number = settings.social_whatsapp_number | replace: ' ', '' | replace: '+', '' | replace: '-', ''
  assign whatsapp_display = section.settings.whatsapp_display
  if whatsapp_display == blank and whatsapp_number != blank
    assign whatsapp_display = whatsapp_number | prepend: '+'
  endif
  assign whatsapp_message = section.settings.whatsapp_prefill | url_encode
  assign whatsapp_url = 'https://wa.me/' | append: whatsapp_number
  if whatsapp_message != blank
    assign whatsapp_url = whatsapp_url | append: '?text=' | append: whatsapp_message
  endif

  assign contact_email = section.settings.contact_email | strip
  assign form_id = 'ContactForm-' | append: section.id
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .contact {
    padding-top: {{ padding_mobile_top }}px;
    padding-bottom: {{ padding_mobile_bottom }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .contact {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="contact section{{ scheme_class }}">
  <div class="container">
    <header class="page-header contact__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">
          {% render 'icon', name: 'shark' %}
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}
      <h1 class="h1">{{ section.settings.heading | default: page.title | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="lead muted rte contact__intro">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>

    <div class="contact__layout">
      <div class="contact__form-col">
        {%- form 'contact', id: form_id, class: 'form contact__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="form__success contact__status" role="status" tabindex="-1" autofocus>
              {% render 'icon', name: 'check' %}
              <p>{{ 'contact.success' | t }}</p>
            </div>
          {%- elsif form.errors -%}
            <div class="form__error contact__status" role="alert" tabindex="-1" autofocus>
              {% render 'icon', name: 'info' %}
              <div>
                <p>{{ 'contact.error' | t }}</p>
                <ul>
                  {%- for field in form.errors -%}
                    <li>
                      {%- if field == 'form' -%}
                        {{ form.errors.messages[field] }}
                      {%- else -%}
                        <a href="#ContactForm-{{ field }}-{{ section.id }}" class="underline">{{ form.errors.translated_fields[field] | capitalize }}</a>
                        {{ form.errors.messages[field] }}
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          {%- endif -%}

          <div class="form__row">
            <div class="field">
              <label class="field__label" for="ContactForm-name-{{ section.id }}">{{ 'contact.name' | t }}</label>
              <input
                class="field__input"
                type="text"
                id="ContactForm-name-{{ section.id }}"
                name="contact[name]"
                autocomplete="name"
                value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
                required
              >
            </div>

            <div class="field">
              <label class="field__label" for="ContactForm-email-{{ section.id }}">{{ 'contact.email' | t }}</label>
              <input
                class="field__input"
                type="email"
                id="ContactForm-email-{{ section.id }}"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
                {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="ContactForm-email-error-{{ section.id }}"{% endif %}
                required
              >
              {%- if form.errors contains 'email' -%}
                <p class="field__hint form__error" id="ContactForm-email-error-{{ section.id }}">
                  {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="ContactForm-phone-{{ section.id }}">
              {{ 'contact.phone' | t }}
              <span class="muted">({{ 'general.optional' | t | downcase }})</span>
            </label>
            <input
              class="field__input"
              type="tel"
              id="ContactForm-phone-{{ section.id }}"
              name="contact[phone]"
              autocomplete="tel"
              inputmode="tel"
              pattern="[0-9\-+ ()]*"
              value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"
            >
          </div>

          <div class="field">
            <label class="field__label" for="ContactForm-body-{{ section.id }}">{{ 'contact.message' | t }}</label>
            <textarea
              class="field__input textarea"
              id="ContactForm-body-{{ section.id }}"
              name="contact[body]"
              rows="6"
              required
            >{{- form.body -}}</textarea>
          </div>

          <div class="contact__submit">
            <button type="submit" class="btn btn--lg btn--full">{{ 'contact.send' | t }}</button>
          </div>
        {%- endform -%}
      </div>

      <aside class="contact__aside">
        {%- if whatsapp_number != blank -%}
          <div class="card card--padded card--flat contact-card contact-card--whatsapp">
            <span class="contact-card__icon" aria-hidden="true">{% render 'icon', name: 'whatsapp' %}</span>
            <h2 class="h4 contact-card__title">{{ 'contact.whatsapp_title' | t }}</h2>
            {%- if section.settings.whatsapp_text != blank -%}
              <p class="contact-card__text">{{ section.settings.whatsapp_text | escape }}</p>
            {%- endif -%}
            <p class="contact-card__value">{{ whatsapp_display | escape }}</p>
            <a class="btn btn--secondary btn--full" href="{{ whatsapp_url }}" target="_blank" rel="noopener">
              {% render 'icon', name: 'whatsapp' %}
              {{ 'general.whatsapp_cta' | t }}
              <span class="visually-hidden">({{ 'general.new_window' | t }})</span>
            </a>
          </div>
        {%- endif -%}

        {%- if contact_email != blank -%}
          <div class="card card--padded card--flat contact-card">
            <span class="contact-card__icon" aria-hidden="true">{% render 'icon', name: 'info' %}</span>
            <h2 class="h4 contact-card__title">{{ 'contact.email_title' | t }}</h2>
            {%- if section.settings.email_text != blank -%}
              <p class="contact-card__text">{{ section.settings.email_text | escape }}</p>
            {%- endif -%}
            <a class="contact-card__value underline" href="mailto:{{ contact_email }}">{{ contact_email }}</a>
          </div>
        {%- endif -%}

        {%- if section.settings.response_time != blank -%}
          <div class="card card--padded card--flat contact-card contact-card--hours">
            <span class="contact-card__icon" aria-hidden="true">{% render 'icon', name: 'refresh' %}</span>
            <p class="contact-card__text">{{ section.settings.response_time | escape }}</p>
          </div>
        {%- endif -%}

        {%- if section.settings.show_trust -%}
          <ul class="trust-row contact__trust" role="list">
            <li class="trust-row__item">
              {% render 'icon', name: 'truck' %}
              <span>{{ section.settings.trust_delivery | escape }}</span>
            </li>
            <li class="trust-row__item">
              {% render 'icon', name: 'shield' %}
              <span>{{ section.settings.trust_replacement | escape }}</span>
            </li>
          </ul>
        {%- endif -%}
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact page",
  "tag": "section",
  "class": "section-main-contact",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "We're all ears (and fins)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the page title.",
      "default": "Say hi"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>Sizing questions, order updates, gift ideas — send it over. WhatsApp is the quickest way to reach us.</p>"
    },
    {
      "type": "header",
      "content": "WhatsApp card",
      "info": "The number comes from Theme settings > Social > WhatsApp number."
    },
    {
      "type": "text",
      "id": "whatsapp_display",
      "label": "Number as displayed",
      "default": "+961 71 801 588"
    },
    {
      "type": "text",
      "id": "whatsapp_text",
      "label": "Text",
      "default": "Send us a message and a real person replies — sizing help, order updates, anything."
    },
    {
      "type": "text",
      "id": "whatsapp_prefill",
      "label": "Pre-filled message",
      "default": "Hi Shark Bite! I have a question about"
    },
    {
      "type": "header",
      "content": "Email card"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email address",
      "default": "sharkbitee.lb@gmail.com"
    },
    {
      "type": "text",
      "id": "email_text",
      "label": "Text",
      "default": "Prefer email? Write to us and we'll get back to you."
    },
    {
      "type": "text",
      "id": "response_time",
      "label": "Reply time or opening hours",
      "info": "Hidden when blank. Only add a promise you actually keep, e.g. \"We reply within one business day\"."
    },
    {
      "type": "header",
      "content": "Trust line"
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust line",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_delivery",
      "label": "Delivery line",
      "default": "Delivery across Lebanon · standard 3–5 days ($3, free over $30)"
    },
    {
      "type": "text",
      "id": "trust_replacement",
      "label": "Replacement line",
      "default": "Damaged on arrival? Replaced within 7 days"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Soft aqua" },
        { "value": "brand", "label": "Navy" }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
