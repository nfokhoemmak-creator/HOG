{%- liquid
  assign video_src = section.settings.video_url
  if video_src == blank
    assign video_src = 'bahrati-film.mp4' | asset_url
  endif
  if section.settings.poster != blank
    assign poster_src = section.settings.poster | image_url: width: 1800
  else
    assign poster_src = 'bahrati-film-poster.jpg' | asset_url
  endif
-%}

<section class="bhr-film bhr-film--{{ section.settings.height }}">
  <video class="bhr-film__video" autoplay muted loop playsinline preload="metadata" poster="{{ poster_src }}">
    <source src="{{ video_src }}" type="video/mp4">
  </video>

  <div class="bhr-film__overlay">
    {%- if section.settings.eyebrow != blank -%}
      <p class="bhr-film__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="bhr-film__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn bhr-film__btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

<style>
  .bhr-film { position: relative; overflow: hidden; background: #14110d; }
  .bhr-film--medium { height: min(70vh, 640px); min-height: 420px; }
  .bhr-film--large { height: min(86vh, 780px); min-height: 520px; }
  .bhr-film__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.92; }
  .bhr-film::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(20, 17, 13, 0.28) 0%, rgba(20, 17, 13, 0.05) 45%, rgba(20, 17, 13, 0.55) 100%);
  }
  .bhr-film__overlay {
    position: absolute; inset: 0; z-index: 2;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
    text-align: center; padding: var(--space-8) var(--gutter); color: #fbfaf7;
  }
  .bhr-film__eyebrow {
    font-size: 1.2rem; letter-spacing: 0.32em; text-transform: uppercase;
    color: var(--color-accent); margin: 0 0 var(--space-3);
  }
  .bhr-film__heading {
    color: #fbfaf7; margin: 0 0 var(--space-5); max-width: 640px;
    font-size: calc(3.6rem * var(--font-heading-scale));
  }
  .bhr-film__btn { background: #fbfaf7; color: #211e19; }
  .bhr-film__btn:hover { background: var(--color-accent); color: #fff; }
  @media (max-width: 749px) {
    .bhr-film--large { height: 72vh; min-height: 440px; }
    .bhr-film__heading { font-size: calc(2.6rem * var(--font-heading-scale)); }
  }
</style>

{% schema %}
{
  "name": "Brand film",
  "tag": "section",
  "class": "bhr-film-section",
  "settings": [
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL (MP4)",
      "info": "Leave empty to use the film bundled with the theme."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image",
      "info": "Shown while the video loads. Leave empty to use the bundled poster."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Bahrati film" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted for the everyday ritual." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover the bracelet" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Brand film" }
  ]
}
{% endschema %}
