{{ 'section-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout = section.settings.layout | default: 'split'
  assign scheme = section.settings.color_scheme | default: 'default'
  assign alignment = section.settings.text_alignment | default: 'left'
  assign height = section.settings.height | default: 'medium'
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile
  assign video = section.settings.video
  assign video_url = section.settings.video_url
  assign overlay = section.settings.overlay_opacity | default: 60

  assign rating_value = settings.store_rating
  assign rating_count = settings.store_review_count
  if section.settings.rating_value != blank
    assign rating_value = section.settings.rating_value
  endif
  if section.settings.rating_count != blank
    assign rating_count = section.settings.rating_count
  endif
  assign rating_count_number = rating_count | times: 1
  if rating_count_number == 1
    assign rating_count_label = 'products.product.review_one' | t
  else
    assign rating_count_label = 'products.product.reviews' | t: count: rating_count
  endif

  assign padding_mobile_top = section.settings.padding_top | times: 0.75 | round
  assign padding_mobile_bottom = section.settings.padding_bottom | times: 0.75 | round

  assign has_media = false
  if video != blank or video_url != blank or image != blank
    assign has_media = true
  endif

  assign embed_src = blank
  if video_url != blank
    if video_url.type == 'youtube'
      assign embed_src = 'https://www.youtube-nocookie.com/embed/' | append: video_url.id | append: '?autoplay=1&mute=1&playsinline=1&rel=0'
    elsif video_url.type == 'vimeo'
      assign embed_src = 'https://player.vimeo.com/video/' | append: video_url.id | append: '?autoplay=1&muted=1&playsinline=1'
    endif
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .hero {
    padding-top: {{ padding_mobile_top }}px;
    padding-bottom: {{ padding_mobile_bottom }}px;
    --overlay: {{ overlay | divided_by: 100.0 }};
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .hero {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- capture video_toggle -%}
  {%- if video != blank -%}
    <button type="button" class="icon-btn video-toggle hero__video-toggle" data-video-toggle aria-pressed="false" aria-label="{{ 'accessibility.pause_video' | t }}">
      <span class="video-toggle__icon video-toggle__icon--pause">{% render 'icon', name: 'pause' %}</span>
      <span class="video-toggle__icon video-toggle__icon--play">{% render 'icon', name: 'play' %}</span>
    </button>
  {%- endif -%}
{%- endcapture -%}

{%- capture media_markup -%}
  {%- if video != blank -%}
    {{ video | video_tag: image_size: '1400x', autoplay: true, loop: true, muted: true, controls: false, preload: 'metadata', class: 'hero__video' }}
  {%- elsif video_url != blank and embed_src != blank -%}
    <hero-video class="hero__facade" data-embed-src="{{ embed_src }}" data-title="{{ section.settings.heading | escape }}">
      {%- if image != blank -%}
        <img
          class="hero__img"
          src="{{ image | image_url: width: 1400 }}"
          srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1400 }} 1400w, {{ image | image_url: width: 2000 }} 2000w"
          sizes="(min-width: 990px) 50vw, 100vw"
          alt="{{ image.alt | escape }}"
          width="{{ image.width }}"
          height="{{ image.height }}"
          fetchpriority="high"
        >
      {%- else -%}
        <div class="hero__facade-fallback" aria-hidden="true"></div>
      {%- endif -%}
      <button type="button" class="hero__play" data-hero-play aria-label="{{ 'accessibility.play_video' | t }}">
        {% render 'icon', name: 'play' %}
      </button>
      <noscript>
        <a class="hero__play hero__play--link" href="{{ video_url }}" target="_blank" rel="noopener">
          {% render 'icon', name: 'play' %}
          <span class="visually-hidden">{{ 'accessibility.play_video' | t }} ({{ 'general.new_window' | t }})</span>
        </a>
      </noscript>
    </hero-video>
  {%- elsif image != blank -%}
    <picture>
      {%- if image_mobile != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ image_mobile | image_url: width: 500 }} 500w, {{ image_mobile | image_url: width: 750 }} 750w, {{ image_mobile | image_url: width: 1100 }} 1100w"
          sizes="100vw"
          width="{{ image_mobile.width }}"
          height="{{ image_mobile.height }}"
        >
      {%- endif -%}
      <img
        class="hero__img"
        src="{{ image | image_url: width: 1400 }}"
        srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1400 }} 1400w, {{ image | image_url: width: 2000 }} 2000w{% if image.width >= 2400 %}, {{ image | image_url: width: 2400 }} 2400w{% endif %}"
        sizes="{% if layout == 'split' %}(min-width: 990px) 50vw, 100vw{% else %}100vw{% endif %}"
        alt="{{ image.alt | escape }}"
        width="{{ image.width }}"
        height="{{ image.height }}"
        fetchpriority="high"
      >
    </picture>
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder' }}
  {%- endif -%}
{%- endcapture -%}

{%- capture rating_markup -%}
  {%- if section.settings.show_rating and rating_value != blank -%}
    <span class="badge sticker hero__rating">
      <span class="hero__rating-value tabular">{{ rating_value }}</span>
      {% render 'icon', name: 'star', class: 'hero__rating-star' %}
      <span aria-hidden="true">·</span>
      <span>{{ rating_count_label }}</span>
    </span>
  {%- endif -%}
{%- endcapture -%}

<section
  class="hero hero--{{ layout }} hero--{{ height }} hero--{{ alignment }} section{% if scheme != 'default' %} section--{{ scheme }}{% endif %}{% unless has_media %} hero--no-media{% endunless %}"
  data-hero
>
  {%- if layout == 'full-bleed' -%}
    <div class="hero__bg" aria-hidden="true">
      {{ media_markup }}
      <div class="hero__scrim"></div>
    </div>
    {{ video_toggle }}
  {%- endif -%}

  <div class="container hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank or settings.show_offer_badges -%}
        <div class="hero__eyebrow-row">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow hero__eyebrow">
              {% render 'icon', name: 'shark', class: 'accent' %}
              <span>{{ section.settings.eyebrow | escape }}</span>
            </p>
          {%- endif -%}
          {%- if settings.show_offer_badges and settings.bundle_tier_percent > 0 -%}
            <span class="badge badge--accent hero__offer">{{ 'products.product.bundle_hint' | t: min: settings.bundle_tier_min, percent: settings.bundle_tier_percent }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="hero__heading h1">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hero__text lead rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="hero__actions btn-row">
          {%- if section.settings.button_label != blank -%}
            <a class="btn btn--lg hero__cta" href="{{ section.settings.button_link | default: '/collections/shark-slippers' }}">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="btn btn--lg btn--outline hero__cta-secondary hero__cta-secondary--desktop" href="{{ section.settings.button_link_2 | default: '/pages/bundles' }}">{{ section.settings.button_label_2 | escape }}</a>
            <a class="btn btn--ghost hero__cta-secondary hero__cta-secondary--mobile" href="{{ section.settings.button_link_2 | default: '/pages/bundles' }}">
              <span>{{ section.settings.button_label_2 | escape }}</span>
              {% render 'icon', name: 'arrow-right' %}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if layout == 'full-bleed' and rating_markup != blank -%}
        <div class="hero__rating-inline">{{ rating_markup }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="hero__trust trust-row small" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <li class="trust-row__item hero__trust-item" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != 'none' -%}
                  {% render 'icon', name: block.settings.icon, class: 'icon--sm' %}
                {%- endif -%}
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if layout == 'split' -%}
      <div class="hero__media">
        <div class="hero__frame-wrap{% if video_url != blank and video == blank %} hero__frame-wrap--wide{% endif %}">
          <div class="hero__frame{% if video_url != blank and video == blank %} hero__frame--wide{% endif %}">
            {{ media_markup }}
            {{ video_toggle }}
          </div>
          {{ rating_markup }}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    if (window.customElements && !window.customElements.get('hero-video')) {
      class HeroVideo extends HTMLElement {
        connectedCallback() {
          this.button = this.querySelector('[data-hero-play]');
          if (!this.button) return;
          this.button.addEventListener('click', () => this.play());
        }

        play() {
          var src = this.getAttribute('data-embed-src');
          if (!src) return;
          var iframe = document.createElement('iframe');
          iframe.className = 'hero__iframe';
          iframe.src = src;
          iframe.title = this.getAttribute('data-title') || 'Video';
          iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
          iframe.setAttribute('allowfullscreen', '');
          iframe.setAttribute('loading', 'lazy');
          this.classList.add('is-playing');
          this.appendChild(iframe);
          this.button.hidden = true;
        }
      }
      window.customElements.define('hero-video', HeroVideo);
    }
  })();
</script>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "split",
          "label": "Split (text beside media)"
        },
        {
          "value": "full-bleed",
          "label": "Full-bleed (text over media)"
        }
      ],
      "default": "split"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (optional)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (Shopify-hosted)",
      "info": "Autoplays muted and replaces the image when set."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video link (YouTube or Vimeo)",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "info": "Shown with a play button; the image is used as the poster."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay strength (full-bleed only)",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Made for cozy people"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The coziest shark you'll ever wear."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Plush shark slippers and the famous shark blanket, delivered anywhere in Lebanon. Buy two pairs and save 20% — automatically.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop slippers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Build a bundle & save"
    },
    {
      "type": "url",
      "id": "button_link_2",
