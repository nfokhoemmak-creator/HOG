<div class="container container--narrow page-content">
  <h1>{{ page.title | escape }}</h1>
  {%- if page.content != blank -%}<div class="rte muted" style="margin-bottom: var(--space-6);">{{ page.content }}</div>{%- endif -%}

  {%- form 'contact', class: 'form-grid' -%}
    {%- if form.posted_successfully? -%}
      <p class="form__success">{{ 'sections.contact.success' | t }}</p>
    {%- elsif form.errors -%}
      <p class="form__error">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
    {%- endif -%}

    <div class="form-grid form-grid--2">
      <div class="field">
        <label class="field__label" for="ContactName">{{ 'sections.contact.name' | t }}</label>
        <input class="field__input" id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
      </div>
      <div class="field">
        <label class="field__label" for="ContactEmail">{{ 'sections.contact.email' | t }}</label>
        <input class="field__input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
      </div>
    </div>
    <div class="field">
      <label class="field__label" for="ContactOrder">{{ 'sections.contact.order' | t }}</label>
      <input class="field__input" id="ContactOrder" type="text" name="contact[order_number]" value="{{ form.order_number }}">
    </div>
    <div class="field">
      <label class="field__label" for="ContactBody">{{ 'sections.contact.message' | t }}</label>
      <textarea class="field__input" id="ContactBody" name="contact[body]" required>{{ form.body }}</textarea>
    </div>
    <div><button type="submit" class="btn">{{ 'sections.contact.submit' | t }}</button></div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact page",
  "tag": "section",
  "settings": []
}
{% endschema %}
