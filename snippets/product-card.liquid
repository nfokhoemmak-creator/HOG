{%- comment -%}
  Renders a product card for grids (collection, search, cart cross-sell).

  Accepts:
  - card_product: {Object} product (required)
  - lazy_load: {Boolean} default true

  Usage:
  {% render 'product-card', card_product: product %}
{%- endcomment -%}

{%- liquid
  assign loading = 'lazy'
  if lazy_load == false
    assign loading = 'eager'
  endif
  assign on_sale = false
  if card_product.compare_at_price > card_product.price
    assign on_sale = true
  endif
-%}

<div class="product-card reveal">
  <a class="product-card__media" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
    {%- if card_product.featured_media -%}
      <img
        src="{{ card_product.featured_media | image_url: width: 800 }}"
        srcset="{{ card_product.featured_media | image_url: width: 400 }} 400w, {{ card_product.featured_media | image_url: width: 800 }} 800w"
        sizes="(min-width: 990px) 30vw, 50vw"
        alt="{{ card_product.featured_media.alt | escape }}"
        width="{{ card_product.featured_media.width }}"
        height="{{ card_product.featured_media.height }}"
        loading="{{ loading }}"
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    {%- if on_sale -%}
      <span class="badge badge--sale" style="position:absolute;top:12px;left:12px;">{{ 'products.product.on_sale' | t }}</span>
    {%- endif -%}
  </a>

  <div class="rating-line">
    {% render 'stars', rating: settings.rating_value, class: 'stars--sm' %}
    <span class="muted small">{{ settings.rating_value }}</span>
  </div>

  <a class="product-card__title" href="{{ card_product.url }}">{{ card_product.title | escape }}</a>

  {% render 'price', product: card_product %}

  <a class="btn btn--sm" href="{{ card_product.url }}">{{ 'products.product.shop_now' | t }}</a>
</div>
