{%- comment -%}
  The cart drawer. cart-drawer.js re-fetches this section by id after every
  Ajax cart mutation and swaps the markup in, so everything the drawer shows
  must be rendered here — nothing is templated client-side.
{%- endcomment -%}

{%- liquid
  assign bar_mode = settings.cart_free_shipping_bar | default: 'none'
  assign threshold = settings.cart_free_shipping_threshold | default: 0 | times: 100
  assign free_qty = settings.cart_free_shipping_qty | default: 0
  assign progress = 0
  assign shipping_free = false
  assign show_bar = false

  if bar_mode == 'amount' and threshold > 0
    assign show_bar = true
    assign remaining = threshold | minus: cart.total_price
    assign remaining_money = remaining | money
    assign progress = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
    if remaining <= 0
      assign shipping_free = true
    endif
  elsif bar_mode == 'quantity' and free_qty > 0
    assign show_bar = true
    assign remaining_qty = free_qty | minus: cart.item_count
    assign progress = cart.item_count | times: 100 | divided_by: free_qty | at_most: 100
    if remaining_qty <= 0
      assign shipping_free = true
    endif
  endif
-%}

<cart-drawer class="cart-drawer" aria-hidden="true">
  <div class="cart-drawer__overlay" tabindex="-1"></div>

  <div
    class="cart-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'sections.cart.title' | t }}"
  >
    <div class="cart-drawer__head">
      <h2 class="h4">{{ 'sections.cart.title' | t }}{% if cart.item_count > 0 %} <span class="muted">({{ cart.item_count }})</span>{% endif %}</h2>
      <button type="button" class="header__icon" data-cart-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    {%- if show_bar and cart.item_count > 0 -%}
      <div class="shipping-bar{% if shipping_free %} shipping-bar--unlocked{% endif %}">
        <p class="shipping-bar__text">
          {%- if shipping_free -%}
            {{ 'sections.cart.free_shipping_unlocked' | t }}
          {%- elsif bar_mode == 'quantity' -%}
            {{ 'sections.cart.free_shipping_qty_remaining_html' | t: count: remaining_qty }}
          {%- else -%}
            {{ 'sections.cart.free_shipping_remaining_html' | t: amount: remaining_money }}
          {%- endif -%}
        </p>
        <div class="shipping-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}">
          <div class="shipping-bar__fill" style="--progress: {{ progress }}%;"></div>
        </div>
      </div>
    {%- else -%}
      <div></div>
    {%- endif -%}

    <div class="cart-drawer__body">
      <p class="form__error" data-cart-error hidden></p>

      {%- if cart.item_count == 0 -%}
        <div class="empty-state">
          <p class="h4">{{ 'sections.cart.empty' | t }}</p>
          <p class="muted">{{ 'sections.cart.empty_body' | t }}</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">
            {{ 'sections.cart.browse_catalog' | t }}
          </a>
        </div>
      {%- else -%}
        <ul class="cart-items">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a class="cart-item__image" href="{{ item.url }}">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 200 }}"
                    alt="{{ item.image.alt | escape }}"
                    width="100"
                    height="100"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>

              <div class="cart-item__details">
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>

                {%- unless item.product.has_only_default_variant -%}
                  <span class="cart-item__variant">{{ item.variant.title }}</span>
                {%- endunless -%}

                {%- if item.selling_plan_allocation -%}
                  <span class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</span>
                {%- endif -%}

                {%- for property in item.properties -%}
                  {%- if property.last != blank -%}
                    <span class="cart-item__variant">{{ property.first }}: {{ property.last }}</span>
                  {%- endif -%}
                {%- endfor -%}

                <div class="cart-item__actions">
                  <quantity-input class="quantity-input">
                    <button
                      type="button"
                      data-action="decrease"
                      aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title }}"
                    >
                      &minus;
                    </button>
                    <input
                      type="number"
                      value="{{ item.quantity }}"
                      min="0"
                      data-line-quantity="{{ item.key }}"
                      aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title }}"
                    >
                    <button
                      type="button"
                      data-action="increase"
                      aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title }}"
                    >
                      +
                    </button>
                  </quantity-input>

                  <span class="price">
                    {%- if item.original_line_price > item.final_line_price -%}
                      <s class="price__compare">{{ item.original_line_price | money }}</s>
                    {%- endif -%}
                    {{ item.final_line_price | money }}
                  </span>
                </div>

                <button type="button" class="cart-item__remove" data-line-remove="{{ item.key }}">
                  {{ 'sections.cart.remove' | t }}
                </button>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- comment -%} Upsell: first in-stock recommendation not already in the cart. {%- endcomment -%}
        {%- liquid
          assign first_item = cart.items.first
          assign candidates = first_item.product.collections.first.products
          assign upsell_count = 0
        -%}
        {%- if candidates.size > 0 -%}
          <div class="cart-upsell">
            {%- for candidate in candidates -%}
              {%- if upsell_count >= 2 -%}{%- break -%}{%- endif -%}
              {%- assign in_cart = false -%}
              {%- for item in cart.items -%}
                {%- if item.product_id == candidate.id -%}{%- assign in_cart = true -%}{%- endif -%}
              {%- endfor -%}
              {%- if in_cart or candidate.available == false or candidate.variants.size != 1 -%}{%- continue -%}{%- endif -%}
              {%- if upsell_count == 0 -%}
                <p class="cart-upsell__title">{{ 'sections.cart.upsell_title' | t }}</p>
              {%- endif -%}
              {%- assign upsell_count = upsell_count | plus: 1 -%}
              <form method="post" action="{{ routes.cart_add_url }}" class="cart-upsell__item" data-quick-add-form>
                <input type="hidden" name="id" value="{{ candidate.variants.first.id }}">
                <input type="hidden" name="quantity" value="1">
                {%- if candidate.featured_media -%}
                  <img src="{{ candidate.featured_media | image_url: width: 120, height: 120, crop: 'center' }}" alt="" width="56" height="56" loading="lazy">
                {%- else -%}
                  <span></span>
                {%- endif -%}
                <span>
                  <strong>{{ candidate.title | escape }}</strong><br>
                  <span class="muted">{{ candidate.price | money }}</span>
                </span>
                <button type="submit" class="btn btn--small btn--soft">{{ 'sections.cart.upsell_add' | t }}</button>
              </form>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if settings.cart_show_note -%}
          <details class="accordion" style="margin-top: var(--space-5);">
            <summary>
              {{ 'sections.cart.note' | t }}
              {% render 'icon', name: 'plus' %}
            </summary>
            <div class="accordion__content">
              <label class="visually-hidden" for="CartDrawerNote">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartDrawerNote"
                name="note"
                form="cart-drawer-form"
                placeholder="{{ 'sections.cart.note_placeholder' | t }}"
              >{{ cart.note }}</textarea>
            </div>
          </details>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__foot">
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-totals accent" style="font-size: 1.3rem;">
              <span>{{ discount.title }}</span>
              <span>-{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
        {%- endif -%}

        {%- liquid
          assign flat_shipping = settings.cart_flat_shipping | default: 0 | times: 100
        -%}
        <div class="cart-totals{% if flat_shipping > 0 %} cart-totals--secondary{% endif %}">
          <span>{{ 'sections.cart.subtotal' | t }}</span>
          <span>
            {%- if settings.currency_code_enabled -%}
              {{ cart.total_price | money_with_currency }}
            {%- else -%}
              {{ cart.total_price | money }}
            {%- endif -%}
          </span>
        </div>

        {%- if flat_shipping > 0 -%}
          <div class="cart-totals cart-totals--secondary">
            <span>{{ 'sections.cart.shipping_flat' | t }} <span class="muted">({{ 'sections.cart.shipping_flat_note' | t }})</span></span>
            {%- if shipping_free -%}
              <span><s class="muted">{{ flat_shipping | money }}</s> <strong class="accent">{{ 'sections.cart.shipping_free' | t }}</strong></span>
            {%- else -%}
              <span>{{ flat_shipping | money }}</span>
            {%- endif -%}
          </div>
          <div class="cart-totals">
            <span>{{ 'sections.cart.estimated_total' | t }}</span>
            {%- if shipping_free -%}
              <span>{{ cart.total_price | money }}</span>
            {%- else -%}
              <span>{{ cart.total_price | plus: flat_shipping | money }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form">
          <button type="submit" name="checkout" class="btn btn--large btn--full">
            {% render 'icon', name: 'lock' %}
            {{ 'sections.cart.checkout' | t }}
          </button>
        </form>

        <p class="cart-notice">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>

        {%- if settings.cart_notice != blank -%}
          <div class="cart-notice">{{ settings.cart_notice }}</div>
        {%- endif -%}

        <a class="cart-notice underline" href="{{ routes.cart_url }}">{{ 'sections.cart.view_cart' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
