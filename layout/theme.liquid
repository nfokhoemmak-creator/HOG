<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'jamalati-favicon.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'jamalati-favicon.png' | asset_url }}">
    {%- endif -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {%- liquid
      assign body_font = settings.type_body_font
      assign body_font_bold = body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = body_font | font_modify: 'style', 'italic'
      assign heading_font = settings.type_heading_font

      assign btn_radius = '999px'
      if settings.button_shape == 'rounded'
        assign btn_radius = settings.layout_corner_radius | at_most: 12 | append: 'px'
      elsif settings.button_shape == 'square'
        assign btn_radius = '0px'
      endif
    -%}

    {{ body_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ heading_font | font_face: font_display: 'swap' }}

    <style>
      :root {
        --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body-style: {{ body_font.style }};
        --font-body-weight: {{ body_font.weight }};
        --font-body-weight-bold: {{ body_font.weight | plus: 300 | at_most: 1000 }};

        --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-style: {{ heading_font.style }};
        --font-heading-weight: {{ heading_font.weight }};
        --font-heading-tracking: {{ settings.type_heading_tracking }}px;
        --font-heading-transform: {% if settings.type_heading_uppercase %}uppercase{% else %}none{% endif %};

        --font-body-scale: {{ settings.type_body_scale | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.type_heading_scale | divided_by: 100.0 }};

        --color-bg: {{ settings.color_background }};
        --color-bg-alt: {{ settings.color_background_alt }};
        --color-surface: {{ settings.color_surface }};
        --color-fg: {{ settings.color_text }};
        --color-fg-rgb: {{ settings.color_text.red }} {{ settings.color_text.green }} {{ settings.color_text.blue }};
        --color-muted: {{ settings.color_text_muted }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-rgb: {{ settings.color_accent.red }} {{ settings.color_accent.green }} {{ settings.color_accent.blue }};
        --color-accent-contrast: {{ settings.color_accent_contrast }};
        --color-border: {{ settings.color_border }};
        --color-sale: {{ settings.color_sale }};
        --color-star: {{ settings.color_star }};

        --color-btn-bg: {{ settings.color_button_background }};
        --color-btn-fg: {{ settings.color_button_text }};

        --container: {{ settings.layout_max_width }}px;
        --gutter: {{ settings.layout_gutter }}px;
        --radius: {{ settings.layout_corner_radius }}px;
        --radius-btn: {{ btn_radius }};

        --grid-gap: {{ settings.grid_gap }}px;
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.theme = {
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          adding: {{ 'products.product.adding' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          preorder: {{ 'products.product.preorder' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          lowStock: {{ 'products.product.low_stock' | t: count: '__COUNT__' | json }},
          inStock: {{ 'products.product.in_stock' | t | json }},
          cartError: {{ 'sections.cart.error' | t | json }},
          itemAdded: {{ 'sections.cart.item_added' | t | json }}
        },
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        cartType: {{ settings.cart_type | json }}
      };
    </script>

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ template.name | handle }} {% if settings.animations_enabled %}animate{% endif %}">
    <a class="skip-to-content visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- if settings.whatsapp_button and settings.social_whatsapp_link != blank -%}
      <a
        class="whatsapp-float"
        href="{{ settings.social_whatsapp_link }}"
        target="_blank"
        rel="noopener"
        aria-label="{{ 'general.whatsapp' | t }}"
      >
        {% render 'icon', name: 'whatsapp' %}
        <span>{{ 'general.whatsapp' | t }}</span>
      </a>
    {%- endif -%}

    <div class="visually-hidden" aria-live="polite" role="status" id="LiveRegion"></div>

    <ul hidden>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>
  </body>
</html>
