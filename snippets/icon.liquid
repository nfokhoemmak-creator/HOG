{%- comment -%}
  Renders an inline 24x24 SVG icon drawn with currentColor.

  Accepts:
  - name:  {String} one of the cases below (required)
  - class: {String} extra classes on the <svg> (optional)

  Usage:
  {% render 'icon', name: 'cart' %}
  {% render 'icon', name: 'shark', class: 'accent' %}
{%- endcomment -%}

{%- capture attrs -%}
  class="icon icon--{{ name }}{% if class != blank %} {{ class }}{% endif %}" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
{%- endcapture -%}

{%- case name -%}
  {%- when 'cart' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L20.5 8H6.2"/>
      <circle cx="10" cy="20.5" r="1.25" fill="currentColor" stroke="none"/>
      <circle cx="17.5" cy="20.5" r="1.25" fill="currentColor" stroke="none"/>
    </svg>

  {%- when 'search' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="6.5"/>
      <path d="m16 16 4.5 4.5"/>
    </svg>

  {%- when 'account' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="8.5" r="3.75"/>
      <path d="M4.5 20a7.5 7.5 0 0 1 15 0"/>
    </svg>

  {%- when 'menu' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 6h18M3 12h18M3 18h18"/>
    </svg>

  {%- when 'close' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="m5 5 14 14M19 5 5 19"/>
    </svg>

  {%- when 'plus' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M5 12h14"/>
    </svg>

  {%- when 'minus' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14"/>
    </svg>

  {%- when 'chevron-down' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="m6 9 6 6 6-6"/>
    </svg>

  {%- when 'chevron-right' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="m9 6 6 6-6 6"/>
    </svg>

  {%- when 'chevron-left' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="m15 6-6 6 6 6"/>
    </svg>

  {%- when 'arrow-right' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 12h16m-6-6 6 6-6 6"/>
    </svg>

  {%- when 'check' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    </svg>

  {%- when 'star' -%}
    <svg {{ attrs }} fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round">
      <path d="M12 2.8l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.7l-5.9 3.1 1.2-6.5L2.5 9.7l6.6-.9z"/>
    </svg>

  {%- when 'star-half' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round">
      <path d="M12 2.8l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.7l-5.9 3.1 1.2-6.5L2.5 9.7l6.6-.9z"/>
      <path d="M12 2.8v14.9l-5.9 3.1 1.2-6.5L2.5 9.7l6.6-.9z" fill="currentColor"/>
    </svg>

  {%- when 'truck' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 6.5h11v9H3zM14 10h4l3 3v2.5h-7z"/>
      <circle cx="7" cy="17.5" r="1.75"/>
      <circle cx="17" cy="17.5" r="1.75"/>
    </svg>

  {%- when 'bolt' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M13.5 2.5 5 13.5h6l-1 8 8.5-11h-6z"/>
    </svg>

  {%- when 'shield' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2.8 4.5 5.6v5.6c0 4.6 3.2 8.4 7.5 9.8 4.3-1.4 7.5-5.2 7.5-9.8V5.6z"/>
      <path d="m9 12 2 2 4-4"/>
    </svg>

  {%- when 'whatsapp' -%}
    <svg {{ attrs }} fill="currentColor">
      <path d="M12 2a10 10 0 0 0-8.6 15.05L2 22l5.1-1.33A10 10 0 1 0 12 2zm0 2a8 8 0 1 1-4.2 14.8l-.3-.18-3 .78.8-2.92-.2-.31A8 8 0 0 1 12 4zm-3.4 4.3c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1s.9 2.44 1.03 2.6c.13.17 1.75 2.79 4.32 3.8 2.14.84 2.58.67 3.04.63.46-.04 1.5-.61 1.71-1.2.21-.59.21-1.1.15-1.2-.06-.1-.23-.17-.48-.29-.25-.13-1.5-.74-1.73-.82-.23-.09-.4-.13-.57.12-.17.25-.65.82-.8.99-.14.16-.29.19-.54.06-.25-.12-1.07-.39-2.04-1.25-.75-.67-1.26-1.5-1.4-1.75-.15-.25-.02-.38.1-.51.11-.11.25-.29.38-.44.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.37-.77-1.87-.2-.49-.4-.42-.56-.43z"/>
    </svg>

  {%- when 'instagram' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/>
      <circle cx="12" cy="12" r="3.75"/>
      <circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/>
    </svg>

  {%- when 'tiktok' -%}
    <svg {{ attrs }} fill="currentColor">
      <path d="M16.5 3h-2.6v11.4a2.6 2.6 0 1 1-2.2-2.57V9.2a5.2 5.2 0 1 0 4.8 5.19V8.6a6.2 6.2 0 0 0 3.5 1.1V7.1a3.6 3.6 0 0 1-3.5-3.6z"/>
    </svg>

  {%- when 'facebook' -%}
    <svg {{ attrs }} fill="currentColor">
      <path d="M14 8.5V6.8c0-.7.2-1.1 1.2-1.1H17V3h-2.6c-2.6 0-3.6 1.4-3.6 3.6v1.9H9V11h1.8v10H14V11h2.5l.4-2.5H14z"/>
    </svg>

  {%- when 'play' -%}
    <svg {{ attrs }} fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
      <path d="M7 4.5v15l12-7.5z"/>
    </svg>

  {%- when 'pause' -%}
    <svg {{ attrs }} fill="currentColor">
      <rect x="6" y="4.5" width="4" height="15" rx="1"/>
      <rect x="14" y="4.5" width="4" height="15" rx="1"/>
    </svg>

  {%- when 'mute' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5z"/>
      <path d="m16 9.5 5 5m0-5-5 5"/>
    </svg>

  {%- when 'unmute' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5z"/>
      <path d="M15.5 9a4.5 4.5 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11"/>
    </svg>

  {%- when 'gift' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3.5 8.5h17v4h-17zM5 12.5v8h14v-8M12 8.5v12"/>
      <path d="M12 8.5c-1.5-3.5-5.5-4.5-5.5-2s3.5 2 5.5 2c2 0 5.5 0 5.5-2s-4-1.5-5.5 2z"/>
    </svg>

  {%- when 'sparkle' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 3.5c.6 3.8 2.2 5.4 6 6-3.8.6-5.4 2.2-6 6-.6-3.8-2.2-5.4-6-6 3.8-.6 5.4-2.2 6-6z"/>
      <path d="M18 14c.3 1.9 1.1 2.7 3 3-1.9.3-2.7 1.1-3 3-.3-1.9-1.1-2.7-3-3 1.9-.3 2.7-1.1 3-3z"/>
    </svg>

  {%- when 'box' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3 3.5 7.5v9L12 21l8.5-4.5v-9z"/>
      <path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/>
    </svg>

  {%- when 'ruler' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="m3 16.5 13.5-13.5 4.5 4.5L7.5 21z"/>
      <path d="m7 12.5 2 2m1-5 2 2m1-5 2 2"/>
    </svg>

  {%- when 'heart' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 20.5s-8-4.9-8-11A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 8 2.5c0 6.1-8 11-8 11z"/>
    </svg>

  {%- when 'info' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9"/>
      <path d="M12 11v5.5"/>
      <circle cx="12" cy="7.75" r=".9" fill="currentColor" stroke="none"/>
    </svg>

  {%- when 'refresh' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 12a8 8 0 0 1-14.2 5M4 12a8 8 0 0 1 14.2-5"/>
      <path d="M18 3.5V7h-3.5M6 20.5V17h3.5"/>
    </svg>

  {%- when 'lock' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <rect x="5" y="10.5" width="14" height="10" rx="2"/>
      <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
      <circle cx="12" cy="15.5" r="1" fill="currentColor" stroke="none"/>
    </svg>

  {%- when 'sun' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"/>
      <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5m14 0h2.5M5.3 5.3l1.8 1.8m9.8 9.8 1.8 1.8M5.3 18.7l1.8-1.8m9.8-9.8 1.8-1.8"/>
    </svg>

  {%- when 'snowflake' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2.5v19M3.8 7.25l16.4 9.5M3.8 16.75l16.4-9.5"/>
      <path d="m9.5 4.5 2.5 2 2.5-2M9.5 19.5l2.5-2 2.5 2M4.2 10.4l3-.9.9-3M19.8 13.6l-3 .9-.9 3M4.2 13.6l3 .9.9 3M19.8 10.4l-3-.9-.9-3"/>
    </svg>

  {%- when 'shark' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2.5 17.5c2.2 0 3.2-1.2 4.4-1.2s2.1 1.2 4.2 1.2 3-1.2 4.3-1.2 2.2 1.2 4.4 1.2"/>
      <path d="M4.5 14.5c1.5-4.5 5-7.5 9.5-8.5-1.5 2-1.7 4.5-.5 6.5"/>
      <path d="M14 6c1.5-2 3.5-2.5 5.5-2.5-.7 2.5-.3 5 1 7.5-2 .5-4 .5-6.5-.5"/>
      <path d="M8.5 12.5c.8.7 1.9 1.4 3.5 1.8"/>
    </svg>

  {%- else -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.75">
      <circle cx="12" cy="12" r="8"/>
    </svg>
{%- endcase -%}
