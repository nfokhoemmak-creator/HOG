<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_brand }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- liquid
      assign body_font = settings.type_body_font
      assign body_font_bold = body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = body_font | font_modify: 'style', 'italic'
      assign heading_font = settings.type_heading_font
      assign heading_font_bolder = heading_font | font_modify: 'weight', 'bolder'
      assign heading_font_medium = heading_font | font_modify: 'weight', '600'

      assign heading_weight_bolder = heading_font.weight
      if heading_font_bolder
        assign heading_weight_bolder = heading_font_bolder.weight
      endif

      assign heading_weight_medium = heading_font.weight
      if heading_font_medium
        assign heading_weight_medium = heading_font_medium.weight
      endif

      assign body_weight_bold = body_font.weight | plus: 300 | at_most: 900
      if body_font_bold
        assign body_weight_bold = body_font_bold.weight
      endif
    -%}

    {{ heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <style>
      {{ body_font | font_face: font_display: 'swap' }}
      {%- if body_font_bold %}{{ body_font_bold | font_face: font_display: 'swap' }}{% endif -%}
      {%- if body_font_italic %}{{ body_font_italic | font_face: font_display: 'swap' }}{% endif -%}
      {{ heading_font | font_face: font_display: 'swap' }}
      {%- if heading_font_bolder %}{{ heading_font_bolder | font_face: font_display: 'swap' }}{% endif -%}
      {%- if heading_font_medium %}{{ heading_font_medium | font_face: font_display: 'swap' }}{% endif %}

      :root {
        --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body-style: {{ body_font.style }};
        --font-body-weight: {{ body_font.weight }};
        --font-body-weight-bold: {{ body_weight_bold }};

        --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-style: {{ heading_font.style }};
        --font-heading-weight: {{ heading_font.weight }};
        --font-heading-weight-bolder: {{ heading_weight_bolder }};
        --font-heading-weight-medium: {{ heading_weight_medium }};

        --font-body-scale: {{ settings.type_body_scale | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.type_heading_scale | divided_by: 100.0 }};

        --color-bg: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-surface-alt: {{ settings.color_surface_alt }};
        --color-ink: {{ settings.color_text }};
        --color-muted: {{ settings.color_text_muted }};
        --color-border: {{ settings.color_border }};
        --color-brand: {{ settings.color_brand }};
        --color-brand-contrast: {{ settings.color_brand_contrast }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-contrast: {{ settings.color_accent_contrast }};
        --color-success: {{ settings.color_success }};
        --color-sale: {{ settings.color_sale }};
        --color-star: {{ settings.color_star }};

        --container: {{ settings.layout_max_width }}px;
        --gutter-desktop: {{ settings.layout_gutter }}px;
        --radius: {{ settings.layout_corner_radius }}px;
        --grid-gap: {{ settings.grid_gap }}px;
        --logo-width: {{ settings.logo_width }}px;
      }
    </style>

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      {%- liquid
        assign slipper_ids = collections['shark-slippers'].products | map: 'id'
        assign blanket_ids = collections['shark-blankets'].products | map: 'id'
        assign threshold_cents = settings.free_shipping_threshold | default: 0 | times: 100
      -%}
      window.theme = {
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          adding: {{ 'products.product.adding' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          preorder: {{ 'products.product.preorder' | t | json }},
          lowStock: {{ 'products.product.low_stock' | t: count: '[count]' | json }},
          cartError: {{ 'cart.error' | t | json }},
          itemAdded: {{ 'cart.item_added' | t | json }},
          bundleAdded: {{ 'bundles.added' | t | json }},
          freeShippingAway: {{ 'cart.free_shipping_away' | t: amount: '[amount]' | json }},
          freeShippingUnlocked: {{ 'cart.free_shipping_unlocked' | t | json }},
          viewCart: {{ 'cart.view_cart' | t | json }},
          checkout: {{ 'cart.checkout' | t | json }}
        },
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          productRecommendations: {{ routes.product_recommendations_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        moneyWithCurrencyFormat: {{ shop.money_with_currency_format | json }},
        currencyCode: {{ cart.currency.iso_code | json }},
        cartType: {{ settings.cart_type | json }},
        freeShippingThreshold: {{ threshold_cents }},
        slippersCollection: 'shark-slippers',
        blanketCollection: 'shark-blankets',
        slipperProductIds: {{ slipper_ids | json }} || [],
        blanketProductIds: {{ blanket_ids | json }} || [],
        bundleTierPercent: {{ settings.bundle_tier_percent | default: 0 }},
        bundleTierMin: {{ settings.bundle_tier_min | default: 2 }},
        setDiscountPercent: {{ settings.set_discount_percent | default: 0 }},
        lowStockThreshold: {{ settings.low_stock_threshold | default: 0 }},
        whatsappNumber: {{ settings.social_whatsapp_number | json }},
        predictiveSearch: {{ settings.predictive_search_enabled | json }}
      };
    </script>

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ request.page_type | handle }}{% if template.suffix != blank %} template-{{ request.page_type | handle }}-{{ template.suffix | handle }}{% endif %}{% if settings.animations_enabled %} animate{% endif %}">
    <a class="skip-to-content visually-hidden" href="#MainContent">
      {{ 'general.skip_to_content' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {% render 'whatsapp-fab' %}

    <div class="visually-hidden" aria-live="polite" role="status" id="LiveRegion"></div>

    <ul hidden>
      <li id="a11y-new-window-message">{{ 'general.new_window' | t }}</li>
    </ul>
  </body>
</html>
