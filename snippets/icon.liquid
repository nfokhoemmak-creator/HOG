  {%- when 'arrow-left' -%}
    <svg {{ attrs }}><path d="M20 12H4m6-6-6 6 6 6"/></svg>
  {%- when 'check' -%}
    <svg {{ attrs }} stroke-width="2.6"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
  {%- when 'x' -%}
    <svg {{ attrs }} stroke-width="2.4"><path d="m6 6 12 12M18 6 6 18"/></svg>
