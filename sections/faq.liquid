{%- comment -%}
  FAQ. Emits FAQPage structured data so the answers can surface in search
  results as well as on the page.
{%- endcomment -%}

<div class="container section">
  <div class="faq">
    {%- if section.settings.heading != blank -%}
      <div class="section__head">
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.settings.question != blank -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary>
            {{ block.settings.question | escape }}
            {% render 'icon', name: 'plus' %}
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{%- assign faq_blocks = section.blocks | where: 'type', 'question' -%}
{%- if faq_blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in faq_blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.faq.name",
  "tag": "section",
  "class": "faq-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.faq.settings.heading.label",
      "default": "Questions"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.faq.blocks.question.settings.question.label",
          "default": "How long does delivery take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.faq.blocks.question.settings.answer.label",
          "default": "<p>Orders ship within 2–4 business days, all over Lebanon.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.presets.name",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
