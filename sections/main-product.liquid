{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  assign is_preorder = false
  if product.tags contains 'preorder' or product.title contains 'PRE-ORDER'
    assign is_preorder = true
  endif

  assign is_limited = false
  if product.tags contains 'limited'
    assign is_limited = true
  endif

  assign form_id = 'ProductForm-' | append: section.id

  comment
    Size guide content, most specific source first: a per-product metafield
    beats the shop-wide page, which beats the inline richtext.
  endcomment
  assign size_guide_content = ''
  if section.settings.show_size_guide
    assign product_guide = product.metafields.custom.size_guide
    if product_guide != blank
      assign size_guide_content = product_guide
    elsif section.settings.size_guide_page != blank
      assign size_guide_content = section.settings.size_guide_page.content
      assign size_guide_url = section.settings.size_guide_page.url
    elsif section.settings.size_guide_content != blank
      assign size_guide_content = section.settings.size_guide_content
    endif
  endif

  comment
    Chart image, same precedence: a per-product metafield beats the shop-wide
    image, so a tee and a pair of sweatpants can show different charts.
  endcomment
  assign size_guide_image = ''
  if section.settings.show_size_guide
    assign product_guide_image = product.metafields.custom.size_guide_image.value
    if product_guide_image != blank
      assign size_guide_image = product_guide_image
    elsif section.settings.size_guide_image != blank
      assign size_guide_image = section.settings.size_guide_image
    endif
  endif

  assign has_size_guide = false
  if size_guide_content != blank or size_guide_image != blank
    assign has_size_guide = true
  endif

  assign size_guide_id = 'SizeGuide-' | append: section.id
  assign size_guide_label = section.settings.size_guide_label | default: 'Size guide'

  comment
    Does any option read as a size? If so the trigger sits in that option's
    label row; otherwise it goes under the picker.
  endcomment
  assign has_size_option = false
  for option in product.options_with_values
    assign option_name_check = option.name | downcase
    if option_name_check contains 'size'
      assign has_size_option = true
    endif
  endfor
-%}

<div class="container">
  <div class="product">
    {%- comment -%} ------------------------------------------------ gallery {%- endcomment -%}
    <div class="product__media" data-gallery>
      <div class="product__media-list">
        {%- for media in product.media -%}
          <div data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <img
                  src="{{ media | image_url: width: 1400 }}"
                  srcset="
                    {{ media | image_url: width: 600 }} 600w,
                    {{ media | image_url: width: 1000 }} 1000w,
                    {{ media | image_url: width: 1400 }} 1400w,
                    {{ media | image_url: width: 1800 }} 1800w
                  "
                  sizes="(min-width: 990px) 60vw, 100vw"
                  alt="{{ media.alt | escape }}"
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                >

              {%- when 'video' -%}
                {{ media | video_tag: image_size: '1400x', controls: true, muted: true, playsinline: true }}

              {%- when 'external_video' -%}
                {{ media | external_video_tag }}

              {%- when 'model' -%}
                {{ media | model_viewer_tag }}

              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: '' }}
        {%- endfor -%}
      </div>

      {%- if product.media.size > 1 and section.settings.media_layout == 'thumbnails' -%}
        <div class="product__thumbs">
          {%- for media in product.media -%}
            <button
              type="button"
              class="product__thumb"
              data-thumb="{{ media.id }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
            >
              <img
                src="{{ media.preview_image | image_url: width: 200 }}"
                alt=""
                width="72"
                height="96"
                loading="lazy"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} --------------------------------------------------- info {%- endcomment -%}
    <div class="product__info{% if section.settings.enable_sticky_info %} product__info--sticky{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'badges' -%}
            {%- if is_preorder or is_limited or product.available == false -%}
              <div class="product__badges" {{ block.shopify_attributes }}>
                {%- if is_preorder -%}
                  <span class="badge badge--accent">{{ 'products.product.preorder' | t }}</span>
                {%- endif -%}
                {%- if is_limited -%}
                  <span class="badge badge--accent">{{ 'products.product.limited' | t }}</span>
                {%- endif -%}
                {%- unless product.available -%}
                  <span class="badge badge--sold">{{ 'products.product.sold_out' | t }}</span>
                {%- endunless -%}
              </div>
            {%- endif -%}

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'price' -%}
            <div id="ProductPrice-{{ section.id }}" {{ block.shopify_attributes }}>
              {% render 'price',
                product: product,
                use_variant: true,
                price_class: 'product__price',
                id_prefix: 'ProductPrice'
              %}
            </div>
            <p class="product__inventory" id="ProductInventory-{{ section.id }}" hidden></p>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign option_name_down = option.name | downcase -%}
                  <fieldset style="border: 0; margin: 0; padding: 0;">
                    <legend class="variant-option__label" style="width: 100%;">
                      <span>{{ option.name }}</span>
                      {%- if has_size_guide and option_name_down contains 'size' -%}
                        {% render 'size-guide-trigger',
                          label: size_guide_label,
                          dialog_id: size_guide_id,
                          guide_url: size_guide_url
                        %}
                      {%- endif -%}
                    </legend>

                    <div class="variant-option__values">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                        <input
                          class="variant-option__input"
                          type="radio"
                          id="{{ input_id }}"
                          name="{{ option.name }}-{{ section.id }}"
                          value="{{ value | escape }}"
                          data-option-index="{{ forloop.parentloop.index0 }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label class="variant-option__value" for="{{ input_id }}">{{ value }}</label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}

                {%- if has_size_guide and has_size_option == false -%}
                  <div class="size-guide__row">
                    {% render 'size-guide-trigger',
                      label: size_guide_label,
                      dialog_id: size_guide_id,
                      guide_url: size_guide_url
                    %}
                  </div>
                {%- endif -%}
              </div>
            {%- endunless -%}

          {%- when 'quantity_selector' -%}
            <div {{ block.shopify_attributes }}>
              <span class="variant-option__label">{{ 'sections.cart.quantity' | t }}</span>
              <quantity-input class="quantity-input">
                <button type="button" data-action="decrease" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title }}">&minus;</button>
                <input
                  type="number"
                  name="quantity"
                  form="ProductForm-{{ section.id }}"
                  value="1"
                  min="1"
                  aria-label="{{ 'products.product.quantity.input_label' | t: product: product.title }}"
                >
                <button type="button" data-action="increase" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title }}">+</button>
              </quantity-input>
            </div>

          {%- when 'buy_buttons' -%}
            <product-form
              data-section-id="{{ section.id }}"
              data-price-target="ProductPrice-{{ section.id }}"
              data-inventory-target="ProductInventory-{{ section.id }}"
              data-preorder="{{ is_preorder }}"
              {{ block.shopify_attributes }}
            >
              <script type="application/json" data-variants>
                {{ product.variants | json }}
              </script>

              {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">

                <div class="product__buy">
                  <button
                    type="submit"
                    name="add"
                    class="btn btn--accent btn--full"
                    {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
                  >
                    <span data-button-text>
                      {%- if current_variant.available -%}
                        {%- if is_preorder -%}
                          {{ 'products.product.preorder' | t }}
                        {%- else -%}
                          {{ 'products.product.add_to_cart' | t }}
                        {%- endif -%}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>

                  {%- if block.settings.show_dynamic_checkout and current_variant.available -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                </div>
              {%- endform -%}

              {%- if block.settings.assurance != blank and current_variant.available -%}
                <ul class="product__assurance">
                  {%- assign assurance_items = block.settings.assurance | split: ',' -%}
                  {%- for item in assurance_items -%}
                    <li>{{ item | strip }}</li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if is_preorder -%}
                <p class="product__inventory" style="margin-top: var(--space-2);">
                  {{ 'products.product.preorder_note' | t }}
                </p>
              {%- endif -%}
            </product-form>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}

          {%- when 'accordion' -%}
            {%- liquid
              assign content = block.settings.content
              if block.settings.metafield != blank
                assign parts = block.settings.metafield | split: '.'
                assign namespace = parts[0]
                assign key = parts[1]
                assign meta_value = product.metafields[namespace][key]
                if meta_value != blank
                  assign content = meta_value
                endif
              endif
            -%}

            {%- if content != blank -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary>
                  {{ block.settings.heading }}
                  {% render 'icon', name: 'plus' %}
                </summary>
                <div class="accordion__content rte">{{ content }}</div>
              </details>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'share' -%}
            <a
              class="underline eyebrow"
              href="https://wa.me/?text={{ shop.url | append: product.url | url_encode }}"
              target="_blank"
              rel="noopener"
              aria-describedby="a11y-new-window-message"
              {{ block.shopify_attributes }}
            >
              {{ 'products.product.share' | t }}
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if has_size_guide -%}
  {%- comment -%}
    Native <dialog>: showModal() brings its own focus trap and Escape handling.
    theme.js opens it; when the trigger is a link to the size-guide page it
    stays a working link if the script never runs.
  {%- endcomment -%}
  <dialog class="size-guide" id="{{ size_guide_id }}" data-size-guide>
    <div class="size-guide__panel">
      <div class="size-guide__head">
        <h2 class="h4">{{ size_guide_label }}</h2>
        <button
          type="button"
          class="header__icon"
          data-size-guide-close
          aria-label="{{ 'general.close' | t }}"
        >
          {% render 'icon', name: 'close' %}
        </button>
      </div>

      <div class="size-guide__body rte">
        {%- if size_guide_image != blank -%}
          <img
            class="size-guide__image"
            src="{{ size_guide_image | image_url: width: 1400 }}"
            srcset="
              {{ size_guide_image | image_url: width: 600 }} 600w,
              {{ size_guide_image | image_url: width: 1000 }} 1000w,
              {{ size_guide_image | image_url: width: 1400 }} 1400w
            "
            sizes="(min-width: 750px) 68rem, 92vw"
            alt="{{ size_guide_image.alt | default: size_guide_label | escape }}"
            {% if size_guide_image.width %}width="{{ size_guide_image.width }}"{% endif %}
            {% if size_guide_image.height %}height="{{ size_guide_image.height }}"{% endif %}
            loading="lazy"
          >
        {%- endif -%}

        {{ size_guide_content }}
      </div>

      {%- if size_guide_url != blank -%}
        <a class="size-guide__link underline eyebrow" href="{{ size_guide_url }}">
          {{ 'products.product.size_guide_full' | t }}
        </a>
      {%- endif -%}
    </div>
  </dialog>
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 400 | json }},
    "sku": {{ current_variant.sku | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
    {%- if product.featured_media -%}
      "image": {{ product.featured_media | image_url: width: 1200 | prepend: "https:" | json }},
    {%- endif -%}
    "url": {{ shop.url | append: product.url | json }},
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "sku": {{ variant.sku | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "url": {{ shop.url | append: product.url | append: '?variant=' | append: variant.id | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "main-product-section",
  "settings": [
    {
      "type": "select",
      "id": "media_layout",
      "label": "t:sections.main_product.settings.media_layout.label",
      "options": [
        { "value": "stacked", "label": "t:sections.main_product.settings.media_layout.options__1" },
        { "value": "thumbnails", "label": "t:sections.main_product.settings.media_layout.options__2" }
      ],
      "default": "stacked"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "t:sections.main_product.settings.enable_sticky_info.label",
      "default": true
    },
    {
      "type": "header",
      "content": "Size guide"
    },
    {
      "type": "checkbox",
      "id": "show_size_guide",
      "label": "Show size guide button",
      "default": true,
      "info": "The button sits next to the size selector and opens a popup."
    },
    {
      "type": "text",
      "id": "size_guide_label",
      "label": "Button label",
      "default": "Size guide"
    },
    {
      "type": "image_picker",
      "id": "size_guide_image",
      "label": "Size chart image",
      "info": "Shown at the top of the popup. A product metafield custom.size_guide_image overrides it per product."
    },
    {
      "type": "page",
      "id": "size_guide_page",
      "label": "Size guide page",
      "info": "The page content fills the popup, below the image. Leave empty to use the text below instead."
    },
    {
      "type": "richtext",
      "id": "size_guide_content",
      "label": "Size guide text",
      "info": "Used only when no page is selected. A product metafield custom.size_guide overrides both."
    }
  ],
  "blocks": [
    { "type": "badges", "name": "Badges", "limit": 1 },
    { "type": "title", "name": "t:sections.main_product.blocks.title.name", "limit": 1 },
    { "type": "price", "name": "t:sections.main_product.blocks.price.name", "limit": 1 },
    { "type": "variant_picker", "name": "t:sections.main_product.blocks.variant_picker.name", "limit": 1 },
    { "type": "quantity_selector", "name": "t:sections.main_product.blocks.quantity_selector.name", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "t:sections.main_product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
          "default": true
        },
        {
          "type": "text",
          "id": "assurance",
          "label": "Reassurance line",
          "info": "Short points separated by commas, shown under the buttons. Leave empty to hide.",
          "default": "Secure checkout, Ships in 2-4 days, Easy exchanges"
        }
      ]
    },
    { "type": "description", "name": "t:sections.main_product.blocks.description.name", "limit": 1 },
    {
      "type": "accordion",
      "name": "t:sections.main_product.blocks.accordion.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.main_product.blocks.accordion.settings.heading.label",
          "default": "Materials"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.main_product.blocks.accordion.settings.content.label"
        },
        {
          "type": "text",
          "id": "metafield",
          "label": "t:sections.main_product.blocks.accordion.settings.metafield.label",
          "info": "t:sections.main_product.blocks.accordion.settings.metafield.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.main_product.blocks.text.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.main_product.blocks.text.settings.text.label"
        }
      ]
    },
    { "type": "share", "name": "t:sections.main_product.blocks.share.name", "limit": 1 }
  ]
}
{% endschema %}
