<section class="section">
  <div class="container account">
    <div>
      <p class="eyebrow">{{ 'customer.account.title' | t }}</p>
      <h1 class="h2" style="margin-top: var(--space-2); margin-bottom: var(--space-5);">{{ 'customer.addresses.title' | t }}</h1>

      <details class="accordion accordion--card" id="AddNewAddress" style="margin-bottom: var(--space-6);">
        <summary>
          {{ 'customer.addresses.add_new' | t }}
          {% render 'icon', name: 'plus' %}
        </summary>

        <div class="accordion__content account__form">
          {%- form 'customer_address', customer.new_address, class: 'form' -%}
            {% render 'address-fields', form: form %}
            <div class="btn-row">
              <button type="submit" class="btn">{{ 'customer.addresses.add' | t }}</button>
            </div>
          {%- endform -%}
        </div>
      </details>

      {%- paginate customer.addresses by 10 -%}
        <div class="address-list">
          {%- for address in customer.addresses -%}
            <div class="address-card" id="Address-{{ address.id }}">
              {%- if address == customer.default_address -%}
                <span class="badge">{{ 'customer.addresses.default' | t }}</span>
              {%- endif -%}

              <div style="margin-block: var(--space-2) var(--space-3);">{{ address | format_address }}</div>

              <details class="accordion">
                <summary class="small">
                  {{ 'customer.addresses.edit' | t }}
                  {% render 'icon', name: 'chevron-down' %}
                </summary>

                <div class="accordion__content account__form">
                  {%- form 'customer_address', address, class: 'form' -%}
                    {% render 'address-fields', form: form %}
                    <div class="btn-row">
                      <button type="submit" class="btn btn--sm">{{ 'customer.addresses.update' | t }}</button>
                    </div>
                  {%- endform -%}
                </div>
              </details>

              <div class="address-card__actions">
                <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" data-address-delete-form>
                  <input type="hidden" name="_method" value="delete">
                  <button type="submit" class="btn btn--ghost btn--sm" data-confirm-message="{{ 'customer.addresses.delete_confirm' | t | escape }}">
                    {{ 'customer.addresses.delete' | t }}
                  </button>
                </form>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}

      <p style="margin-top: var(--space-6);">
        <a class="btn btn--ghost" href="{{ routes.account_url }}">
          {% render 'icon', name: 'chevron-left' %}
          {{ 'customer.account.return' | t }}
        </a>
      </p>
    </div>
  </div>
</section>

<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Shopify === 'undefined' || !Shopify.CountryProvinceSelector) return;

    document.querySelectorAll('[data-address-country]').forEach(function (countrySelect) {
      var container = countrySelect.closest('form');
      if (!container) return;
      var provinceSelect = container.querySelector('[data-address-province]');
      var provinceContainer = container.querySelector('[data-address-province-container]');
      if (!provinceSelect || !provinceContainer) return;
      countrySelect.id = countrySelect.id || 'AddressCountry-' + Math.random().toString(36).slice(2);
      provinceSelect.id = provinceSelect.id || 'AddressProvince-' + Math.random().toString(36).slice(2);
      new Shopify.CountryProvinceSelector(countrySelect.id, provinceSelect.id, {
        hideElement: provinceContainer.id
      });
    });

    document.querySelectorAll('[data-address-delete-form]').forEach(function (form) {
      form.addEventListener('submit', function (event) {
        var button = form.querySelector('[data-confirm-message]');
        var message = button ? button.getAttribute('data-confirm-message') : '';
        if (message && !window.confirm(message)) event.preventDefault();
      });
    });
  });
</script>
