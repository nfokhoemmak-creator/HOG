{%- comment -%}
  Renders a 5-star rating.

  Accepts:
  - rating: {Number} 0–5, decimals allowed (default 5)
  - class: {String} extra classes, e.g. 'stars--lg'

  Usage:
  {% render 'stars', rating: 4.5, class: 'stars--lg' %}
{%- endcomment -%}

{%- liquid
  assign value = rating | default: 5 | times: 1.0
  if value > 5
    assign value = 5.0
  endif
  assign full = value | floor
  assign remainder = value | minus: full
  assign has_half = false
  if remainder >= 0.4 and remainder < 0.9
    assign has_half = true
  elsif remainder >= 0.9
    assign full = full | plus: 1
  endif
  assign half_index = full | plus: 1
-%}

<span class="stars {{ class }}" role="img" aria-label="{{ 'products.reviews.rating_label' | t: rating: value }}">
  {%- for i in (1..5) -%}
    {%- if i <= full -%}
      {% render 'icon', name: 'star' %}
    {%- elsif has_half and i == half_index -%}
      {% render 'icon', name: 'star-half' %}
    {%- else -%}
      <svg viewBox="0 0 24 24" class="is-empty" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
    {%- endif -%}
  {%- endfor -%}
</span>
