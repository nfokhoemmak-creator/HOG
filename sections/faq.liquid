<div class="section{% if section.settings.background == 'alt' %} section--alt{% endif %}" id="faq">
  <div class="container container--medium">
    <div class="section__head section__head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="lead">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="faq">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>
            {{ block.settings.question }}
            {% render 'icon', name: 'plus' %}
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "faq-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Good to know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions? We've got answers."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question by default",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Alternate" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How much is shipping and how fast is delivery?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Shipping is a flat $4 anywhere in Lebanon. Orders ship within 24 hours and arrive in 1–3 business days. Cash on delivery is available.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Does it hurt? What does the tingle feel like?", "answer": "<p>You'll feel a warm, tingly buzz for a few minutes — that's the plumping actives boosting circulation in your lips. It fades on its own; the plump stays.</p>" } },
        { "type": "question", "settings": { "question": "How long does the plump last?", "answer": "<p>Most people see fuller-looking lips for a few hours after each application. Reapply whenever you like.</p>" } },
        { "type": "question", "settings": { "question": "How much is shipping and how fast is delivery?", "answer": "<p>Shipping is a flat $4 anywhere in Lebanon. Orders ship within 24 hours and arrive in 1–3 business days. Cash on delivery is available.</p>" } },
        { "type": "question", "settings": { "question": "What if it doesn't work for me?", "answer": "<p>Message us on WhatsApp within 30 days and we'll sort out a refund or exchange.</p>" } }
      ]
    }
  ]
}
{% endschema %}
