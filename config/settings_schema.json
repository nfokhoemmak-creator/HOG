[
  {
    "name": "theme_info",
    "theme_name": "Goodest Chews",
    "theme_version": "1.0.0",
    "theme_author": "Goodest Chews",
    "theme_documentation_url": "https://goodestchews.com",
    "theme_support_url": "https://goodestchews.com/pages/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Upload the Goodest Chews logo (PNG with transparent background). Until one is uploaded the theme draws the wordmark in brand colours."
      },
      {
        "type": "image_picker",
        "id": "logo_inverse",
        "label": "Logo for dark backgrounds",
        "info": "Used in the footer. If empty, the footer draws the cream wordmark."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 100,
        "max": 360,
        "step": 10,
        "unit": "px",
        "label": "Logo width (desktop)",
        "default": 190
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square PNG, at least 180×180px."
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Tagline",
        "default": "For the goodest dogs."
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social sharing image",
        "info": "1200×630px. Used when the homepage is shared on social media."
      },
      {
        "type": "product",
        "id": "featured_product",
        "label": "The product",
        "info": "Your one product. Every buy button, bundle card and sticky bar in the theme points at it."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "header", "content": "Surfaces" },
      { "type": "color", "id": "color_background", "label": "Background (cream)", "default": "#FFFBF4" },
      { "type": "color", "id": "color_background_alt", "label": "Alternate background", "default": "#F6EEDF" },
      { "type": "color", "id": "color_border", "label": "Borders", "default": "#EADFCB" },
      { "type": "header", "content": "Text" },
      { "type": "color", "id": "color_text", "label": "Text", "default": "#1F2D26" },
      { "type": "color", "id": "color_text_muted", "label": "Muted text", "default": "#5D6B64" },
      { "type": "header", "content": "Brand colours" },
      { "type": "color", "id": "color_primary", "label": "Green", "default": "#0F5132" },
      { "type": "color", "id": "color_primary_dark", "label": "Green (dark)", "default": "#0A3B24" },
      { "type": "color", "id": "color_accent", "label": "Orange", "default": "#F07F1F" },
      { "type": "color", "id": "color_accent_dark", "label": "Orange (dark)", "default": "#B45309" },
      { "type": "color", "id": "color_star", "label": "Review stars", "default": "#F5B301" },
      { "type": "color", "id": "color_sale", "label": "Savings / sale", "default": "#D93A3A" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "select",
        "id": "type_heading_font",
        "label": "Heading font",
        "options": [
          { "value": "fredoka", "label": "Fredoka (rounded, matches the logo)" },
          { "value": "baloo", "label": "Baloo 2 (rounded, softer)" },
          { "value": "nunito", "label": "Nunito (clean)" }
        ],
        "default": "fredoka"
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading size",
        "default": 100
      },
      {
        "type": "range",
        "id": "type_body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Body text size",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout & motion",
    "settings": [
      { "type": "range", "id": "layout_max_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Page width", "default": 1280 },
      { "type": "range", "id": "layout_gutter", "min": 12, "max": 48, "step": 2, "unit": "px", "label": "Side gutter", "default": 20 },
      { "type": "range", "id": "layout_corner_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Corner radius", "default": 20 },
      { "type": "checkbox", "id": "animations_enabled", "label": "Enable animations", "default": true, "info": "Reveal-on-scroll, floating chips and hover motion. Always off for visitors who prefer reduced motion." }
    ]
  },
  {
    "name": "Trust & guarantee",
    "settings": [
      { "type": "range", "id": "guarantee_days", "min": 14, "max": 120, "step": 2, "unit": "d", "label": "Guarantee length (days)", "default": 60 },
      { "type": "text", "id": "guarantee_title", "label": "Guarantee name", "default": "Happy Dog Guarantee" },
      { "type": "text", "id": "guarantee_short", "label": "Guarantee one-liner", "default": "If your dog doesn't love them, we refund you. No bag returns, no questions." },
      { "type": "text", "id": "shipping_short", "label": "Shipping one-liner", "default": "Ships within 1–2 business days · tracked delivery" },
      { "type": "text", "id": "rating_value", "label": "Average rating (hero, product page)", "info": "Leave empty until you have real reviews. Enter e.g. 4.8 to show stars in the hero and on the product page. The reviews section computes its own average from the reviews it shows." },
      { "type": "text", "id": "rating_label", "label": "Rating label", "default": "from happy dog parents" }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      { "type": "checkbox", "id": "cart_show_note", "label": "Show order note", "default": false },
      { "type": "checkbox", "id": "cart_show_upsell", "label": "Show 'bundle & save' nudge", "default": true },
      { "type": "richtext", "id": "cart_notice", "label": "Cart notice", "default": "<p>Backed by our [days]-day Happy Dog Guarantee.</p>", "info": "[days] is replaced with the guarantee length." }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "text", "id": "social_instagram_link", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok_link", "label": "TikTok URL" },
      { "type": "text", "id": "social_facebook_link", "label": "Facebook URL" },
      { "type": "text", "id": "social_whatsapp_link", "label": "WhatsApp link", "info": "Format: https://wa.me/ followed by country code and number, no spaces or plus sign." }
    ]
  },
  {
    "name": "Compliance",
    "settings": [
      { "type": "checkbox", "id": "show_disclaimer", "label": "Show supplement disclaimer in footer", "default": true },
      {
        "type": "textarea",
        "id": "disclaimer_text",
        "label": "Disclaimer",
        "default": "These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Goodest Chews is a supplement for dogs and is not a substitute for veterinary care. Consult your vet before use if your dog is pregnant, nursing, on medication, or has a medical condition."
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      { "type": "checkbox", "id": "predictive_search_enabled", "label": "Enable predictive search", "default": true }
    ]
  }
]
