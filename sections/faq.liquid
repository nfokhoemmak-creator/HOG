<div class="section{% if section.settings.background == 'alt' %} section--alt{% endif %}" id="faq">
  <div class="container container--medium">
    <div class="section__head section__head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="lead">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="faq">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>
            {{ block.settings.question }}
            {% render 'icon', name: 'plus' %}
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "faq-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Good to know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions? We've got answers."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question by default",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Alternate" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does delivery take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Orders ship within 24 hours and arrive in 1–3 business days anywhere in Lebanon. You'll get a WhatsApp message with tracking as soon as it's on the way.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How long does delivery take?", "answer": "<p>Orders ship within 24 hours and arrive in 1–3 business days anywhere in Lebanon. You'll get a WhatsApp message with tracking as soon as it's on the way.</p>" } },
        { "type": "question", "settings": { "question": "Can I pay cash on delivery?", "answer": "<p>Yes. Choose cash on delivery at checkout, or pay securely by card or Apple Pay.</p>" } },
        { "type": "question", "settings": { "question": "Is Jamalati suitable for sensitive skin?", "answer": "<p>Every formula is dermatologist-tested and free from parabens, sulfates and synthetic fragrance. If you have a known allergy, check the full ingredient list on each product page.</p>" } },
        { "type": "question", "settings": { "question": "What if it doesn't work for me?", "answer": "<p>Give it 14 days. If you don't love your results, contact us within 30 days for a full refund or exchange on unopened products.</p>" } },
        { "type": "question", "settings": { "question": "Are your products cruelty-free?", "answer": "<p>100%. We never test on animals and neither do our suppliers.</p>" } }
      ]
    }
  ]
}
{% endschema %}
