{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign whatsapp_number = settings.social_whatsapp_number | remove: ' ' | remove: '+' | remove: '-'
  assign year = 'now' | date: '%Y'
  assign has_social = false
  if settings.social_instagram_link != blank or settings.social_tiktok_link != blank or settings.social_facebook_link != blank
    assign has_social = true
  endif
  assign policy_count = 0
  for policy in shop.policies
    if policy.body != blank
      assign policy_count = policy_count | plus: 1
    endif
  endfor
  assign newsletter_id = 'newsletter-' | append: section.id
-%}

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div class="footer__col footer__col--brand" {{ block.shopify_attributes }}>
              {%- if settings.logo != blank and block.settings.show_logo -%}
                {%- liquid
                  assign brand_logo_width = 140
                  assign brand_logo_height = brand_logo_width | times: settings.logo.height | divided_by: settings.logo.width
                -%}
                <a class="footer__logo" href="{{ routes.root_url }}">
                  <img
                    src="{{ settings.logo | image_url: width: 280 }}"
                    alt="{{ settings.logo.alt | default: shop.name | escape }}"
                    width="{{ brand_logo_width }}"
                    height="{{ brand_logo_height }}"
                    loading="lazy"
                  >
                </a>
              {%- else -%}
                <p class="footer__wordmark h4">{{ shop.name }}</p>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="footer__text rte">{{ block.settings.text }}</div>
              {%- endif -%}

              <div class="footer__contact btn-row">
                {%- if block.settings.show_whatsapp and whatsapp_number != blank -%}
                  <a class="btn btn--sm footer__whatsapp" href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener">
                    {% render 'icon', name: 'whatsapp' %}
                    {{ 'general.whatsapp_cta' | t }}
                  </a>
                {%- endif -%}
                {%- if block.settings.email != blank -%}
                  <a class="btn btn--sm btn--outline footer__email" href="mailto:{{ block.settings.email }}">
                    {{ block.settings.email }}
                  </a>
                {%- endif -%}
              </div>
            </div>

          {%- when 'menu' -%}
            {%- assign menu = linklists[block.settings.menu] -%}
            {%- if menu.links.size > 0 -%}
              <div class="footer__col" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading h5">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <ul class="footer__menu">
                  {%- for link in menu.links -%}
                    <li><a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading h5">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="footer__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}

      {%- if section.settings.show_newsletter -%}
        <div class="footer__col footer__col--newsletter">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="footer__heading h5">{{ section.settings.newsletter_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}
            <p class="footer__text">{{ section.settings.newsletter_text }}</p>
          {%- endif -%}

          {%- form 'customer', id: newsletter_id, class: 'newsletter__form footer__newsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {%- if form.posted_successfully? -%}
              <p class="form__success" role="status" tabindex="-1">
                {% render 'icon', name: 'check' %}
                {{ 'sections.newsletter.success' | t }}
              </p>
            {%- else -%}
              <div class="newsletter__row">
                <label class="visually-hidden" for="{{ section.id }}-email">{{ 'sections.newsletter.email' | t }}</label>
                <input
                  id="{{ section.id }}-email"
                  class="field__input newsletter__input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="{{ 'sections.newsletter.email' | t }}"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="{{ section.id }}-error"
                  {% endif %}
                >
                <button type="submit" class="btn newsletter__submit" name="commit">
                  {{ 'sections.newsletter.submit' | t }}
                </button>
              </div>

              {%- if form.errors -%}
                <p class="form__error" id="{{ section.id }}-error" role="alert">
                  {{ 'sections.newsletter.error' | t }}
                  {%- if form.errors.messages.email %} {{ form.errors.messages.email }}{% endif -%}
                </p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}

          {%- if section.settings.show_social and has_social -%}
            <div class="footer__social">
              <p class="footer__social-heading small">{{ 'sections.footer.follow' | t }}</p>
              {% render 'social-links' %}
            </div>
          {%- endif -%}
        </div>
      {%- elsif section.settings.show_social and has_social -%}
        <div class="footer__col">
          <h2 class="footer__heading h5">{{ 'sections.footer.follow' | t }}</h2>
          {% render 'social-links' %}
        </div>
      {%- endif -%}
    </div>

    <div class="footer__bottom">
      <div class="footer__legal">
        <p class="footer__copyright small">
          {{ 'sections.footer.copyright' | t: year: year, shop: shop.name }}
        </p>

        {%- if section.settings.show_policies and policy_count > 0 -%}
          <ul class="footer__policies small">
            {%- for policy in shop.policies -%}
              {%- if policy.body != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payment">
          <p class="visually-hidden">{{ 'sections.footer.payment' | t }}</p>
          <ul class="payment-list" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "footer-section",
  "max_blocks": 5,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true,
      "info": "Subscribers are tagged \"newsletter\" in Customers."
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Join the shark pack"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Text",
      "default": "New styles, restocks and bundle deals — no spam."
    },
    {
      "type": "header",
      "content": "Extras"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true,
      "info": "Set the links in Theme settings > Social. Empty links are hidden."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "default": true,
      "info": "Links every store policy that has content (Settings > Policies)."
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_logo",
          "label": "Show logo",
          "default": true
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Shark Bite — plush shark slippers and the famous shark blanket, made for cozy people in Lebanon.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_whatsapp",
          "label": "Show WhatsApp button",
          "default": true,
          "info": "Uses the WhatsApp number from Theme settings > Social."
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email address",
          "default": "sharkbitee.lb@gmail.com"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "main-menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Delivery"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Delivery across Lebanon: standard courier 3–5 days ($3, free over $30) or express 1–2 days ($6). Orders are prepared within 3–5 business days.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
