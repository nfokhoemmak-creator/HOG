{{ 'section-faq.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme = section.settings.color_scheme | default: 'default'
  assign padding_mobile_top = section.settings.padding_top | times: 0.75 | round
  assign padding_mobile_bottom = section.settings.padding_bottom | times: 0.75 | round
  assign whatsapp_number = settings.social_whatsapp_number | replace: ' ', '' | replace: '+', ''
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .faq {
    padding-top: {{ padding_mobile_top }}px;
    padding-bottom: {{ padding_mobile_bottom }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .faq {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="faq section{% if scheme != 'default' %} section--{{ scheme }}{% endif %}">
  <div class="container container--narrow">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <header class="section__header section__header--center faq__header">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="section__title h2">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="section__subtitle">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="faq__list">
        {%- for block in section.blocks -%}
          {%- if block.settings.question == blank -%}
            {%- continue -%}
          {%- endif -%}
          <details class="accordion faq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary>
              <span class="faq__question">{{ block.settings.question | escape }}</span>
              {% render 'icon', name: 'chevron-down' %}
            </summary>
            <div class="accordion__content rte faq__answer">
              {%- case block.type -%}
                {%- when 'payment_methods' -%}
                  {%- if block.settings.intro != blank -%}
                    <p>{{ block.settings.intro | escape }}</p>
                  {%- endif -%}
                  {%- if shop.enabled_payment_types.size > 0 -%}
                    <ul class="faq__payments" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
                      {%- for type in shop.enabled_payment_types -%}
                        <li>{{ type | payment_type_svg_tag: class: 'faq__payment-icon' }}</li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                  {%- if block.settings.contact_text != blank -%}
                    <p>
                      {%- if whatsapp_number != blank -%}
                        <a href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener">{{ block.settings.contact_text | escape }}</a>
                      {%- else -%}
                        {{ block.settings.contact_text | escape }}
                      {%- endif -%}
                    </p>
                  {%- endif -%}
                {%- else -%}
                  {{ block.settings.answer }}
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.show_json_ld and section.blocks.size > 0 -%}
  {%- assign faq_index = 0 -%}
  {%- capture faq_entities -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.question == blank -%}
        {%- continue -%}
      {%- endif -%}
      {%- liquid
        if block.type == 'payment_methods'
          assign answer_text = block.settings.intro | strip | append: ' the payment methods shown at checkout.'
        else
          assign answer_text = block.settings.answer | strip_html | strip_newlines | strip
        endif
      -%}
      {%- if faq_index > 0 -%},{%- endif -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | strip | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ answer_text | json }}
        }
      }
      {%- assign faq_index = faq_index | plus: 1 -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if faq_index > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [{{ faq_entities }}]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions? Bitten answers."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question by default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_json_ld",
      "label": "Add FAQ structured data (SEO)",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Soft aqua" },
        { "value": "brand", "label": "Navy" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I pick my size?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Sizes run in EU pairs (36-37 … 44-45). Pick the pair that contains your usual EU size; if you're between sizes, go up. See the size guide.</p>"
        }
      ]
    },
    {
      "type": "payment_methods",
      "name": "Payment methods",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I pay?"
        },
        {
          "type": "text",
          "id": "intro",
          "label": "Intro",
          "default": "Pay securely at checkout with:",
          "info": "The payment icons come from your store's enabled payment methods."
        },
        {
          "type": "text",
          "id": "contact_text",
          "label": "Contact line",
          "default": "Questions? WhatsApp us at +961 71 801 588."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How do I pick my size?",
            "answer": "<p>Sizes run in EU pairs (36-37 … 44-45). Pick the pair that contains your usual EU size; if you're between sizes, go up. See the size guide.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How fast is delivery?",
            "answer": "<p>Orders are prepared within 3–5 business days, then delivered by standard courier (3–5 days, $3 — free over $30) or express courier (1–2 days, $6).</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do bundle discounts work?",
            "answer": "<p>Add 2 or more pairs and 20% comes off automatically in your cart. Add the shark blanket with any slippers and the blanket is 25% off. No codes.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I exchange or return?",
            "answer": "<p>All sales are final, but if your order arrives damaged or defective, message us on WhatsApp within 7 days and we'll replace it.</p>"
          }
        },
        {
          "type": "payment_methods",
          "settings": {
            "question": "How do I pay?",
            "intro": "Pay securely at checkout with:",
            "contact_text": "Questions? WhatsApp us at +961 71 801 588."
          }
        }
      ]
    }
  ]
}
{% endschema %}
