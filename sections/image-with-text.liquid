<div class="section{% if section.settings.background == 'alt' %} section--alt{% endif %}">
  <div class="container">
    <div class="image-with-text image-with-text--{{ section.settings.layout }}{% if settings.animations_enabled %} reveal{% endif %}">
      <div class="image-with-text__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1400 }}"
            srcset="
              {{ section.settings.image | image_url: width: 700 }} 700w,
              {{ section.settings.image | image_url: width: 1400 }} 1400w
            "
            sizes="(min-width: 750px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: '' }}
        {%- endif -%}
      </div>

      <div class="image-with-text__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="lead rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="stat-row">
            {%- for block in section.blocks -%}
              <div class="stat" {{ block.shopify_attributes }}>
                <span class="stat__value">{{ block.settings.value }}</span>
                <span class="stat__label">{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--outline" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "tag": "section",
  "class": "image-with-text-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image_with_text.settings.image.label"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.image_with_text.settings.layout.label",
      "options": [
        { "value": "left", "label": "t:sections.image_with_text.settings.layout.options__1" },
        { "value": "right", "label": "t:sections.image_with_text.settings.layout.options__2" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.image_with_text.settings.eyebrow.label",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.image_with_text.settings.heading.label",
      "default": "Made for your skin, not for the trend"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.image_with_text.settings.text.label",
      "default": "<p>Jamalati started with one frustration: beauty that promised everything and delivered irritation. So we built formulas around effective doses of proven actives, tested them on real skin, and left out everything that doesn't belong on your face.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.image_with_text.settings.button_label.label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.image_with_text.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "alt", "label": "Alternate" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:sections.image_with_text.blocks.stat.name",
      "settings": [
        { "type": "text", "id": "value", "label": "t:sections.image_with_text.blocks.stat.settings.value.label", "default": "10k+" },
        { "type": "text", "id": "label", "label": "t:sections.image_with_text.blocks.stat.settings.label.label", "default": "Happy customers" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_with_text.name",
      "blocks": [
        { "type": "stat", "settings": { "value": "10k+", "label": "Happy customers" } },
        { "type": "stat", "settings": { "value": "4.9★", "label": "Average rating" } },
        { "type": "stat", "settings": { "value": "0", "label": "Harsh ingredients" } }
      ]
    }
  ]
}
{% endschema %}
