<div class="container">
  <div class="collection-banner{% if section.settings.text_alignment == 'center' %} collection-banner--center{% endif %}">
    <h1 class="collection-banner__title">{{ collection.title | escape }}</h1>

    {%- if section.settings.show_count -%}
      <p class="eyebrow">
        {{ 'sections.collection_template.product_count_simple' | t: count: collection.products_count }}
      </p>
    {%- endif -%}

    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="muted collection-banner__description">{{ collection.description }}</div>
    {%- endif -%}

    {%- if section.settings.show_image and collection.image -%}
      <img
        src="{{ collection.image | image_url: width: 1800 }}"
        srcset="
          {{ collection.image | image_url: width: 900 }} 900w,
          {{ collection.image | image_url: width: 1800 }} 1800w
        "
        sizes="100vw"
        alt="{{ collection.image.alt | escape }}"
        width="{{ collection.image.width }}"
        height="{{ collection.image.height }}"
        style="width: 100%; aspect-ratio: 21 / 9; object-fit: cover; border-radius: var(--radius); margin-top: var(--space-4);"
      >
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_collection_banner.name",
  "tag": "section",
  "class": "collection-banner-section",
  "settings": [
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.main_collection_banner.settings.text_alignment.label",
      "options": [
        { "value": "left", "label": "t:sections.main_collection_banner.settings.text_alignment.options__1" },
        { "value": "center", "label": "t:sections.main_collection_banner.settings.text_alignment.options__2" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.main_collection_banner.settings.show_count.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.main_collection_banner.settings.show_image.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.main_collection_banner.settings.show_description.label",
      "default": true
    }
  ]
}
{% endschema %}
