{%- comment -%}
  Emits the :root design tokens from theme settings. Rendered by
  layout/theme.liquid, layout/password.liquid and templates/gift_card.liquid.
{%- endcomment -%}

{%- liquid
  case settings.type_heading_font
    when 'baloo'
      assign heading_family = "'Baloo 2', 'Fredoka', 'Nunito', system-ui, sans-serif"
    when 'nunito'
      assign heading_family = "'Nunito', system-ui, sans-serif"
    else
      assign heading_family = "'Fredoka', 'Nunito', system-ui, sans-serif"
  endcase
-%}

<style>
  :root {
    --font-heading: {{ heading_family }};
    --font-body: 'Nunito', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --heading-scale: {{ settings.type_heading_scale | divided_by: 100.0 }};
    --body-scale: {{ settings.type_body_scale | divided_by: 100.0 }};

    --color-bg: {{ settings.color_background }};
    --color-bg-alt: {{ settings.color_background_alt }};
    --color-border: {{ settings.color_border }};
    --color-fg: {{ settings.color_text }};
    --color-muted: {{ settings.color_text_muted }};
    --color-green: {{ settings.color_primary }};
    --color-green-dark: {{ settings.color_primary_dark }};
    --color-orange: {{ settings.color_accent }};
    --color-orange-dark: {{ settings.color_accent_dark }};
    --color-star: {{ settings.color_star }};
    --color-sale: {{ settings.color_sale }};
    --color-green-rgb: {{ settings.color_primary | color_extract: 'red' }}, {{ settings.color_primary | color_extract: 'green' }}, {{ settings.color_primary | color_extract: 'blue' }};
    --color-orange-rgb: {{ settings.color_accent | color_extract: 'red' }}, {{ settings.color_accent | color_extract: 'green' }}, {{ settings.color_accent | color_extract: 'blue' }};
    --color-green-soft: {{ settings.color_primary | color_mix: settings.color_background, 12 }};
    --color-orange-soft: {{ settings.color_accent | color_mix: settings.color_background, 16 }};

    --container: {{ settings.layout_max_width }}px;
    --gutter: {{ settings.layout_gutter }}px;
    --radius: {{ settings.layout_corner_radius }}px;
    --radius-sm: {{ settings.layout_corner_radius | divided_by: 2 | at_least: 6 }}px;
  }
</style>
