{%- assign fp = settings.featured_product -%}
<div class="container">
  <div class="empty-state" style="padding-block: var(--space-9);">
    {% render 'icon', name: 'dog' %}
    <h1>{{ 'sections.404.title' | t }}</h1>
    <p class="lead muted">{{ 'sections.404.subtext' | t }}</p>
    <a class="btn" href="{% if fp != blank %}{{ fp.url }}{% else %}{{ routes.root_url }}{% endif %}">{{ 'sections.404.link' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "settings": []
}
{% endschema %}
