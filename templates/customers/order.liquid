{%- liquid
  assign created_date = order.created_at | date: '%b %d, %Y'
  assign cancelled_date = order.cancelled_at | date: '%b %d, %Y'
-%}

<div class="container account" style="grid-template-columns: 1fr;">
  <div>
    <h1 class="h2">{{ 'customer.order.title' | t: name: order.name }}</h1>
    <p class="muted">{{ 'customer.order.date_html' | t: date: created_date }}</p>

    {%- if order.cancelled -%}
      <p class="form__error">
        {{ 'customer.order.cancelled_html' | t: date: cancelled_date }}
        {{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}
      </p>
    {%- endif -%}

    <table class="order-table" style="margin-top: var(--space-5);">
      <thead>
        <tr>
          <th>{{ 'customer.order.product' | t }}</th>
          <th>{{ 'customer.order.sku' | t }}</th>
          <th>{{ 'customer.order.price' | t }}</th>
          <th>{{ 'customer.order.quantity' | t }}</th>
          <th>{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>
              <a class="underline" href="{{ line_item.product.url }}">{{ line_item.title }}</a>
              {%- if line_item.fulfillment -%}
                {%- assign fulfilled_date = line_item.fulfillment.created_at | date: '%b %d, %Y' -%}
                <div class="muted" style="font-size: 1.2rem;">
                  {{ 'customer.order.fulfilled_at_html' | t: date: fulfilled_date }}
                  {%- if line_item.fulfillment.tracking_url -%}
                    &middot;
                    <a class="underline" href="{{ line_item.fulfillment.tracking_url }}">
                      {{ 'customer.order.track_shipment' | t }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </td>
            <td>{{ line_item.sku }}</td>
            <td>{{ line_item.price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4">{{ 'customer.order.subtotal' | t }}</td>
          <td>{{ order.line_items_subtotal_price | money }}</td>
        </tr>
        {%- for shipping_method in order.shipping_methods -%}
          <tr>
            <td colspan="4">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td>
            <td>{{ shipping_method.price | money }}</td>
          </tr>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <tr>
            <td colspan="4">{{ 'customer.order.tax' | t }} ({{ tax_line.title }})</td>
            <td>{{ tax_line.price | money }}</td>
          </tr>
        {%- endfor -%}
        <tr>
          <td colspan="4"><strong>{{ 'customer.order.total' | t }}</strong></td>
          <td><strong>{{ order.total_price | money_with_currency }}</strong></td>
        </tr>
      </tfoot>
    </table>

    <div style="display: grid; gap: var(--space-5); margin-top: var(--space-6);">
      <div class="address-card">
        <p class="eyebrow" style="margin-bottom: var(--space-2);">{{ 'customer.order.billing_address' | t }}</p>
        <p class="muted">{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>
        {{ order.billing_address | format_address }}
      </div>

      <div class="address-card">
        <p class="eyebrow" style="margin-bottom: var(--space-2);">{{ 'customer.order.shipping_address' | t }}</p>
        <p class="muted">{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>
        {{ order.shipping_address | format_address }}
      </div>
    </div>

    <p style="margin-top: var(--space-5);">
      <a class="underline" href="{{ routes.account_url }}">{{ 'customer.account.return' | t }}</a>
    </p>
  </div>
</div>
