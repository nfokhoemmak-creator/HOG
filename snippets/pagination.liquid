{%- comment -%}
  Renders numbered pagination.

  Accepts:
  - paginate: {Object} the paginate object from {% paginate %} (required)
  - anchor:   {String} optional fragment appended to every link (e.g. 'products')

  Usage:
  {% render 'pagination', paginate: paginate %}
{%- endcomment -%}

{%- if paginate.pages > 1 -%}
  {%- liquid
    assign fragment = ''
    if anchor != blank
      assign fragment = '#' | append: anchor
    endif
  -%}
  <nav class="pagination" aria-label="{{ 'pagination.label' | t }}">
    {%- if paginate.previous -%}
      <a class="pagination__item" href="{{ paginate.previous.url }}{{ fragment }}" aria-label="{{ 'pagination.previous' | t }}" rel="prev">
        {% render 'icon', name: 'chevron-left' %}
      </a>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a class="pagination__item" href="{{ part.url }}{{ fragment }}" aria-label="{{ 'pagination.page' | t: number: part.title }}">
          {{- part.title -}}
        </a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="pagination__item" aria-current="page" aria-label="{{ 'pagination.page' | t: number: part.title }}">
          {{- part.title -}}
        </span>
      {%- else -%}
        <span class="pagination__item pagination__item--gap" aria-hidden="true">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
      <a class="pagination__item" href="{{ paginate.next.url }}{{ fragment }}" aria-label="{{ 'pagination.next' | t }}" rel="next">
        {% render 'icon', name: 'chevron-right' %}
      </a>
    {%- endif -%}
  </nav>
{%- endif -%}
