{%- liquid
  assign collection = collections[section.settings.collection]
  if collection == blank
    assign collection = collections.all
  endif
-%}

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <h2>{{ section.settings.title | escape }}</h2>
    </div>
    <div class="product-grid" style="--cols: {{ section.settings.columns_desktop }};">
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', card_product: product %}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="product-card"><div class="product-card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div><span class="product-card__title">{{ 'onboarding.product_title' | t }}</span></div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 1, "max": 12, "step": 1, "label": "Products to show", "default": 3 },
    { "type": "range", "id": "columns_desktop", "min": 1, "max": 4, "step": 1, "label": "Columns on desktop", "default": 3 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
