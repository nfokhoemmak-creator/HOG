<div class="container account">
  <aside>
    <h1 class="h3" style="margin-bottom: var(--space-4);">{{ 'customer.account.title' | t }}</h1>
    <ul class="footer__menu">
      <li><a class="underline" href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t }}</a></li>
      <li><a class="underline" href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a></li>
    </ul>

    <div class="address-card" style="margin-top: var(--space-5);">
      <p class="eyebrow" style="margin-bottom: var(--space-2);">{{ 'customer.account.details' | t }}</p>
      {{ customer.default_address | format_address }}
    </div>
  </aside>

  <div>
    <h2 class="h4" style="margin-bottom: var(--space-4);">{{ 'customer.orders.title' | t }}</h2>

    {%- if customer.orders.size > 0 -%}
      {%- paginate customer.orders by 20 -%}
        <table class="order-table">
          <thead>
            <tr>
              <th>{{ 'customer.orders.order_number' | t }}</th>
              <th>{{ 'customer.orders.date' | t }}</th>
              <th>{{ 'customer.orders.payment_status' | t }}</th>
              <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
              <th>{{ 'customer.orders.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <td><a class="underline" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                <td>{{ order.financial_status_label }}</td>
                <td>{{ order.fulfillment_status_label }}</td>
                <td>{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- else -%}
      <p class="muted">{{ 'customer.orders.none' | t }}</p>
    {%- endif -%}
  </div>
</div>
