<div class="section">
  <div class="container">
    <div class="before-after{% if section.settings.layout == 'right' %} before-after--right{% endif %}">
      <before-after class="before-after__frame{% if section.settings.layout == 'right' %} order-2{% endif %}" style="--split: {{ section.settings.start_position }}%;">
        {%- if section.settings.image_before != blank -%}
          <img
            class="before-after__before"
            src="{{ section.settings.image_before | image_url: width: 1200 }}"
            alt="{{ section.settings.image_before.alt | default: section.settings.label_before | escape }}"
            width="{{ section.settings.image_before.width }}"
            height="{{ section.settings.image_before.height }}"
            loading="lazy"
            draggable="false"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'before-after__before' }}
        {%- endif -%}

        {%- if section.settings.image_after != blank -%}
          <img
            class="before-after__after"
            src="{{ section.settings.image_after | image_url: width: 1200 }}"
            alt="{{ section.settings.image_after.alt | default: section.settings.label_after | escape }}"
            width="{{ section.settings.image_after.width }}"
            height="{{ section.settings.image_after.height }}"
            loading="lazy"
            draggable="false"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'before-after__after' }}
        {%- endif -%}

        <span class="before-after__label before-after__label--before">{{ section.settings.label_before }}</span>
        <span class="before-after__label before-after__label--after">{{ section.settings.label_after }}</span>
        <div class="before-after__handle" aria-hidden="true"></div>

        <input
          class="before-after__range"
          type="range"
          min="0"
          max="100"
          value="{{ section.settings.start_position }}"
          aria-label="{{ 'accessibility.before_after_slider' | t }}"
        >
      </before-after>

      <div class="before-after__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="lead rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="checklist">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %}<span>{{ block.settings.text }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Before / after",
  "tag": "section",
  "class": "before-after-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "Before image",
      "info": "Use two photos taken in the same light and angle. Square works best."
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "label_before",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "label_after",
      "label": "After label",
      "default": "After 14 days"
    },
    {
      "type": "range",
      "id": "start_position",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Starting position",
      "default": 50
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "See the difference"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real skin. Real results. 14 days."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Drag the slider. In an independent 4-week trial, 94% of participants saw brighter, more even skin — with zero irritation.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start my glow"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Result point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "94% saw brighter skin"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Before / after",
      "blocks": [
        { "type": "point", "settings": { "text": "94% saw brighter, more even skin" } },
        { "type": "point", "settings": { "text": "89% said fine lines looked softer" } },
        { "type": "point", "settings": { "text": "100% reported zero irritation" } }
      ]
    }
  ]
}
{% endschema %}
