{%- comment -%}
  "Complete the fit" — recommendations rail on the product page. The server
  renders only the shell; <complete-look> (upsell.js) fetches recommendations
  client-side and hides the whole section when the endpoint has nothing, so
  the heading never sits above an empty rail.
{%- endcomment -%}

{%- if product -%}
  <div class="section">
    <div class="container">
      <div class="section__head">
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>

      <complete-look
        data-product-id="{{ product.id }}"
        data-intent="{{ section.settings.intent }}"
        data-limit="{{ section.settings.limit }}"
        data-exclude="{{ product.id }}"
      >
        <ul class="complete-look__list" data-upsell-list></ul>
      </complete-look>
    </div>
  </div>

  <script src="{{ 'upsell.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Complete the look",
  "tag": "section",
  "class": "complete-look-section",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COMPLETE THE FIT"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation intent",
      "options": [
        { "value": "complementary", "label": "Complementary (goes with it)" },
        { "value": "related", "label": "Related (similar pieces)" }
      ],
      "default": "complementary",
      "info": "Complementary falls back to related when the store has no complementary data."
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Complete the look"
    }
  ]
}
{% endschema %}
