{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
  assign saving = 0
  assign pct = 0
  if on_sale
    assign saving = current_variant.compare_at_price | minus: current_variant.price
    assign pct = saving | times: 1000 | divided_by: current_variant.compare_at_price | plus: 5 | divided_by: 10
  endif
  assign current_bags = current_variant.title | split: ' ' | first | plus: 0
  if current_bags < 1
    assign current_bags = 1
  endif
  assign per_bag = current_variant.price | times: 10 | divided_by: current_bags | plus: 5 | divided_by: 10
  assign per_bag_money = per_bag | money
  assign saving_money = saving | money
  assign days = settings.guarantee_days
-%}

<div class="container">
  <div class="product">
    {%- comment -%} ------------------------------------------------ gallery {%- endcomment -%}
    <product-gallery class="product__media{% if section.settings.enable_sticky_media %} product__media--sticky{% endif %}" tabindex="0" aria-label="{{ 'products.product.media.gallery_viewer' | t }}">
      <div class="product__stage" data-stage>
        {%- if section.settings.stage_badge != blank -%}
          <span class="badge badge--orange">{{ section.settings.stage_badge | escape }}</span>
        {%- endif -%}
        {%- for media in product.media -%}
          <div data-media-id="{{ media.id }}" class="{% if media.id == product.selected_or_first_available_variant.featured_media.id or forloop.first and product.selected_or_first_available_variant.featured_media == blank %}is-active{% endif %}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <img
                  src="{{ media | image_url: width: 1200 }}"
                  srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
                  sizes="(min-width: 990px) 55vw, 100vw"
                  alt="{{ media.alt | escape }}"
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                >
              {%- when 'video' -%}
                {{ media | video_tag: image_size: '1200x', controls: true, muted: true, playsinline: true }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- when 'model' -%}
                {{ media | model_viewer_tag }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endfor -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="product__thumbs">
          {%- for media in product.media -%}
            <button
              type="button"
              class="product__thumb"
              data-thumb="{{ media.id }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
            >
              <img src="{{ media.preview_image | image_url: width: 160 }}" alt="" width="72" height="72" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </product-gallery>

    {%- comment -%} --------------------------------------------------- info {%- endcomment -%}
    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'rating' -%}
            {%- if settings.rating_value != blank -%}
            <div class="product__rating" {{ block.shopify_attributes }}>
              {% render 'stars', rating: settings.rating_value %}
              <span>{{ settings.rating_value }}/5</span>
              <a href="#reviews">{{ block.settings.label | escape }}</a>
            </div>
            {%- endif -%}

          {%- when 'title' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
              <h1 class="product__title">{{ product.title | escape }}</h1>
            </div>

          {%- when 'benefits' -%}
            {%- assign items = block.settings.items | escape | replace: '[days]', days | newline_to_br | split: '<br />' -%}
            <ul class="check-list product__benefits" {{ block.shopify_attributes }}>
              {%- for item in items -%}
                {%- assign clean = item | strip -%}
                {%- if clean != blank -%}<li>{{ clean }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'price' -%}
            <div {{ block.shopify_attributes }}>
              <div class="product__price-row price{% if on_sale %} price--on-sale{% endif %}" id="ProductPrice-{{ section.id }}">
                <span class="price__current" data-price-current>{{ current_variant.price | money }}</span>
                <s class="price__compare" data-price-compare {% unless on_sale %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
                <span class="badge badge--sale" id="ProductSavings-{{ section.id }}" {% unless on_sale %}hidden{% endunless %}>
                  {{- 'products.product.save_amount' | t: amount: saving_money }} ({{ 'products.product.save_percent' | t: percent: pct }})
                </span>
              </div>
              <p class="product__per-bag" id="ProductPerBag-{{ section.id }}" {% if current_bags < 2 %}hidden{% endif %}>{{ 'products.product.per_bag' | t: price: per_bag_money }}</p>
              <p class="product__inventory" id="ProductInventory-{{ section.id }}" hidden></p>
            </div>

          {%- when 'bundle_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign option_key = 'option' | append: option.position -%}
                  {%- assign option_index = forloop.index0 -%}
                  <fieldset class="bundle-picker" style="border:0;margin:0;padding:0;">
                    <legend class="bundle-picker__label" style="width:100%;">
                      <span>{{ block.settings.label | default: option.name | escape }}</span>
                      {%- if block.settings.hint != blank -%}<small>{{ block.settings.hint | escape }}</small>{%- endif -%}
                    </legend>

                    {%- for value in option.values -%}
                      {%- liquid
                        assign v = product.variants | where: option_key, value | first
                        assign bags = value | split: ' ' | first | plus: 0
                        if bags < 1
                          assign bags = 1
                        endif
                        assign v_pct = 0
                        if v.compare_at_price > v.price
                          assign v_saving = v.compare_at_price | minus: v.price
                          assign v_pct = v_saving | times: 1000 | divided_by: v.compare_at_price | plus: 5 | divided_by: 10
                        endif
                        assign idx = forloop.index
                        assign sub_key = 'sub_' | append: idx
                        assign badge_key = 'badge_' | append: idx
                        assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index
                      -%}
                      <label class="bundle-option{% unless v.available %} bundle-option--soldout{% endunless %}" for="{{ input_id }}">
                        <input
                          type="radio"
                          id="{{ input_id }}"
                          name="{{ option.name | handle }}-{{ section.id }}"
                          value="{{ value | escape }}"
                          data-option-index="{{ option_index }}"
                          data-bags="{{ bags }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <span class="bundle-option__card">
                          <span class="bundle-option__radio" aria-hidden="true"></span>
                          <span class="bundle-option__body">
                            <strong>{{ value }}</strong>
                            {%- if block.settings[sub_key] != blank -%}<span>{{ block.settings[sub_key] | escape }}</span>{%- endif -%}
                          </span>
                          <span class="bundle-option__price">
                            <strong>{{ v.price | money }}</strong>
                            {%- if v_pct > 0 -%}
                              <s>{{ v.compare_at_price | money }}</s>
                              <em>{{ 'products.product.save_percent' | t: percent: v_pct }}</em>
                            {%- endif -%}
                          </span>
                          {%- if block.settings[badge_key] != blank -%}
                            <span class="badge badge--orange bundle-option__tag">{{ block.settings[badge_key] | escape }}</span>
                          {%- endif -%}
                        </span>
                      </label>
                    {%- endfor -%}
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <product-form
              class="product__form"
              data-section-id="{{ section.id }}"
              data-price-target="ProductPrice-{{ section.id }}"
              data-inventory-target="ProductInventory-{{ section.id }}"
              data-per-bag-target="ProductPerBag-{{ section.id }}"
              data-savings-target="ProductSavings-{{ section.id }}"
              {{ block.shopify_attributes }}
            >
              <script type="application/json" data-variants>
                {{ product.variants | json }}
              </script>
              <script type="application/json" data-inventory>
                {
                  {%- for v in product.variants -%}
                    {{ v.id | json }}: { "quantity": {{ v.inventory_quantity | default: 0 }}, "managed": {% if v.inventory_management == 'shopify' %}true{% else %}false{% endif %} }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                }
              </script>

              {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <input type="hidden" name="quantity" value="1">

                <button
                  type="submit"
                  name="add"
                  class="btn btn--full btn--lg btn--pulse"
                  {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
                >
                  {% render 'icon', name: 'cart' %}
                  <span data-button-text>
                    {%- if current_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>

                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}

              {%- if block.settings.note != blank -%}
                <p class="small muted text-center" style="margin-top: 10px;">{{ block.settings.note | escape | replace: '[days]', days }}</p>
              {%- endif -%}
            </product-form>

          {%- when 'trust' -%}
            <div class="product__trust" {{ block.shopify_attributes }}>
              <div>{% render 'icon', name: 'shield-check' %}{{ block.settings.item_1 | escape | replace: '[days]', settings.guarantee_days }}</div>
              <div>{% render 'icon', name: 'truck' %}{{ block.settings.item_2 | escape }}</div>
              <div>{% render 'icon', name: 'lock' %}{{ block.settings.item_3 | escape }}</div>
            </div>

          {%- when 'certs' -%}
            <ul class="product__certs pill-list" {{ block.shopify_attributes }}>
              {%- if block.settings.cert_1 != blank -%}<li class="pill">{% render 'icon', name: 'award' %}{{ block.settings.cert_1 | escape }}</li>{%- endif -%}
              {%- if block.settings.cert_2 != blank -%}<li class="pill">{% render 'icon', name: 'award' %}{{ block.settings.cert_2 | escape }}</li>{%- endif -%}
              {%- if block.settings.cert_3 != blank -%}<li class="pill">{% render 'icon', name: 'badge-check' %}{{ block.settings.cert_3 | escape }}</li>{%- endif -%}
              {%- if block.settings.cert_4 != blank -%}<li class="pill">{% render 'icon', name: 'flag' %}{{ block.settings.cert_4 | escape }}</li>{%- endif -%}
            </ul>

          {%- when 'delivery' -%}
            <p class="product__delivery" {{ block.shopify_attributes }}>{% render 'icon', name: 'package' %}<span>{{ block.settings.text | escape | replace: '[days]', days }}</span></p>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'accordion' -%}
            {%- liquid
              assign content = block.settings.content
              assign from_metafield = false
              if block.settings.metafield != blank
                assign parts = block.settings.metafield | split: '.'
                assign meta_value = product.metafields[parts[0]][parts[1]]
                if meta_value != blank
                  assign content = meta_value
                  assign from_metafield = true
                endif
              endif
            -%}
            {%- if content != blank -%}
              <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading | escape }}<span class="accordion__icon">{% render 'icon', name: 'plus' %}</span></summary>
                <div class="accordion__content rte">{% if from_metafield %}{{ content | metafield_tag }}{% else %}{{ content | replace: '[days]', days }}{% endif %}</div>
              </details>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="rte muted small" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.show_sticky_bar -%}
  <sticky-bar class="sticky-bar" data-trigger="#{{ form_id }}" data-hide=".footer" aria-hidden="true">
    <div class="container sticky-bar__inner">
      <div class="sticky-bar__thumb">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 120 }}" alt="" width="48" height="48" loading="lazy">
        {%- endif -%}
      </div>
      <div class="sticky-bar__text">
        <strong>{{ product.title | escape }}</strong>
        <span data-sticky-price>{{ current_variant.price | money }}</span>
      </div>
      <button type="submit" form="{{ form_id }}" class="btn" data-sticky-submit {% unless current_variant.available %}disabled{% endunless %}>
        <span data-button-text>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
      </button>
    </div>
  </sticky-bar>
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 400 | json }},
    "sku": {{ current_variant.sku | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
    {%- if product.featured_media -%}
      "image": {{ product.featured_media | image_url: width: 1200 | prepend: "https:" | json }},
    {%- endif -%}
    "url": {{ shop.url | append: product.url | json }},
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "sku": {{ variant.sku | json }},
          "name": {{ variant.title | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "url": {{ shop.url | append: product.url | append: '?variant=' | append: variant.id | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product page",
  "tag": "section",
  "class": "main-product-section",
  "settings": [
    { "type": "checkbox", "id": "enable_sticky_media", "label": "Sticky gallery on desktop", "default": true },
    { "type": "checkbox", "id": "show_sticky_bar", "label": "Sticky add-to-cart bar", "default": true },
    { "type": "text", "id": "stage_badge", "label": "Image badge", "default": "8-in-1 formula" }
  ],
  "blocks": [
    {
      "type": "rating",
      "name": "Star rating",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Link text", "default": "Read reviews" }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Soft chews · 120 per jar" }
      ]
    },
    {
      "type": "benefits",
      "name": "Benefit bullets",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "items", "label": "Bullets (one per line)", "default": "8 benefits in 1 chew: joints, heart, skin & coat, digestion, immunity, liver, antioxidants, energy\nDogs think it's a treat — no more hiding pills in cheese\nSoft & easy to chew, even for seniors and small breeds" }
      ]
    },
    { "type": "price", "name": "Price", "limit": 1 },
    {
      "type": "bundle_picker",
      "name": "Bundle picker",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Choose your bundle" },
        { "type": "text", "id": "hint", "label": "Hint", "default": "Bigger bundle, bigger savings" },
        { "type": "header", "content": "Per-option details (in variant order)" },
        { "type": "text", "id": "sub_1", "label": "Subtitle — option 1", "default": "Try it out" },
        { "type": "text", "id": "badge_1", "label": "Badge — option 1" },
        { "type": "text", "id": "sub_2", "label": "Subtitle — option 2", "default": "Save 10% · most popular" },
        { "type": "text", "id": "badge_2", "label": "Badge — option 2", "default": "Most popular" },
        { "type": "text", "id": "sub_3", "label": "Subtitle — option 3", "default": "Save 20% · best value" },
        { "type": "text", "id": "badge_3", "label": "Badge — option 3", "default": "Best value" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "default": true },
        { "type": "text", "id": "note", "label": "Note under button", "default": "Secure checkout · Ships in 1–2 business days" }
      ]
    },
    {
      "type": "trust",
      "name": "Trust row",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "item_1", "label": "Item 1", "default": "[days]-day money-back guarantee" },
        { "type": "text", "id": "item_2", "label": "Item 2", "default": "Fast, tracked shipping" },
        { "type": "text", "id": "item_3", "label": "Item 3", "default": "Secure checkout" }
      ]
    },
    {
      "type": "certs",
      "name": "Certification pills",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "cert_1", "label": "Pill 1", "default": "ISO 9001:2015" },
        { "type": "text", "id": "cert_2", "label": "Pill 2", "default": "HACCP" },
        { "type": "text", "id": "cert_3", "label": "Pill 3", "default": "NSF GMP" },
        { "type": "text", "id": "cert_4", "label": "Pill 4", "default": "FDA-registered facility" }
      ]
    },
    {
      "type": "delivery",
      "name": "Delivery line",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Order today — packed and shipped within 1–2 business days." }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Feeding guide" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "text", "id": "metafield", "label": "Product metafield (optional)", "info": "e.g. custom.ingredients — overrides the content above when the metafield has a value." },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ]
}
{% endschema %}
